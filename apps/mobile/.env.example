# Copy to .env.local. EXPO_PUBLIC_* values are bundled into the app, so only public keys go here.
EXPO_PUBLIC_SUPABASE_URL=https://zdnwdkykcqaarlpwqjow.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# The Next.js app that serves /api (same backend as the web app).
EXPO_PUBLIC_API_URL=https://app.shopinbos.com
# Prepaid balance (Top up / Withdraw) on the Money screen. Leave unset for Play Store builds: Google Play treats a
# stored balance as a digital wallet, which only organization developer accounts may publish.
# EXPO_PUBLIC_PREPAID_BALANCE=true
# Their own wallet account number (bank transfer top-ups) on the wallet card. Leave unset for App Store and Play
# builds: it points people to pay for Shopinbos services outside the stores (Apple 3.1.1). The top-up email has it.
# EXPO_PUBLIC_WALLET_ACCOUNT_NUMBER=true
# Korapay's public key (pk_live_… / pk_test_…, the web's NEXT_PUBLIC_KORAPAY_PUBLIC_KEY): turns on Korapay's liveness
# check (kora-identity-react-native-sdk) before a delivery partner's selfie. Unset: the selfie is face-matched only.
# EXPO_PUBLIC_KORAPAY_PUBLIC_KEY=pk_live_...
