// ─── Notification ──────────────────────────────────────────────────────────────

enum NotificationType {
  order
  payout
  peggy
  marketplace
  system
  inventory
  logistics
  products
  customers
  suppliers
  store_builder
  marketing
  rexai
  checkout
  category
  health
  activity
  dropshipping
}

enum NotificationPriority {
  critical
  warning
  info
  success
}

enum NotificationChannel {
  in_app
  email
  sms
  whatsapp
  push
  browser
}

enum DigestFrequency {
  immediate
  hourly
  daily
  weekly
  disabled
}

model Notification {
  id          String              @id @default(cuid())
  userId      String
  type        NotificationType
  priority    NotificationPriority @default(info)
  title       String
  description String
  link        String?
  actionLabel String?
  actionUrl   String?
  imageUrl    String?
  metadata    Json                @default("{}")
  read        Boolean             @default(false)
  readAt      DateTime?
  scheduledFor DateTime?
  channel     NotificationChannel @default(in_app)
  /// notify(): the event (e.g. "order.new"), its settings category (shared/notifications.ts) and a key that stops
  /// the same thing being sent twice (unique per person).
  event       String?
  category    String?
  dedupeKey   String?
  createdAt   DateTime            @default(now())

  user       User                   @relation(fields: [userId], references: [id])
  deliveries NotificationDelivery[]

  @@unique([userId, dedupeKey])
  @@index([userId])
  @@index([userId, type])
  @@index([userId, priority])
  @@index([userId, read])
  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, category, createdAt(sort: Desc)])
}

/// A phone (Expo push token) or browser (Web Push subscription) that gets push notifications. Belongs to an
/// account (userId) or to a rider (riderId: riders have no account, they use their private link).
model PushDevice {
  id           String    @id @default(cuid())
  userId       String?
  riderId      String?
  /// ios | android | web
  platform     String
  /// expo | webpush
  provider     String
  /// The Expo push token, or the Web Push endpoint URL.
  token        String    @unique
  /// Web Push subscription keys.
  p256dh       String?
  auth         String?
  appVersion   String?
  deviceName   String?
  lastSeenAt   DateTime  @default(now())
  /// Set when the person turns push off here, or the token stops working (uninstalled, expired).
  disabledAt   DateTime?
  failureCount Int       @default(0)
  lastError    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user       User?                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  rider      LogisticsTeamMember?   @relation(fields: [riderId], references: [id], onDelete: Cascade)
  deliveries NotificationDelivery[]

  @@index([userId, disabledAt])
  @@index([riderId, disabledAt])
}

/// Each message sent (or held back) for a notification on push, email, SMS or WhatsApp. Expo push tickets are
/// checked later by /api/cron/push-receipts; "held" rows (quiet hours, a burst) are sent there as one summary.
model NotificationDelivery {
  id             String    @id @default(cuid())
  notificationId String?
  userId         String?
  riderId        String?
  deviceId       String?
  /// push | email | sms | whatsapp
  channel        String
  /// expo | webpush | resend | sms | whatsapp
  provider       String?
  /// sent | ok | error | expired (no receipt) | held_quiet | held_burst | flushed | skipped
  status         String
  ticketId       String?
  collapseKey    String?
  category       String?
  title          String?
  body           String?
  error          String?
  createdAt      DateTime  @default(now())
  checkedAt      DateTime?

  notification Notification? @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  device       PushDevice?   @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([ticketId])
  @@index([userId, collapseKey, createdAt])
  @@index([notificationId])
}

/// Per-person notification settings that aren't a category × channel switch (those are NotificationPreference
/// rows with eventKey "notify.<category>"): quiet hours.
model NotificationSetting {
  userId            String   @id
  quietHoursEnabled Boolean  @default(true)
  /// "HH:MM" in timezone. Default 22:00 to 07:00 Lagos time.
  quietStart        String   @default("22:00")
  quietEnd          String   @default("07:00")
  timezone          String   @default("Africa/Lagos")
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model NotificationPreference {
  id              String          @id @default(cuid())
  userId          String
  role            Role
  eventKey        String
  category        NotificationType
  inApp           Boolean         @default(true)
  email           Boolean         @default(false)
  sms             Boolean         @default(false)
  whatsapp        Boolean         @default(false)
  push            Boolean         @default(false)
  browser         Boolean         @default(false)
  digestFrequency DigestFrequency @default(immediate)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, eventKey, category])
  @@index([userId])
  @@index([role])
  @@index([category])
}

// ─── Activity Event ───────────────────────────────────────────────────────────

model ActivityEvent {
  id          String   @id @default(cuid())
  storeId     String
  userId      String
  type        String   // order_created | product_published | inventory_updated | etc
  title       String
  description String?
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id])

  @@index([storeId])
  @@index([storeId, createdAt(sort: Desc)])
  @@index([userId])
  @@index([type])
}

// ─── Smart Alert Rule ─────────────────────────────────────────────────────────

model SmartAlertRule {
  id             String    @id @default(cuid())
  storeId        String
  name           String
  description    String?
  trigger        String    // low_stock | order_stuck | category_empty | conversion_drop | no_orders
  condition      Json      @default("{}") // threshold values, time windows
  actionType     String    @default("notification") // notification | email | both
  actionConfig   Json      @default("{}") // template, channels
  active         Boolean   @default(true)
  lastTriggeredAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  store Store @relation(fields: [storeId], references: [id])

  @@index([storeId])
  @@index([storeId, active])
  @@index([trigger])
