generator client {
  provider = "prisma-client-js"
}

// Run: npx tsx prisma/seed.ts

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  seller
  supplier
  logistics_partner
  admin
}

enum VerificationStatus {
  unverified
  pending
  verified
  rejected
  suspended
}

enum BusinessType {
  manufacturer
  wholesaler
  importer
  dropshipper
}

enum ProductStatus {
  draft
  pending_review
  published
  unpublished
  rejected
}

enum ProductVisibility {
  hidden
  storefront
  featured
  collection_only
}

enum SalesChannel {
  website
  instagram
  whatsapp
  marketplace
  all
}

enum InventoryType {
  seller
  dropshipping
  source_on_demand
  print_on_demand
  digital
}

enum ProductSourceType {
  imported
  local
  supplier
  dropship
  seller
  manufactured
  digital
}

enum FulfillmentType {
  merchant_fulfilled
  dropship
  wholesale_stocked
}

enum OrderStatus {
  pending
  confirmed
  processing
  shipped
  delivered
  cancelled
  refunded
}

enum RetailOrderStatus {
  pending
  awaiting_payment
  paid
  processing
  packed
  shipped
  delivered
  returned
  cancelled
  refunded
  partially_refunded
}

enum QuoteStatus {
  pending
  responded
  accepted
  rejected
  expired
}

enum BookingStatus {
  pending
  confirmed
  picked_up
  in_transit
  delivered
  failed
  cancelled
}

enum ShippingType {
  flat_rate
  weight_based
  zone_based
  free_shipping
  conditional
  distance_based
  hybrid
}

enum CheckoutLayout {
  single_page
  multi_step
  accordion
  minimal
  express
  mobile
}

enum ProductPageVariant {
  shopify
  amazon
  luxury
  minimal
  marketplace
  fashion
  mobile_first
}

// ─── Core User ────────────────────────────────────────────────────────────────

model User {
  id                 String             @id @default(cuid())
  supabaseId         String             @unique
  name               String
  email              String?            @unique
  phone              String?
  role               Role
  country            String?
  city               String?
  avatarUrl          String?
  aiCredits          Int                @default(5)
  verificationStatus VerificationStatus @default(unverified)
  preferences        Json               @default("{}") // menu items switched off, walkthrough progress (shared/preferences.ts)
  // The paid plan as Paystack's subscription webhooks report it (src/lib/seller-plan.ts). An active annual seller
  // plan paid up past now makes a domain free (src/lib/domains/billing.server.ts).
  planCode           String?
  planInterval       String? // monthly | annual
  planStatus         String? // active | non_renewing | cancelled
  planPaidUntil      DateTime?
  subscriptionCode   String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  store           Store?
  supplier        Supplier?
  logisticsPartner LogisticsPartner?

  // Seller actions
  storeProducts     StoreProduct[]
  paymentReceipts   PaymentReceipt[]
  dropshipAsseller   DropshipRelationship[] @relation("SellerDropship")
  quoteRequestsSent  SupplierQuoteRequest[] @relation("SellerQuotes")
  wholesaleOrders    WholesaleOrder[]       @relation("SellerWholesale")
  deliveryQuotes     DeliveryQuoteRequest[]
  deliveryBookings   DeliveryBooking[]
  logisticsReviews   LogisticsReview[]
  notifications      Notification[]
  notificationPreferences NotificationPreference[]
  pushDevices        PushDevice[]
  notificationSetting NotificationSetting?
  onboardingResponses OnboardingResponse[]
  storeLaunchPayments StoreLaunchPayment[]

  // Conversations
  conversationsAs1 Conversation[] @relation("ConversationParticipant1")
  conversationsAs2 Conversation[] @relation("ConversationParticipant2")
  messagesSent     Message[]

  @@index([email])
  @@index([supabaseId])
  @@index([role])
}

// ─── Store ────────────────────────────────────────────────────────────────────

model Store {
  id                         String   @id @default(cuid())
  userId                     String   @unique
  name                       String
  slug                       String   @unique
  // Addresses the store had before (newest first). They keep redirecting here and no other store can take them.
  previousSlugs              String[] @default([])
  // When the address last changed; changes are limited to one every 30 days (src/lib/store-address.server.ts).
  slugChangedAt              DateTime?
  description                String?
  logoUrl                    String?
  country                    String
  city                       String?
  currency                   String   @default("NGN")
  brandSettings              Json     @default("{}")
  // The address buyers see on the seller's own domain. Only set once ownership is verified (TXT record, or
  // bought through the app); customDomainKey is its www-less lowercase form, unique across stores.
  customDomain               String?
  customDomainKey            String?   @unique
  customDomainVerifiedAt     DateTime?
  // A domain the seller is proving they own, and the token they publish at _shopinbos-verify.<domain>.
  pendingDomain              String?
  domainVerifyToken          String?
  status                     String   @default("active")
  onboardingState            String?
  firstDashboardVisitComplete Boolean  @default(false)
  /// When a supplier doesn't accept in time, send the order to another supplier with the same product (on by
  /// default), as long as the cost stays within the limit: "cost" = at most switchMaxIncreasePct above the
  /// original cost; "margin" = the seller keeps at least switchMinMarginPct of their price.
  autoSwitchSupplier         Boolean  @default(true)
  switchCostRule             String   @default("cost")
  switchMaxIncreasePct       Int      @default(10)
  switchMinMarginPct         Int      @default(20)
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  user          User           @relation(fields: [userId], references: [id])
  storeProducts StoreProduct[]
  pages         StorePage[]
  retailOrders  RetailOrder[]
  productReviews ProductReview[]
  visitors       StoreVisitor[]
  wishlistItems  StoreWishlistItem[]
  formSubmissions StoreFormSubmission[]
  abandonedCartEvents AbandonedCartEvent[]
  collections    Collection[]
  shippingZones  ShippingZone[]
  checkoutConfig CheckoutConfig?
  productPageTemplates ProductPageTemplate[]
  activityEvents ActivityEvent[]
  smartAlertRules SmartAlertRule[]
  healthSnapshots StoreHealthSnapshot[]
  subscribers    Subscriber[]
  customerSegments CustomerSegment[]
  storeForms     StoreForm[]
  liveChatConfig LiveChatConfig?
  abandonedCartConfig AbandonedCartConfig?
  emailTemplates EmailTemplate[]
  broadcastCampaigns BroadcastCampaign[]
  automations    AutomationRule[]
  launchPayments StoreLaunchPayment[]
  affiliates     Affiliate[]
  adCampaigns    AdCampaign[]
  storeCampaigns StoreCampaign[]
  paymentLinks   PaymentLink[]
  bioPage        BioPage?

  @@index([slug])
  @@index([previousSlugs], type: Gin)
  @@index([userId])
}

// ─── Store Page ───────────────────────────────────────────────────────────────

model StorePage {
  id               String    @id @default(cuid())
  storeId          String
  type             String    // home | products | about | contact | faq | blog | custom
  title            String
  slug             String
  content          Json      @default("{}")       // published content snapshot
  draftContent     Json?                          // in-progress edits (seo, nav, etc.)
  publishedContent Json?                          // last published snapshot before live
  isPublished      Boolean   @default(false)      // shortcut for status === "published"
  status           String    @default("draft")    // "draft" | "published" | "hidden" | "scheduled" | "archived"
  publishAt        DateTime?
  archivedAt       DateTime?
  order            Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  store Store @relation(fields: [storeId], references: [id])

  @@index([storeId])
  @@unique([storeId, slug])
}

model StoreLaunchPayment {
  id               String   @id
  userId           String   @map("user_id")
  storeId          String   @map("store_id")
  reference        String   @unique
  paymentOption    String   @map("payment_option")
  totalAmount      Int      @map("total_amount")
  amountDue        Int      @map("amount_due")
  amountPaid       Int      @default(0) @map("amount_paid")
  balanceDue       Int      @map("balance_due")
  currency         String   @default("NGN")
  status           String   @default("initialized")
  dueAt            DateTime? @map("due_at")
  paidAt           DateTime? @map("paid_at")
  providerResponse Json?    @map("provider_response")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  user  User  @relation(fields: [userId], references: [id])
  store Store @relation(fields: [storeId], references: [id])

  @@index([storeId])
  @@index([userId])
  @@map("store_launch_payments")
}

model OnboardingResponse {
  id             String   @id
  userId         String   @map("user_id")
  organizationId String?  @map("organization_id")
  accountType    String?  @map("account_type")
  questionKey    String   @map("question_key")
  answer         Json
  source         String   @default("rex")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, questionKey])
  @@index([userId])
  @@map("onboarding_responses")
}

model StoreVisitor {
  id          String   @id @default(cuid())
  storeId     String
  visitorKey  String
  email       String?
  name        String?
  phone       String?
  lastSeenAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id])
  wishlistItems StoreWishlistItem[]
  formSubmissions StoreFormSubmission[]
  abandonedCartEvents AbandonedCartEvent[]

  @@unique([storeId, visitorKey])
  @@index([storeId, email])
}

model StoreWishlistItem {
  id        String   @id @default(cuid())
  storeId   String
  visitorId String
  productId String
  createdAt DateTime @default(now())

  store   Store @relation(fields: [storeId], references: [id])
  visitor StoreVisitor @relation(fields: [visitorId], references: [id])
  product StoreProduct @relation(fields: [productId], references: [id])

  @@unique([visitorId, productId])
  @@index([storeId])
  @@index([productId])
}

model StoreFormSubmission {
  id        String   @id @default(cuid())
  storeId   String
  visitorId String?
  type      String   @default("contact")
  name      String?
  email     String?
  phone     String?
  message   String?
  payload   Json     @default("{}")
  status    String   @default("new")
  createdAt DateTime @default(now())

  store   Store @relation(fields: [storeId], references: [id])
  visitor StoreVisitor? @relation(fields: [visitorId], references: [id])

  @@index([storeId, createdAt])
  @@index([email])
}

// ─── Supplier ─────────────────────────────────────────────────────────────────

model Supplier {
  id                 String             @id @default(cuid())
  userId             String             @unique
  businessName       String
  slug               String             @unique
  displayName        String
  businessType       BusinessType
  country            String
  city               String
  address            String?
  description        String?
  logoUrl            String?
  bannerUrl          String?
  categories         String[]
  verificationDocuments Json               @default("[]")
  onboardingState    Json               @default("{}")
  blogPosts          Json               @default("[]")
  verificationStatus VerificationStatus @default(pending)
  trustScore         Int                @default(0)
  rating             Float              @default(0)
  ratingCount        Int                @default(0)
  responseTime       String?
  responseTimeLabel  String?
  whatsappNumber     String?
  website            String?
  status             String             @default("active")
  /// Hours this supplier has to accept a new order (admin override; null = SUPPLIER_ACCEPT_HOURS_* or 4 h / 24 h).
  acceptHoursDropship  Int?
  acceptHoursWholesale Int?
  /// New orders that ran out of time without an answer (src/lib/supplier-orders/acceptance.server.ts).
  missedOrders       Int                @default(0)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  user             User                   @relation(fields: [userId], references: [id])
  products         SupplierProduct[]
  dropships        DropshipRelationship[] @relation("SupplierDropship")
  quoteRequests    SupplierQuoteRequest[] @relation("SupplierQuotes")
  wholesaleOrders  WholesaleOrder[]       @relation("SupplierWholesale")
  supplierOrders   SupplierOrder[]
  payoutAccount    SupplierPayoutAccount?
  teamMembers      SupplierTeamMember[]
  reviews          SupplierReview[]

  @@index([slug])
  @@index([country, city])
  @@index([verificationStatus])
}

model SupplierPayoutAccount {
  id                        String   @id @default(cuid())
  supplierId                String   @unique
  bankName                  String
  bankCode                  String?
  accountNumberMask         String
  accountName               String
  paystackRecipientCode     String?
  paystackRecipientId       String?
  verificationStatus        String   @default("pending")
  providerResponse          Json     @default("{}")
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  supplier Supplier @relation(fields: [supplierId], references: [id])

  @@index([supplierId])
  @@index([verificationStatus])
}

model SupplierReview {
  id              String   @id @default(cuid())
  supplierId      String
  reviewerId      String
  targetId        String
  targetRole      String   // "seller" | "logistics_partner" | "supplier"
  interactionType String   // "wholesale_order" | "delivery_booking"
  interactionId   String
  rating          Int      // 1-5
  title           String   @default("")
  comment         String?
  reply           String?  // response from the reviewed party
  repliedAt       DateTime?
  status          String   @default("active")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  supplier Supplier @relation(fields: [supplierId], references: [id])

  @@unique([supplierId, interactionId, reviewerId])
  @@index([supplierId])
  @@index([reviewerId])
  @@index([targetId])
}

model SupplierTeamMember {
  id                 String   @id @default(cuid())
  supplierId         String
  name               String
  email              String
  phone              String?
  role               String   @default("manager")
  status             String   @default("active")
  invitedAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  supplier Supplier @relation(fields: [supplierId], references: [id])

  @@unique([supplierId, email])
  @@index([supplierId])
  @@index([status])
}

// ─── Category ─────────────────────────────────────────────────────────────────

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  imageUrl    String?
  parentId    String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")

  supplierProducts SupplierProduct[]
  storeProducts    StoreProduct[]

  @@index([slug])
}

// ─── Supplier Product ─────────────────────────────────────────────────────────

model SupplierProduct {
  id                    String        @id @default(cuid())
  supplierId            String
  name                  String
  slug                  String        @unique
  description           String
  categoryId            String
  images                String[]
  wholesalePrice        Float
  wholesalePriceTo      Float?
  suggestedRetailPrice  Float
  currency              String        @default("NGN")
  moq                   Int           @default(1)
  stockQuantity         Int           @default(0)
  pricingTiers          Json          @default("[]")
  dropshipAvailable     Boolean       @default(false)
  bulkOrderAvailable    Boolean       @default(true)
  sampleAvailable       Boolean       @default(false)
  deliveryRegions       String[]
  processingTime        String?
  trendScore            Float         @default(0)
  /// The same product from several suppliers shares a family key (or names another listing's id). Used to send an
  /// order to another supplier when one doesn't answer (src/lib/supplier-orders/switch.server.ts).
  familyKey             String?
  /// Sizes and colours the supplier has: [{ size?, color? }]. Empty = one kind only.
  variants              Json          @default("[]")
  status                ProductStatus @default(draft)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  supplier      Supplier       @relation(fields: [supplierId], references: [id])
  category      Category       @relation(fields: [categoryId], references: [id])
  storeProducts StoreProduct[]
  dropships     DropshipRelationship[]
  quoteRequests SupplierQuoteRequest[]
  wholesales    WholesaleOrder[]

  @@index([supplierId])
  @@index([categoryId])
  @@index([slug])
  @@index([status])
  @@index([trendScore(sort: Desc)])
  @@index([familyKey])
}

// ─── Store Product ────────────────────────────────────────────────────────────

model StoreProduct {
  id                String          @id @default(cuid())
  storeId           String
  userId            String
  supplierProductId String?
  name              String
  description       String?
  longDescription   String?
  specifications    Json            @default("[]")
  faqs              Json            @default("[]")
  careInstructions  String?
  shippingInfo      String?
  returnPolicy      String?
  warranty          String?
  supportInfo       String?
  sku               String?
  barcode           String?
  images            String[]
  videoUrl          String?
  has360View        Boolean         @default(false)
  retailPrice       Float
  costPrice         Float?
  compareAtPrice    Float?
  currency          String          @default("NGN")
  margin            Float?
  weight            Float?
  weightUnit        String          @default("kg")
  dimensions        Json?           // { length, width, height, unit }
  fulfillmentType   FulfillmentType @default(merchant_fulfilled)
  status            String          @default("draft")
  visibility        ProductVisibility @default(hidden)
  salesChannel      SalesChannel    @default(website)
  inventoryType     InventoryType   @default(seller)
  sourceType        ProductSourceType? // tracks original source
  categoryId        String?
  variants          Json?
  // Preset category (shared/product-types.ts); null = "other". Details are { fieldKey: value }.
  productType       String?
  productDetails    Json            @default("{}")
  // Options for the versions in order: [{ name, values }] (shared/product-variants.ts).
  variantOptions    Json            @default("[]")
  // "Customers also like": up to 8 of the store's own products.
  relatedProductIds String[]        @default([])
  tags              String[]
  featured          Boolean         @default(false)
  sortOrder         Int             @default(0)

  // Inventory tracking
  currentStock      Int             @default(0)
  reservedStock     Int             @default(0)
  soldStock         Int             @default(0)
  incomingStock     Int             @default(0)
  damagedStock      Int             @default(0)
  lowStockThreshold Int             @default(10)
  // Explicit stock tracking (shared/product-stock.ts). Off: the product is never sold out and checkout takes no
  // stock (the count, if any, is ignored). On: shoppers can buy up to currentStock - reservedStock (and each
  // version's own count). Dropship products always use the supplier's stock instead.
  trackStock             Boolean    @default(false)
  // Tracked products only: keep selling at 0 (backorder); the count may then go below zero.
  continueSellingWhenOut Boolean    @default(false)

  // Product page builder
  // Per-product page settings: { override: true, layout?, buyBox?, sections? } overrides the store's product page
  // settings (src/components/storefront/boutique/pdp/product-override.ts). Without the marker: store default.
  pageLayout        Json            @default("{}")
  pageVariant       ProductPageVariant @default(shopify)
  descriptionBuilder Json           @default("{}")
  enabledModules    String[]        @default([]) // which page modules are on

  // SEO & marketing
  seoTitle          String?
  seoDescription    String?
  marketingCopy     String?
  socialMediaCopy   String?

  // Supplier sync info
  supplierStock     Int?            @default(0)
  supplierLastSync  DateTime?

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  store           Store            @relation(fields: [storeId], references: [id])
  user            User             @relation(fields: [userId], references: [id])
  category        Category?        @relation(fields: [categoryId], references: [id])
  supplierProduct SupplierProduct? @relation(fields: [supplierProductId], references: [id])
  dropship        DropshipRelationship?
  reviews         ProductReview[]
  wishlistItems   StoreWishlistItem[]
  collections     CollectionProduct[]
  stockMovements  StockMovement[]
  productSources  ProductSource[]

  @@index([storeId])
  @@index([storeId, productType])
  @@index([supplierProductId])
  @@index([categoryId])
  @@index([sku])
  @@index([status])
  @@index([visibility])
  @@index([featured])
}

// ─── Collection ───────────────────────────────────────────────────────────────

model Collection {
  id          String   @id @default(cuid())
  storeId     String
  name        String
  slug        String
  description String?
  imageUrl    String?
  type        String   @default("manual") // manual | auto
  rules       Json     @default("{}")     // auto-collection rules
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  store    Store              @relation(fields: [storeId], references: [id])
  products CollectionProduct[]

  @@unique([storeId, slug])
  @@index([storeId])
}

model CollectionProduct {
  id           String   @id @default(cuid())
  collectionId String
  productId    String
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())

  collection Collection  @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product    StoreProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([collectionId, productId])
  @@index([collectionId])
  @@index([productId])
}

// ─── Dropship Relationship ────────────────────────────────────────────────────

model DropshipRelationship {
  id                String   @id @default(cuid())
  sellerId          String
  storeId           String
  supplierId        String
  supplierProductId String
  storeProductId    String   @unique
  status            String   @default("active")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  seller          User            @relation("SellerDropship", fields: [sellerId], references: [id])
  supplier        Supplier        @relation("SupplierDropship", fields: [supplierId], references: [id])
  supplierProduct SupplierProduct @relation(fields: [supplierProductId], references: [id])
  storeProduct    StoreProduct    @relation(fields: [storeProductId], references: [id])

  @@index([sellerId])
  @@index([supplierId])
}

// ─── Supplier Quote Request ───────────────────────────────────────────────────

model SupplierQuoteRequest {
  id                String      @id @default(cuid())
  sellerId          String
  supplierId        String
  supplierProductId String
  quantity          Int
  destination       String
  notes             String?
  status            QuoteStatus @default(pending)
  quotedPrice       Float?
  supplierResponse  String?
  expiresAt         DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  seller          User            @relation("SellerQuotes", fields: [sellerId], references: [id])
  supplier        Supplier        @relation("SupplierQuotes", fields: [supplierId], references: [id])
  supplierProduct SupplierProduct @relation(fields: [supplierProductId], references: [id])

  @@index([sellerId])
  @@index([supplierId])
  @@index([status])
}

// ─── Wholesale Order ──────────────────────────────────────────────────────────

model WholesaleOrder {
  id                String      @id @default(cuid())
  sellerId          String
  supplierId        String
  supplierProductId String
  quantity          Int
  unitPrice         Float
  totalPrice        Float
  currency          String      @default("NGN")
  deliveryAddress   String
  notes             String?
  status            OrderStatus @default(pending)
  trackingCode      String?
  rejectReason      String?   // why the supplier declined (status cancelled)
  shippedAt         DateTime?
  deliveredAt       DateTime?
  stockReserved     Int         @default(0) // supplier stock taken when placed (0: none tracked, e.g. older orders)
  stockReleasedAt   DateTime?   // given back once (declined or cancelled)
  paidOutAt         DateTime?   // the supplier confirmed they were paid
  acceptBy          DateTime?   // the supplier must accept by then, or it is cancelled (expiredAt set)
  acceptReminderAt  DateTime?   // "1 hour left" reminder sent
  expiredAt         DateTime?   // ran out of time without an answer (status cancelled)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  seller          User            @relation("SellerWholesale", fields: [sellerId], references: [id])
  supplier        Supplier        @relation("SupplierWholesale", fields: [supplierId], references: [id])
  supplierProduct SupplierProduct @relation(fields: [supplierProductId], references: [id])

  @@index([sellerId])
  @@index([supplierId])
  @@index([status])
  @@index([status, acceptBy])
}

// ─── Supplier Order (dropship) ────────────────────────────────────────────────
// What a supplier ships for a seller's store order: one per (store order, supplier), created when the order is
// paid (or placed, for pay on delivery). Lines, cost and address are a snapshot taken then.

model SupplierOrder {
  id              String    @id @default(cuid())
  idempotencyKey  String    @unique // "dropship:<retailOrderId>:<supplierId>" (src/lib/supplier-orders/pure.ts)
  supplierId      String
  retailOrderId   String
  storeId         String
  sellerId        String
  status          String    @default("pending") // pending | accepted | shipped | delivered | rejected | cancelled
  items           Json      @default("[]") // [{ storeProductId, supplierProductId, name, variant, quantity, unitCost, image }]
  costTotal       Float     @default(0) // wholesale cost the supplier is owed
  currency        String    @default("NGN")
  shippingAddress Json      @default("{}")
  recipientName   String
  recipientPhone  String?
  trackingCode    String?
  carrier         String?
  rejectReason    String?
  acceptedAt      DateTime?
  shippedAt       DateTime?
  deliveredAt     DateTime?
  rejectedAt      DateTime?
  paidOutAt       DateTime? // the supplier confirmed they were paid what they're owed (costTotal)
  acceptBy        DateTime? // the supplier must accept by then, or it expires (status expired)
  acceptReminderAt DateTime? // "1 hour left" reminder sent
  expiredAt       DateTime?
  packedAt        DateTime? // the supplier said "I've packed it"
  stockReleasedAt DateTime? // the supplier stock this order's lines held went back (expired), once
  /// Automatic switch: the expired order this one took over (idempotencyKey "switch:<that id>").
  replacesId      String?
  /// The seller pressed Undo before this supplier accepted (status cancelled).
  undoneAt        DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  supplier    Supplier    @relation(fields: [supplierId], references: [id])
  retailOrder RetailOrder @relation(fields: [retailOrderId], references: [id], onDelete: Cascade)

  @@index([supplierId, status])
  @@index([retailOrderId])
  @@index([storeId])
  @@index([status, acceptBy])
  @@index([replacesId])
}

/// What happened when a supplier didn't accept a shop's order in time: switched to another supplier, nobody
/// qualified, the shop turned switching off, or the limit was reached; later "undone" when the seller pressed
/// Undo. One row per expired supplier order (unique), so a cron re-run never switches twice.
model SupplierSwitch {
  id                  String    @id @default(cuid())
  retailOrderId       String
  storeId             String
  fromSupplierOrderId String    @unique
  fromSupplierId      String
  /// switched | undone | none | off | limit
  outcome             String
  toSupplierOrderId   String?   @unique
  toSupplierId        String?
  costBefore          Float     @default(0)
  costAfter           Float?
  note                String?
  undoneAt            DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([retailOrderId])
  @@index([storeId, createdAt])
}

/// A rider booked to collect a supplier's packed order at a set time (dropship SupplierOrder or WholesaleOrder,
/// one per order). Links the delivery job once a partner is found; "finding_rider" waits for the admin team.
model SupplierPickup {
  id                 String    @id @default(cuid())
  orderKind          String    // dropship | wholesale
  orderId            String
  supplierId         String
  sellerId           String
  /// booked | finding_rider | cancelled | picked_up | delivered
  status             String    @default("booked")
  pickupAddress      String
  slotKey            String
  windowStart        DateTime
  windowEnd          DateTime
  deliveryBookingId  String?   @unique
  logisticsPartnerId String?
  needsAdmin         Boolean   @default(false)
  adminNote          String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([orderKind, orderId])
  @@index([supplierId])
  @@index([needsAdmin, status])
}

// ─── Logistics Partner ────────────────────────────────────────────────────────

model LogisticsPartner {
  id                 String             @id @default(cuid())
  userId             String             @unique
  companyName        String
  slug               String             @unique
  displayName        String
  country            String
  city               String
  address            String?
  description        String?
  logoUrl            String?
  bannerUrl          String?
  coverageZones      String[]
  coverageMap        Json               @default("{}")
  vehicleTypes       String[]
  deliveryTypes      String[]
  onboardingState    Json               @default("{}")
  blogPosts          Json               @default("[]")
  pricingModel       String             @default("fixed")
  basePrice          Float              @default(0)
  estimatedSpeed     String?
  reliabilityScore   Int                @default(0)
  rating             Float              @default(0)
  ratingCount        Int                @default(0)
  verificationStatus VerificationStatus @default(pending)
  verificationDocuments Json            @default("[]")
  whatsappNumber     String?
  status             String             @default("active")
  /// Cash pay-ins: money paid in beyond the cash jobs it could settle, used first by the next pay-in.
  payInCredit        Float              @default(0)
  /// Late pay-ins (lib/logistics/payin-deadline.ts): paused from new pay-when-it-arrives (COD) jobs only. Set and
  /// cleared by the system (cron + pay-in matching) or the team, never by the partner's "Taking new jobs" switch.
  codPaused          Boolean            @default(false)
  /// The missed pay-in deadline (6pm Lagos) of the oldest cash still owed, while the partner is late.
  payInOverdueSince  DateTime?
  /// Cash past its deadline and grace, still owed after credit.
  payInOverdueAmount Float              @default(0)
  /// 24 hours late: told again, high priority for the team.
  payInEscalatedAt   DateTime?
  /// 72 hours late: flagged for the team to review (never suspended automatically).
  payInReviewAt      DateTime?
  /// The team unpaused the partner for this late period; the cron won't pause them again until it clears.
  payInPauseWaived   Boolean            @default(false)
  /// Late days counted against the partner (each also lowers reliabilityScore).
  payInStrikes       Int                @default(0)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  user           User                   @relation(fields: [userId], references: [id])
  quoteRequests  DeliveryQuoteRequest[]
  bookings       DeliveryBooking[]
  teamMembers    LogisticsTeamMember[]
  remittances    CodRemittance[]
  apiKeys        PartnerApiKey[]
  webhooks       PartnerWebhook[]
  payoutAccount  LogisticsPayoutAccount?
  reviews        LogisticsReview[]
  payInAccount   PartnerPayInAccount?
  payIns         PartnerPayIn[]
  payInEvents    PartnerPayInEvent[]

  @@index([slug])
  @@index([country, city])
}

model LogisticsReview {
  id                 String   @id @default(cuid())
  logisticsPartnerId String
  reviewerId         String
  bookingId          String?   @unique
  rating             Int       @default(5) // 1-5
  comment            String?
  response           String?   // partner reply
  respondedAt        DateTime?
  createdAt          DateTime  @default(now())

  logisticsPartner LogisticsPartner @relation(fields: [logisticsPartnerId], references: [id])
  reviewer         User             @relation(fields: [reviewerId], references: [id])
  booking          DeliveryBooking? @relation(fields: [bookingId], references: [id])

  @@index([logisticsPartnerId])
  @@index([reviewerId])
}

model LogisticsTeamMember {
  id                 String           @id @default(cuid())
  logisticsPartnerId String
  name               String
  email              String
  phone              String?
  role               String           @default("dispatcher")
  status             String           @default("active")
  /// Riders app: SHA-256 of the private link token the partner shares with the rider (never stored raw).
  riderTokenHash     String?          @unique
  online             Boolean          @default(false)
  lastSeenAt         DateTime?
  /// Riders app: the rider's latest location only (reported while online or on a job). Never shown to shops or customers.
  lastLat            Float?
  lastLng            Float?
  lastAccuracy       Float?
  lastLocationAt     DateTime?
  invitedAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  logisticsPartner LogisticsPartner @relation(fields: [logisticsPartnerId], references: [id])
  jobs             DeliveryBooking[]
  trail            RiderLocationPoint[]
  pushDevices      PushDevice[]

  @@unique([logisticsPartnerId, email])
  @@index([logisticsPartnerId])
  @@index([status])
}

// ─── Logistics Payout Account ─────────────────────────────────────────────────

model LogisticsPayoutAccount {
  id                        String   @id @default(cuid())
  logisticsPartnerId        String   @unique
  provider                  String   @default("flutterwave") // flutterwave | paystack
  bankName                  String
  bankCode                  String?
  accountNumberMask         String
  accountName               String
  recipientCode             String?  // Flutterwave transfer recipient code
  recipientId               String?  // Flutterwave or Paystack recipient ID
  verificationStatus        String   @default("pending")
  providerResponse          Json     @default("{}")
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  logisticsPartner LogisticsPartner @relation(fields: [logisticsPartnerId], references: [id])

  @@index([logisticsPartnerId])
  @@index([verificationStatus])
}

// ─── Platform Fee Config ─────────────────────────────────────────────────────

model PlatformFeeConfig {
  id        String @id @default(cuid())
  active    Boolean @default(true)
  rate      Float   @default(1.5) // percentage
  bearer    String  @default("seller") // seller | supplier | logistics_partner
  minFee    Float   @default(0)
  maxFee    Float   @default(0) // 0 = no max
  updatedAt DateTime @updatedAt
}

// ─── Delivery Quote Request ───────────────────────────────────────────────────

model DeliveryQuoteRequest {
  id                 String      @id @default(cuid())
  sellerId           String
  logisticsPartnerId String
  pickupLocation     String
  destination        String
  packageDetails     Json
  preferredDate      DateTime?
  status             QuoteStatus @default(pending)
  quotedPrice        Float?
  partnerResponse    String?
  expiresAt          DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  seller           User             @relation(fields: [sellerId], references: [id])
  logisticsPartner LogisticsPartner @relation(fields: [logisticsPartnerId], references: [id])

  @@index([sellerId])
  @@index([logisticsPartnerId])
}

// ─── Delivery Booking ─────────────────────────────────────────────────────────

model DeliveryBooking {
  id                 String        @id @default(cuid())
  sellerId           String
  logisticsPartnerId String
  orderId            String?
  pickupLocation     String
  destination        String
  packageDetails     Json
  deliveryFee        Float
  currency           String        @default("NGN")
  status             BookingStatus @default(pending)
  platformFee        Float         @default(0)
  feeBearer          String        @default("seller") // seller | supplier | logistics_partner
  netAmount          Float         @default(0)
  trackingCode       String?       @unique
  estimatedDelivery  DateTime?
  deliveredAt        DateTime?
  notes              String?
  /// Rider (a LogisticsTeamMember) the partner assigned the job to.
  riderId            String?
  pickedUpAt         DateTime?
  failedReason       String?
  /// 4-digit code the buyer gives the rider as proof of delivery.
  deliveryCode       String?
  proofUrl           String?
  /// Pay on delivery: amount to collect, what was collected and how, and the remittance that settled it.
  codAmount          Float?
  codCollected       Float?
  codMethod          String? // cash | transfer
  codCollectedAt     DateTime?
  remittanceId       String?
  /// When the rider should collect it (supplier pickups): "Pick up 12–4pm today".
  pickupWindowStart  DateTime?
  pickupWindowEnd    DateTime?
  /// Pickup coordinates for "closest rider" (lib/logistics/geocode.ts): google | nominatim | area.
  pickupLat          Float?
  pickupLng          Float?
  pickupGeoSource    String?
  pickupGeocodedAt   DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  seller           User                 @relation(fields: [sellerId], references: [id])
  logisticsPartner LogisticsPartner     @relation(fields: [logisticsPartnerId], references: [id])
  rider            LogisticsTeamMember? @relation(fields: [riderId], references: [id], onDelete: SetNull)
  remittance       CodRemittance?       @relation(fields: [remittanceId], references: [id], onDelete: SetNull)
  review           LogisticsReview?
  trail            RiderLocationPoint[]

  @@index([sellerId])
  @@index([logisticsPartnerId])
  @@index([trackingCode])
  @@index([status])
  @@index([riderId])
}

// ─── Shipping Zone ────────────────────────────────────────────────────────────

model ShippingZone {
  id        String      @id @default(cuid())
  storeId   String
  name      String
  type      ShippingType @default(flat_rate)
  regions   String[]     // delivery regions
  rates     Json         @default("[]") // array of rate tiers
  sortOrder Int          @default(0)
  active    Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  store Store @relation(fields: [storeId], references: [id])

  @@index([storeId])
  @@index([storeId, active])
}

// ─── Checkout Configuration ───────────────────────────────────────────────────

model CheckoutConfig {
  id             String        @id @default(cuid())
  storeId        String        @unique
  layout         CheckoutLayout @default(multi_step)
  enabledModules String[]      @default(["customer_details","shipping_address","delivery_method","payment_method","order_summary"])
  moduleOrder    String[]      @default(["customer_details","shipping_address","delivery_method","coupon","order_notes","payment_method","order_summary"])
  requirePhone   Boolean       @default(false)
  enableNotes    Boolean       @default(true)
  enableGiftNote Boolean       @default(false)
  enableCoupon   Boolean       @default(true)
  enableUpsells  Boolean       @default(false)
  enableTrustBadges Boolean    @default(true)
  upsellProducts String[]      @default([])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  store Store @relation(fields: [storeId], references: [id])
}

// ─── Product Page Template ────────────────────────────────────────────────────

model ProductPageTemplate {
  id          String             @id @default(cuid())
  storeId     String
  name        String
  variant     ProductPageVariant @default(shopify)
  config      Json               @default("{}") // enabled modules, layout options
  isDefault   Boolean            @default(false)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  store Store @relation(fields: [storeId], references: [id])

  @@index([storeId])
}

// ─── Product Source ───────────────────────────────────────────────────────────

model ProductSource {
  id             String     @id @default(cuid())
  productId      String
  sourceType     ProductSourceType
  sourceId       String?    // supplierId, manufacturerId, etc
  sourceName     String?
  sourceUrl      String?
  importedFrom   String?    // country of origin
  supplierSku    String?
  supplierPrice  Float?
  leadTime       String?
  moq            Int?
  notes          String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  product StoreProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([sourceType])
}

// ─── Notification ──────────────────────────────────────────────────────────────

enum NotificationType {
  order
  payout
  peggy
  marketplace
  system
  inventory
  logistics
  products
  customers
  suppliers
  store_builder
  marketing
  rexai
  checkout
  category
  health
  activity
  dropshipping
}

enum NotificationPriority {
  critical
  warning
  info
  success
}

enum NotificationChannel {
  in_app
  email
  sms
  whatsapp
  push
  browser
}

enum DigestFrequency {
  immediate
  hourly
  daily
  weekly
  disabled
}

model Notification {
  id          String              @id @default(cuid())
  userId      String
  type        NotificationType
  priority    NotificationPriority @default(info)
  title       String
  description String
  link        String?
  actionLabel String?
  actionUrl   String?
  imageUrl    String?
  metadata    Json                @default("{}")
  read        Boolean             @default(false)
  readAt      DateTime?
  scheduledFor DateTime?
  channel     NotificationChannel @default(in_app)
  /// notify(): the event (e.g. "order.new"), its settings category (shared/notifications.ts) and a key that stops
  /// the same thing being sent twice (unique per person).
  event       String?
  category    String?
  dedupeKey   String?
  createdAt   DateTime            @default(now())

  user       User                   @relation(fields: [userId], references: [id])
  deliveries NotificationDelivery[]

  @@unique([userId, dedupeKey])
  @@index([userId])
  @@index([userId, type])
  @@index([userId, priority])
  @@index([userId, read])
  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, category, createdAt(sort: Desc)])
}

/// A phone (Expo push token) or browser (Web Push subscription) that gets push notifications. Belongs to an
/// account (userId) or to a rider (riderId: riders have no account, they use their private link).
model PushDevice {
  id           String    @id @default(cuid())
  userId       String?
  riderId      String?
  /// ios | android | web
  platform     String
  /// expo | webpush
  provider     String
  /// The Expo push token, or the Web Push endpoint URL.
  token        String    @unique
  /// Web Push subscription keys.
  p256dh       String?
  auth         String?
  appVersion   String?
  deviceName   String?
  lastSeenAt   DateTime  @default(now())
  /// Set when the person turns push off here, or the token stops working (uninstalled, expired).
  disabledAt   DateTime?
  failureCount Int       @default(0)
  lastError    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user       User?                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  rider      LogisticsTeamMember?   @relation(fields: [riderId], references: [id], onDelete: Cascade)
  deliveries NotificationDelivery[]

  @@index([userId, disabledAt])
  @@index([riderId, disabledAt])
}

/// Each message sent (or held back) for a notification on push, email, SMS or WhatsApp. Expo push tickets are
/// checked later by /api/cron/push-receipts; "held" rows (quiet hours, a burst) are sent there as one summary.
model NotificationDelivery {
  id             String    @id @default(cuid())
  notificationId String?
  userId         String?
  riderId        String?
  deviceId       String?
  /// push | email | sms | whatsapp
  channel        String
  /// expo | webpush | resend | sms | whatsapp
  provider       String?
  /// sent | ok | error | expired (no receipt) | held_quiet | held_burst | flushed | skipped
  status         String
  ticketId       String?
  collapseKey    String?
  category       String?
  title          String?
  body           String?
  error          String?
  createdAt      DateTime  @default(now())
  checkedAt      DateTime?

  notification Notification? @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  device       PushDevice?   @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([ticketId])
  @@index([userId, collapseKey, createdAt])
  @@index([notificationId])
}

/// Per-person notification settings that aren't a category × channel switch (those are NotificationPreference
/// rows with eventKey "notify.<category>"): quiet hours.
model NotificationSetting {
  userId            String   @id
  quietHoursEnabled Boolean  @default(true)
  /// "HH:MM" in timezone. Default 22:00 to 07:00 Lagos time.
  quietStart        String   @default("22:00")
  quietEnd          String   @default("07:00")
  timezone          String   @default("Africa/Lagos")
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model NotificationPreference {
  id              String          @id @default(cuid())
  userId          String
  role            Role
  eventKey        String
  category        NotificationType
  inApp           Boolean         @default(true)
  email           Boolean         @default(false)
  sms             Boolean         @default(false)
  whatsapp        Boolean         @default(false)
  push            Boolean         @default(false)
  browser         Boolean         @default(false)
  digestFrequency DigestFrequency @default(immediate)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, eventKey, category])
  @@index([userId])
  @@index([role])
  @@index([category])
}

// ─── Activity Event ───────────────────────────────────────────────────────────

model ActivityEvent {
  id          String   @id @default(cuid())
  storeId     String
  userId      String
  type        String   // order_created | product_published | inventory_updated | etc
  title       String
  description String?
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id])

  @@index([storeId])
  @@index([storeId, createdAt(sort: Desc)])
  @@index([userId])
  @@index([type])
}

// ─── Smart Alert Rule ─────────────────────────────────────────────────────────

model SmartAlertRule {
  id             String    @id @default(cuid())
  storeId        String
  name           String
  description    String?
  trigger        String    // low_stock | order_stuck | category_empty | conversion_drop | no_orders
  condition      Json      @default("{}") // threshold values, time windows
  actionType     String    @default("notification") // notification | email | both
  actionConfig   Json      @default("{}") // template, channels
  active         Boolean   @default(true)
  lastTriggeredAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  store Store @relation(fields: [storeId], references: [id])

  @@index([storeId])
  @@index([storeId, active])
  @@index([trigger])
}

// ─── Store Health Score Snapshot ───────────────────────────────────────────────

model StoreHealthSnapshot {
  id              String   @id @default(cuid())
  storeId         String
  score           Int      @default(0) // 0-100
  factors         Json     @default("{}") // { inventory: 80, orders: 75, payments: 90, ... }
  recommendations Json     @default("[]") // [{ action, label, link, impact }]
  createdAt       DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id])

  @@index([storeId])
  @@index([storeId, createdAt(sort: Desc)])
}

// ─── Conversation / Messaging ────────────────────────────────────────────────

model Conversation {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participant1Id String
  participant2Id String

  participant1 User @relation("ConversationParticipant1", fields: [participant1Id], references: [id])
  participant2 User @relation("ConversationParticipant2", fields: [participant2Id], references: [id])

  messages Message[]

  @@unique([participant1Id, participant2Id])
  @@index([participant1Id])
  @@index([participant2Id])
  @@index([updatedAt(sort: Desc)])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  text           String
  read           Boolean  @default(false)
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id])
  sender       User         @relation(fields: [senderId], references: [id])
  detail       MessageDetail?

  @@index([conversationId])
  @@index([conversationId, createdAt(sort: Asc)])
  @@index([conversationId, read])
  @@index([read, createdAt])
}

// Extras for a partner message (attachments, linked product/order/booking, when it was seen, unread email).
// A side table rather than new Message columns, so every existing Message query keeps working before
// docs/migrations/2026-10-12-partner-messages.sql is applied.
model MessageDetail {
  messageId   String    @id
  attachments Json      @default("[]") // [{ path, name, type, size }] in the private messages/ storage folder
  context     Json? // { kind: product | order | wholesale_order | booking, id, label, sub?, image? }
  readAt      DateTime?
  emailedAt   DateTime?
  createdAt   DateTime  @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([emailedAt])
}

// ─── Discount / Promotion ──────────────────────────────────────────────────────

enum DiscountType {
  percentage
  fixed_amount
  free_shipping
  bogo
}

enum DiscountStatus {
  draft
  scheduled
  active
  expired
  disabled
}

model Discount {
  id          String         @id @default(cuid())
  storeId     String
  name        String
  code        String
  type        DiscountType
  value       Float          // percentage value (e.g. 25) or fixed amount
  minOrder    Float?         @default(0)
  maxUses     Int?           @default(0)     // 0 = unlimited
  usedCount   Int            @default(0)
  startsAt    DateTime?
  expiresAt   DateTime?
  status      DiscountStatus @default(draft)
  config      Json           @default("{}") // marketing: { automatic, buyQuantity, getQuantity, getPercent, productIds, segmentId, oncePerCustomer }
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  storeCampaigns StoreCampaign[]

  @@unique([storeId, code])
  @@index([storeId])
  @@index([code])
  @@index([status])
}

// ─── Coupon Code ───────────────────────────────────────────────────────────────

enum CouponStatus {
  active
  used
  expired
  disabled
}

model Coupon {
  id          String        @id @default(cuid())
  storeId     String
  code        String        @unique
  type        DiscountType
  value       Float
  minOrder    Float?        @default(0)
  maxUses     Int?          @default(1)
  usedCount   Int           @default(0)
  expiresAt   DateTime?
  status      CouponStatus  @default(active)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([storeId])
  @@index([code])
  @@index([status])
}

// ─── Subscriber ────────────────────────────────────────────────────────────────

enum SubscriberSource {
  newsletter_form
  checkout_optin
  customer_account
  lead_magnet
  popup
  landing_page
  manual_import
  csv_upload
  api
  order
}

enum SubscriberStatus {
  active
  unsubscribed
  bounced
  spam
}

model Subscriber {
  id             String           @id @default(cuid())
  storeId        String
  email          String
  name           String?
  phone          String?
  country        String?
  source         SubscriberSource @default(newsletter_form)
  status         SubscriberStatus @default(active)
  tags           String[]
  metadata       Json             @default("{}")
  lastOpenedAt   DateTime?
  lastClickedAt  DateTime?
  lastPurchasedAt DateTime?
  totalSpent     Float            @default(0)
  orderCount     Int              @default(0)
  unsubscribedAt DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  store Store @relation(fields: [storeId], references: [id])

  @@unique([storeId, email])
  @@index([storeId])
  @@index([storeId, status])
  @@index([storeId, createdAt(sort: Desc)])
}

// ─── Customer Segment ─────────────────────────────────────────────────────────

model CustomerSegment {
  id          String   @id @default(cuid())
  storeId     String
  name        String
  description String?
  type        String   @default("manual") // manual | auto
  rules       Json     @default("{}")     // filter criteria for auto segments
  subscriberCount Int  @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id])

  @@unique([storeId, name])
  @@index([storeId])
}

// ─── Store Form ────────────────────────────────────────────────────────────────

enum FormType {
  newsletter
  contact
  lead
  custom
  request_quote
  waitlist
  product_inquiry
  wholesale_inquiry
  support
  popup
}

model StoreForm {
