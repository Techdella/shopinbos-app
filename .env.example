# Copy to .env.local (web) and fill in. Never commit real values.
# Every new env var must be added here with a comment.

# --- Core ---
NEXT_PUBLIC_APP_URL=https://app.shopinbos.com
NEXT_PUBLIC_STORE_ROOT_DOMAIN=shopinbos.com
NODE_ENV=development

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server only
DATABASE_URL=                       # pooled (transaction mode) for the app
DIRECT_URL=                         # direct, for migrations; append ?schema=shopinbos (ADR 0006)
DATABASE_POOL_MAX=5                 # Prisma pg pool size per server instance
SUPABASE_AUTH_HOOK_SECRET=          # Send SMS hook signature secret (format: v1,whsec_...)

# --- AI ---
ANTHROPIC_API_KEY=
AI_MODEL_SMART=                     # set to the current top Claude model id at setup
AI_MODEL_FAST=                      # set to the current fast Claude model id
OPENAI_API_KEY=                     # optional: embeddings or image fallback
IMAGE_GEN_API_KEY=                  # logo and image generation provider
VIDEO_GEN_API_KEY=                  # product video provider
BG_REMOVAL_API_KEY=                 # product photo background removal

# --- Payments ---
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=            # Paystack signs with the secret key; keep separate var for clarity

# --- Messaging ---
META_APP_ID=
META_APP_SECRET=
META_SYSTEM_USER_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=           # platform number (OTP + platform messages)
TERMII_API_KEY=                     # or SENDCHAMP_API_KEY
TERMII_SENDER_ID=Shopinbos          # approved Termii sender id
OTP_CHANNEL_ORDER=whatsapp,sms      # try WhatsApp first, then SMS
WHATSAPP_OTP_TEMPLATE=shopinbos_otp # approved WhatsApp authentication template name
WHATSAPP_OTP_TEMPLATE_LANG=en       # template language code
RESEND_API_KEY=
EMAIL_FROM="Shopinbos <hello@shopinbos.com>"

# --- Commerce channels ---
TIKTOK_SHOP_APP_KEY=
TIKTOK_SHOP_APP_SECRET=
GOOGLE_MERCHANT_SERVICE_ACCOUNT_JSON=

# --- Delivery ---
SHIPBUBBLE_API_KEY=
GIG_API_USERNAME=
GIG_API_PASSWORD=
KWIK_API_KEY=
NIPOST_POSTCODE_API_KEY=
GOOGLE_MAPS_API_KEY=                # server
NEXT_PUBLIC_GOOGLE_MAPS_KEY=        # browser, referrer-restricted

# --- Domains ---
DOMAIN_PROVIDER=vercel              # vercel | cloudflare
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
CLOUDFLARE_API_TOKEN=               # only if DOMAIN_PROVIDER=cloudflare
CLOUDFLARE_ZONE_ID=

# --- KYC ---
KYC_PROVIDER=dojah                  # dojah | youverify
DOJAH_APP_ID=
DOJAH_SECRET_KEY=

# --- Jobs, cache, analytics, errors ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# --- Security ---
ENCRYPTION_KEY=                     # 32-byte base64, for app-level encryption of partner secrets
CRON_SECRET=

# --- Mobile (EAS secrets, not in web env) ---
EXPO_PUBLIC_API_URL=https://app.shopinbos.com
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- Tests (local / CI only) ---
RLS_DATABASE_URL=                   # throwaway Postgres admin URL for the cross-org RLS test
E2E_BASE_URL=                       # run Playwright against a deployed preview instead of `next start`
E2E_TEST_PHONE=                     # Supabase test phone number (Auth → Phone → test numbers)
E2E_TEST_OTP=                       # its fixed code
PLAYWRIGHT_CHROMIUM_PATH=           # optional preinstalled Chromium binary
