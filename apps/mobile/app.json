{
  "expo": {
    "name": "Shopinbos",
    "slug": "shopinbos",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "shopinbos",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.shopinbos.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Take photos of your products, and proof of delivery photos.",
        "NSPhotoLibraryUsageDescription": "Choose product photos so Rex can list them in your shop."
      }
    },
    "android": {
      "package": "com.shopinbos.app",
      "adaptiveIcon": {
        "backgroundColor": "#F6F5F9",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-web-browser",
      "expo-font",
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose product photos so Rex can list them in your shop.",
          "cameraPermission": "Take photos of your products, and proof of delivery photos."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/mark-white.png",
          "imageWidth": 76,
          "resizeMode": "contain",
          "backgroundColor": "#0C4A44"
        }
      ]
    ]
  }
}
