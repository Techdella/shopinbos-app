generator client {
  provider = "prisma-client-js"
}

// Run: npx tsx prisma/seed.ts

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  seller
  supplier
  logistics_partner
  admin
}

enum VerificationStatus {
  unverified
  pending
  verified
  rejected
  suspended
}

enum BusinessType {
  manufacturer
  wholesaler
  importer
  dropshipper
}

enum ProductStatus {
  draft
  pending_review
  published
  unpublished
  rejected
}

enum ProductVisibility {
  hidden
  storefront
  featured
  collection_only
}

enum SalesChannel {
  website
  instagram
  whatsapp
  marketplace
  all
}

enum InventoryType {
  seller
  dropshipping
  source_on_demand
  print_on_demand
  digital
}

enum ProductSourceType {
  imported
  local
  supplier
  dropship
  seller
  manufactured
  digital
}

enum FulfillmentType {
  merchant_fulfilled
  dropship
  wholesale_stocked
}

enum OrderStatus {
  pending
  confirmed
  processing
  shipped
  delivered
  cancelled
  refunded
}

enum RetailOrderStatus {
  pending
  awaiting_payment
  paid
  processing
  packed
  shipped
  delivered
  returned
  cancelled
  refunded
  partially_refunded
}

enum QuoteStatus {
  pending
  responded
  accepted
  rejected
  expired
}

enum BookingStatus {
  pending
  confirmed
  picked_up
  in_transit
  delivered
  failed
  cancelled
  /// Logistics marketplace (shared/delivery-market.ts): the partner said no, with a reason.
  declined
  out_for_delivery
  at_pickup_point
  returning
  returned
}

enum ShippingType {
  flat_rate
  weight_based
  zone_based
  free_shipping
  conditional
  distance_based
  hybrid
}

enum CheckoutLayout {
  single_page
  multi_step
  accordion
  minimal
  express
  mobile
}

enum ProductPageVariant {
  shopify
  amazon
  luxury
  minimal
  marketplace
  fashion
  mobile_first
}

// ─── Core User ────────────────────────────────────────────────────────────────

model User {
  id                 String             @id @default(cuid())
  supabaseId         String             @unique
  name               String
  email              String?            @unique
  phone              String?
  role               Role
  /// Admins only: what they can open in the admin portal (src/lib/admin-team/pure.ts). owner | admin | support |
  /// growth | operations | finance, or disabled for a removed team member. Null is an owner (admins from before roles).
  adminRole          String?
  country            String?
  city               String?
  avatarUrl          String?
  aiCredits          Int                @default(5)
  verificationStatus VerificationStatus @default(unverified)
  preferences        Json               @default("{}") // menu items switched off, walkthrough progress (shared/preferences.ts)
  // The paid plan as Paystack's subscription webhooks report it (src/lib/seller-plan.ts). An active annual seller
  // plan paid up past now makes a domain free (src/lib/domains/billing.server.ts).
  planCode           String?
  planInterval       String? // monthly | annual
  planStatus         String? // active | non_renewing | cancelled
  planPaidUntil      DateTime?
  subscriptionCode   String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  store           Store?
  supplier        Supplier?
  logisticsPartner LogisticsPartner?
  wallet          Wallet?

  // Seller actions
  storeProducts     StoreProduct[]
  paymentReceipts   PaymentReceipt[]
  dropshipAsseller   DropshipRelationship[] @relation("SellerDropship")
  quoteRequestsSent  SupplierQuoteRequest[] @relation("SellerQuotes")
  wholesaleOrders    WholesaleOrder[]       @relation("SellerWholesale")
  deliveryQuotes     DeliveryQuoteRequest[]
  deliveryBookings   DeliveryBooking[]
  logisticsReviews   LogisticsReview[]
  notifications      Notification[]
  notificationPreferences NotificationPreference[]
  pushDevices        PushDevice[]
  notificationSetting NotificationSetting?
  onboardingResponses OnboardingResponse[]
  storeLaunchPayments StoreLaunchPayment[]

  // Conversations
  conversationsAs1 Conversation[] @relation("ConversationParticipant1")
  conversationsAs2 Conversation[] @relation("ConversationParticipant2")
  messagesSent     Message[]

  @@index([email])
  @@index([supabaseId])
  @@index([role])
  platformSettingChanges PlatformSettingChange[] @relation("PlatformSettingChanges")
  pricePromotions        PricePromotion[]        @relation("PricePromotions")
  planVersionsCreated    SubscriptionPlanVersion[] @relation("PlanVersionsCreated")
  debtsOwed              BusinessDebt[]          @relation("DebtDebtor")
  debtsOwedTo            BusinessDebt[]          @relation("DebtCreditor")
  supplierAgreements     SupplierAgreement[]     @relation("SellerAgreements")
  contractsAsPartyA      Contract[]              @relation("ContractPartyA")
  contractsAsPartyB      Contract[]              @relation("ContractPartyB")
  /// Paused from new business through Shopinbos for money owed and long overdue (src/lib/money-owed): a supplier is
  /// hidden from sellers looking for products, a delivery partner from sellers looking for delivery, and a seller
  /// can't list new supplier products or place wholesale orders. What they already have keeps working, so their
  /// sales keep paying it off. Cleared by the cron once nothing is long overdue.
  debtPausedAt           DateTime?
  deliverySettings       DeliverySettings?
  deliveryConnections    DeliveryConnection[]
  privateRateCards       LogisticsRateCard[]
  // Status (24-hour stories): the user's posts, and the posts they viewed and liked.
  statusPosts            StatusPost[]
  statusViews            StatusView[]
  statusLikes            StatusLike[]
}

// ─── Store ────────────────────────────────────────────────────────────────────

model Store {
  id                         String   @id @default(cuid())
  userId                     String   @unique
  name                       String
  slug                       String   @unique
  // Addresses the store had before (newest first). They keep redirecting here and no other store can take them.
  previousSlugs              String[] @default([])
  // When the address last changed; changes are limited to one every 30 days (src/lib/store-address.server.ts).
  slugChangedAt              DateTime?
  description                String?
  logoUrl                    String?
  country                    String
  city                       String?
  currency                   String   @default("NGN")
  brandSettings              Json     @default("{}")
  // The address buyers see on the seller's own domain. Only set once ownership is verified (TXT record, or
  // bought through the app); customDomainKey is its www-less lowercase form, unique across stores.
  customDomain               String?
  customDomainKey            String?   @unique
  customDomainVerifiedAt     DateTime?
  // A domain the seller is proving they own, and the token they publish at _shopinbos-verify.<domain>.
  pendingDomain              String?
  domainVerifyToken          String?
  status                     String   @default("active")
  onboardingState            String?
  firstDashboardVisitComplete Boolean  @default(false)
  /// When a supplier doesn't accept in time, send the order to another supplier with the same product (on by
  /// default), as long as the cost stays within the limit: "cost" = at most switchMaxIncreasePct above the
  /// original cost; "margin" = the seller keeps at least switchMinMarginPct of their price.
  autoSwitchSupplier         Boolean  @default(true)
  switchCostRule             String   @default("cost")
  switchMaxIncreasePct       Int      @default(10)
  switchMinMarginPct         Int      @default(20)
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  user          User           @relation(fields: [userId], references: [id])
  storeProducts StoreProduct[]
  pages         StorePage[]
  retailOrders  RetailOrder[]
  productReviews ProductReview[]
  visitors       StoreVisitor[]
  wishlistItems  StoreWishlistItem[]
  formSubmissions StoreFormSubmission[]
  abandonedCartEvents AbandonedCartEvent[]
  collections    Collection[]
  shippingZones  ShippingZone[]
  checkoutConfig CheckoutConfig?
  productPageTemplates ProductPageTemplate[]
  activityEvents ActivityEvent[]
  smartAlertRules SmartAlertRule[]
  healthSnapshots StoreHealthSnapshot[]
  subscribers    Subscriber[]
  customerSegments CustomerSegment[]
  storeForms     StoreForm[]
  liveChatConfig LiveChatConfig?
  abandonedCartConfig AbandonedCartConfig?
  emailTemplates EmailTemplate[]
  broadcastCampaigns BroadcastCampaign[]
  automations    AutomationRule[]
  launchPayments StoreLaunchPayment[]
  affiliates     Affiliate[]
  adCampaigns    AdCampaign[]
  storeCampaigns StoreCampaign[]
  paymentLinks   PaymentLink[]
  bioPage        BioPage?

  @@index([slug])
  @@index([previousSlugs], type: Gin)
  @@index([userId])
}

// ─── Store Page ───────────────────────────────────────────────────────────────

model StorePage {
  id               String    @id @default(cuid())
  storeId          String
  type             String    // home | products | about | contact | faq | blog | custom
  title            String
  slug             String
  content          Json      @default("{}")       // published content snapshot
  draftContent     Json?                          // in-progress edits (seo, nav, etc.)
  publishedContent Json?                          // last published snapshot before live
  isPublished      Boolean   @default(false)      // shortcut for status === "published"
  status           String    @default("draft")    // "draft" | "published" | "hidden" | "scheduled" | "archived"
  publishAt        DateTime?
  archivedAt       DateTime?
  order            Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  store Store @relation(fields: [storeId], references: [id])

  @@index([storeId])
  @@unique([storeId, slug])
}

model StoreLaunchPayment {
  id               String   @id
  userId           String   @map("user_id")
  storeId          String   @map("store_id")
  reference        String   @unique
  paymentOption    String   @map("payment_option")
  totalAmount      Int      @map("total_amount")
  amountDue        Int      @map("amount_due")
  amountPaid       Int      @default(0) @map("amount_paid")
  balanceDue       Int      @map("balance_due")
  currency         String   @default("NGN")
  status           String   @default("initialized")
  dueAt            DateTime? @map("due_at")
  paidAt           DateTime? @map("paid_at")
  providerResponse Json?    @map("provider_response")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  user  User  @relation(fields: [userId], references: [id])
  store Store @relation(fields: [storeId], references: [id])

  @@index([storeId])
  @@index([userId])
  @@map("store_launch_payments")
}

model OnboardingResponse {
  id             String   @id
  userId         String   @map("user_id")
  organizationId String?  @map("organization_id")
  accountType    String?  @map("account_type")
  questionKey    String   @map("question_key")
  answer         Json
  source         String   @default("rex")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, questionKey])
  @@index([userId])
  @@map("onboarding_responses")
}

model StoreVisitor {
  id          String   @id @default(cuid())
  storeId     String
  visitorKey  String
  email       String?
  name        String?
  phone       String?
  lastSeenAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id])
  wishlistItems StoreWishlistItem[]
  formSubmissions StoreFormSubmission[]
  abandonedCartEvents AbandonedCartEvent[]

  @@unique([storeId, visitorKey])
  @@index([storeId, email])
}

model StoreWishlistItem {
  id        String   @id @default(cuid())
  storeId   String
  visitorId String
  productId String
  createdAt DateTime @default(now())

  store   Store @relation(fields: [storeId], references: [id])
  visitor StoreVisitor @relation(fields: [visitorId], references: [id])
  product StoreProduct @relation(fields: [productId], references: [id])

  @@unique([visitorId, productId])
  @@index([storeId])
  @@index([productId])
}

model StoreFormSubmission {
  id        String   @id @default(cuid())
  storeId   String
  visitorId String?
  type      String   @default("contact")
  name      String?
  email     String?
  phone     String?
  message   String?
  payload   Json     @default("{}")
  status    String   @default("new")
  createdAt DateTime @default(now())

  store   Store @relation(fields: [storeId], references: [id])
  visitor StoreVisitor? @relation(fields: [visitorId], references: [id])

  @@index([storeId, createdAt])
  @@index([email])
}

// Forms filled on shopinbos.com (WordPress): newsletter, WhatsApp tips, guide downloads, tool results, contact.
// The website posts each one to /api/public/website-leads, signed with WEBSITE_LEADS_SECRET. Admin: /admin/leads.
model WebsiteLead {
  id         String   @id @default(cuid())
  externalId String   @unique
  kind       String
  name       String?
  email      String?
  phone      String?
  message    String?
  source     String   @default("")
  pageUrl    String?
  consent    Boolean  @default(false)
  payload    Json     @default("{}")
  status     String   @default("new")
  note       String?
  // Lead growth (src/lib/lead-growth): the account this lead became (matched on email or phone at sign-up), and
  // the channels they asked us to stop using ("email" | "sms" | "whatsapp").
  convertedUserId String?
  convertedAt     DateTime?
  optedOut        String[] @default([])
  lastMessagedAt  DateTime?
  role            String   @default("seller") // seller | supplier | delivery (payload.as from the waitlist)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  messages    LeadMessage[]
  enrollments LeadEnrollment[]

  @@index([status, createdAt])
  @@index([kind, createdAt])
  @@index([email])
  @@index([phone])
  @@index([convertedAt])
  @@index([role])
}

// ─── Lead growth: campaigns and automations to turn website leads into users ───────────────────────────────────
// Admin › Lead campaigns. One message per lead per campaign (or per automation step), claimed before it is sent,
// so a retried run never sends twice. docs/migrations/2026-11-05-lead-growth.sql

model LeadCampaign {
  id          String    @id @default(cuid())
  name        String
  channel     String // email | sms | whatsapp
  status      String    @default("draft") // draft | scheduled | sending | sent | cancelled
  audience    Json      @default("{}") // LeadAudience (src/lib/lead-growth/pure.ts)
  subject     String?
  body        String
  ctaLabel    String?
  ctaUrl      String?
  waTemplate  String? // approved WhatsApp template name; without one the body goes as plain text
  waLanguage  String?
  imageUrl    String? // banner: under the email heading, or the WhatsApp template's image header
  scheduledAt DateTime?
  startedAt   DateTime?
  finishedAt  DateTime?
  total       Int       @default(0)
  sent        Int       @default(0)
  failed      Int       @default(0)
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  messages LeadMessage[]

  @@index([status, scheduledAt])
}

model LeadAutomation {
  id              String    @id @default(cuid())
  name            String
  active          Boolean   @default(false)
  audience        Json      @default("{}") // LeadAudience
  steps           Json      @default("[]") // LeadStep[]: { delayHours | at, skipAfter?, channel, subject?, body, ctaLabel?, ctaUrl?, waTemplate? }
  includeExisting Boolean   @default(false) // also enrol leads that came in before it was switched on
  activatedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  enrollments LeadEnrollment[]
  messages    LeadMessage[]
}

model LeadEnrollment {
  id           String         @id @default(cuid())
  automationId String
  leadId       String
  step         Int            @default(0) // the next step to send
  nextAt       DateTime
  status       String         @default("active") // active | done | stopped
  stopReason   String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  automation   LeadAutomation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  lead         WebsiteLead    @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([automationId, leadId])
  @@index([status, nextAt])
}

model LeadMessage {
  id           String          @id @default(cuid())
  leadId       String
  campaignId   String?
  automationId String?
  step         Int?
  channel      String
  to           String
  status       String          @default("sending") // sending | sent | failed | skipped
  error        String?
  providerId   String?
  sentAt       DateTime?
  createdAt    DateTime        @default(now())
  lead         WebsiteLead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  campaign     LeadCampaign?   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  automation   LeadAutomation? @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@unique([campaignId, leadId])
  @@unique([automationId, leadId, step])
  @@index([leadId])
  @@index([status, createdAt])
}

// One row per signed-in account per day they used the app (Admin › Analytics: active users and retention).
model UserActivityDay {
  userId String
  day    DateTime @db.Date
  role   String

  @@id([userId, day])
  @@index([day])
}

// ─── Supplier ─────────────────────────────────────────────────────────────────

model Supplier {
  id                 String             @id @default(cuid())
  userId             String             @unique
  businessName       String
  slug               String             @unique
  displayName        String
  businessType       BusinessType
  country            String
  city               String
  address            String?
  description        String?
  logoUrl            String?
  bannerUrl          String?
  categories         String[]
  verificationDocuments Json               @default("[]")
  onboardingState    Json               @default("{}")
  blogPosts          Json               @default("[]")
  verificationStatus VerificationStatus @default(pending)
  trustScore         Int                @default(0)
  rating             Float              @default(0)
  ratingCount        Int                @default(0)
  responseTime       String?
  responseTimeLabel  String?
  whatsappNumber     String?
  website            String?
  status             String             @default("active")
  /// Hours this supplier has to accept a new order (admin override; null = SUPPLIER_ACCEPT_HOURS_* or 4 h / 24 h).
  acceptHoursDropship  Int?
  acceptHoursWholesale Int?
  /// New orders that ran out of time without an answer (src/lib/supplier-orders/acceptance.server.ts).
  missedOrders       Int                @default(0)
  /// What this supplier takes back and how (shown to sellers before they list a product). Empty: the minimum in the
  /// Supplier terms applies (wrong, damaged or not-as-described items).
  returnPolicy       String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  user             User                   @relation(fields: [userId], references: [id])
  products         SupplierProduct[]
  dropships        DropshipRelationship[] @relation("SupplierDropship")
  quoteRequests    SupplierQuoteRequest[] @relation("SupplierQuotes")
  wholesaleOrders  WholesaleOrder[]       @relation("SupplierWholesale")
  supplierOrders   SupplierOrder[]
  agreements       SupplierAgreement[]
  payoutAccount    SupplierPayoutAccount?
  teamMembers      SupplierTeamMember[]
  reviews          SupplierReview[]

  @@index([slug])
  @@index([country, city])
  @@index([verificationStatus])
}

model SupplierPayoutAccount {
  id                        String   @id @default(cuid())
  supplierId                String   @unique
  bankName                  String
  bankCode                  String?
  accountNumberMask         String
  accountName               String
  paystackRecipientCode     String?
  paystackRecipientId       String?
  verificationStatus        String   @default("pending")
  providerResponse          Json     @default("{}")
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  supplier Supplier @relation(fields: [supplierId], references: [id])

  @@index([supplierId])
  @@index([verificationStatus])
}

model SupplierReview {
  id              String   @id @default(cuid())
  supplierId      String
  reviewerId      String
  targetId        String
  targetRole      String   // "seller" | "logistics_partner" | "supplier"
  interactionType String   // "wholesale_order" | "delivery_booking"
  interactionId   String
  rating          Int      // 1-5
  title           String   @default("")
  comment         String?
  reply           String?  // response from the reviewed party
  repliedAt       DateTime?
  status          String   @default("active")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  supplier Supplier @relation(fields: [supplierId], references: [id])

  @@unique([supplierId, interactionId, reviewerId])
  @@index([supplierId])
  @@index([reviewerId])
  @@index([targetId])
}

model SupplierTeamMember {
  id                 String   @id @default(cuid())
  supplierId         String
  name               String
  email              String
  phone              String?
  role               String   @default("manager")
  status             String   @default("active")
  invitedAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  supplier Supplier @relation(fields: [supplierId], references: [id])

  @@unique([supplierId, email])
  @@index([supplierId])
  @@index([status])
}

// ─── Category ─────────────────────────────────────────────────────────────────

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  imageUrl    String?
  parentId    String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")

  supplierProducts SupplierProduct[]
  storeProducts    StoreProduct[]

  @@index([slug])
}

// ─── Supplier Product ─────────────────────────────────────────────────────────

model SupplierProduct {
  id                    String        @id @default(cuid())
  supplierId            String
  name                  String
  slug                  String        @unique
  description           String
  categoryId            String
  images                String[]
  wholesalePrice        Float
  wholesalePriceTo      Float?
  suggestedRetailPrice  Float
  currency              String        @default("NGN")
  moq                   Int           @default(1)
  stockQuantity         Int           @default(0)
  pricingTiers          Json          @default("[]")
  dropshipAvailable     Boolean       @default(false)
  bulkOrderAvailable    Boolean       @default(true)
  sampleAvailable       Boolean       @default(false)
  deliveryRegions       String[]
  processingTime        String?
  trendScore            Float         @default(0)
  /// The same product from several suppliers shares a family key (or names another listing's id). Used to send an
  /// order to another supplier when one doesn't answer (src/lib/supplier-orders/switch.server.ts).
  familyKey             String?
  /// Sizes and colours the supplier has: [{ size?, color? }]. Empty = one kind only.
  variants              Json          @default("[]")
  status                ProductStatus @default(draft)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  supplier      Supplier       @relation(fields: [supplierId], references: [id])
  category      Category       @relation(fields: [categoryId], references: [id])
  storeProducts StoreProduct[]
  dropships     DropshipRelationship[]
  quoteRequests SupplierQuoteRequest[]
  wholesales    WholesaleOrder[]

  @@index([supplierId])
  @@index([categoryId])
  @@index([slug])
  @@index([status])
  @@index([trendScore(sort: Desc)])
  @@index([familyKey])
}

// ─── Store Product ────────────────────────────────────────────────────────────

model StoreProduct {
  id                String          @id @default(cuid())
  storeId           String
  userId            String
  supplierProductId String?
  name              String
  description       String?
  longDescription   String?
  specifications    Json            @default("[]")
  faqs              Json            @default("[]")
  careInstructions  String?
  shippingInfo      String?
  returnPolicy      String?
  warranty          String?
  supportInfo       String?
  sku               String?
  barcode           String?
  images            String[]
  videoUrl          String?
  has360View        Boolean         @default(false)
  retailPrice       Float
  costPrice         Float?
  compareAtPrice    Float?
  currency          String          @default("NGN")
  margin            Float?
  weight            Float?
  weightUnit        String          @default("kg")
  dimensions        Json?           // { length, width, height, unit }
  // Delivery size band (shared/delivery-market.ts): small | medium | bulky. Null: from the weight, else the store's default.
  sizeBand          String?
  fulfillmentType   FulfillmentType @default(merchant_fulfilled)
  status            String          @default("draft")
  visibility        ProductVisibility @default(hidden)
  salesChannel      SalesChannel    @default(website)
  inventoryType     InventoryType   @default(seller)
  sourceType        ProductSourceType? // tracks original source
  categoryId        String?
  variants          Json?
  // Preset category (shared/product-types.ts); null = "other". Details are { fieldKey: value }.
  productType       String?
  productDetails    Json            @default("{}")
  // Options for the versions in order: [{ name, values }] (shared/product-variants.ts).
  variantOptions    Json            @default("[]")
  // "Customers also like": up to 8 of the store's own products.
  relatedProductIds String[]        @default([])
  tags              String[]
  featured          Boolean         @default(false)
  sortOrder         Int             @default(0)

  // Inventory tracking
  currentStock      Int             @default(0)
  reservedStock     Int             @default(0)
  soldStock         Int             @default(0)
  incomingStock     Int             @default(0)
  damagedStock      Int             @default(0)
  lowStockThreshold Int             @default(10)
  // Explicit stock tracking (shared/product-stock.ts). Off: the product is never sold out and checkout takes no
  // stock (the count, if any, is ignored). On: shoppers can buy up to currentStock - reservedStock (and each
  // version's own count). Dropship products always use the supplier's stock instead.
  trackStock             Boolean    @default(false)
  // Tracked products only: keep selling at 0 (backorder); the count may then go below zero.
  continueSellingWhenOut Boolean    @default(false)

  // Product page builder
  // Per-product page settings: { override: true, layout?, buyBox?, sections? } overrides the store's product page
  // settings (src/components/storefront/boutique/pdp/product-override.ts). Without the marker: store default.
  pageLayout        Json            @default("{}")
  pageVariant       ProductPageVariant @default(shopify)
  descriptionBuilder Json           @default("{}")
  enabledModules    String[]        @default([]) // which page modules are on

  // SEO & marketing
  seoTitle          String?
  seoDescription    String?
  marketingCopy     String?
  socialMediaCopy   String?

  // Supplier sync info
  supplierStock     Int?            @default(0)
  supplierLastSync  DateTime?

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  store           Store            @relation(fields: [storeId], references: [id])
  user            User             @relation(fields: [userId], references: [id])
  category        Category?        @relation(fields: [categoryId], references: [id])
  supplierProduct SupplierProduct? @relation(fields: [supplierProductId], references: [id])
  dropship        DropshipRelationship?
  reviews         ProductReview[]
  wishlistItems   StoreWishlistItem[]
  collections     CollectionProduct[]
  stockMovements  StockMovement[]
  productSources  ProductSource[]

  @@index([storeId])
  @@index([storeId, productType])
  @@index([supplierProductId])
  @@index([categoryId])
  @@index([sku])
  @@index([status])
  @@index([visibility])
  @@index([featured])
}

// ─── Collection ───────────────────────────────────────────────────────────────

model Collection {
  id          String   @id @default(cuid())
  storeId     String
  name        String
  slug        String
  description String?
  imageUrl    String?
  type        String   @default("manual") // manual | auto
  rules       Json     @default("{}")     // auto-collection rules
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  store    Store              @relation(fields: [storeId], references: [id])
  products CollectionProduct[]

  @@unique([storeId, slug])
  @@index([storeId])
}

model CollectionProduct {
  id           String   @id @default(cuid())
  collectionId String
  productId    String
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())

  collection Collection  @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product    StoreProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([collectionId, productId])
  @@index([collectionId])
  @@index([productId])
}

// ─── Dropship Relationship ────────────────────────────────────────────────────

model DropshipRelationship {
  id                String   @id @default(cuid())
  sellerId          String
  storeId           String
  supplierId        String
  supplierProductId String
  storeProductId    String   @unique
  status            String   @default("active")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  seller          User            @relation("SellerDropship", fields: [sellerId], references: [id])
  supplier        Supplier        @relation("SupplierDropship", fields: [supplierId], references: [id])
  supplierProduct SupplierProduct @relation(fields: [supplierProductId], references: [id])
  storeProduct    StoreProduct    @relation(fields: [storeProductId], references: [id])

  @@index([sellerId])
  @@index([supplierId])
}

// ─── Supplier Quote Request ───────────────────────────────────────────────────

model SupplierQuoteRequest {
  id                String      @id @default(cuid())
  sellerId          String
  supplierId        String
  supplierProductId String
  quantity          Int
  destination       String
  notes             String?
  status            QuoteStatus @default(pending)
  quotedPrice       Float?
  supplierResponse  String?
  expiresAt         DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  seller          User            @relation("SellerQuotes", fields: [sellerId], references: [id])
  supplier        Supplier        @relation("SupplierQuotes", fields: [supplierId], references: [id])
  supplierProduct SupplierProduct @relation(fields: [supplierProductId], references: [id])

  @@index([sellerId])
  @@index([supplierId])
  @@index([status])
}

// ─── Wholesale Order ──────────────────────────────────────────────────────────

model WholesaleOrder {
  id                String      @id @default(cuid())
  sellerId          String
  supplierId        String
  supplierProductId String
  quantity          Int
  unitPrice         Float
  totalPrice        Float
  currency          String      @default("NGN")
  deliveryAddress   String
  notes             String?
  status            OrderStatus @default(pending)
  trackingCode      String?
  rejectReason      String?   // why the supplier declined (status cancelled)
  shippedAt         DateTime?
  deliveredAt       DateTime?
  stockReserved     Int         @default(0) // supplier stock taken when placed (0: none tracked, e.g. older orders)
  stockReleasedAt   DateTime?   // given back once (declined or cancelled)
  paidOutAt         DateTime?   // the supplier confirmed they were paid
  paidAt            DateTime?   // the seller paid in Shopinbos by card (split straight to the supplier's wallet)
  paymentRef        String?     @unique // that Paystack reference (whpay-…)
  acceptBy          DateTime?   // the supplier must accept by then, or it is cancelled (expiredAt set)
  acceptReminderAt  DateTime?   // "1 hour left" reminder sent
  expiredAt         DateTime?   // ran out of time without an answer (status cancelled)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  seller          User            @relation("SellerWholesale", fields: [sellerId], references: [id])
  supplier        Supplier        @relation("SupplierWholesale", fields: [supplierId], references: [id])
  supplierProduct SupplierProduct @relation(fields: [supplierProductId], references: [id])

  @@index([sellerId])
  @@index([supplierId])
  @@index([status])
  @@index([status, acceptBy])
}

// ─── Supplier Order (dropship) ────────────────────────────────────────────────
// What a supplier ships for a seller's store order: one per (store order, supplier), created when the order is
// paid (or placed, for pay on delivery). Lines, cost and address are a snapshot taken then.

model SupplierOrder {
  id              String    @id @default(cuid())
  idempotencyKey  String    @unique // "dropship:<retailOrderId>:<supplierId>" (src/lib/supplier-orders/pure.ts)
  supplierId      String
  retailOrderId   String
  storeId         String
  sellerId        String
  status          String    @default("pending") // pending | accepted | shipped | delivered | rejected | cancelled
  items           Json      @default("[]") // [{ storeProductId, supplierProductId, name, variant, quantity, unitCost, image }]
  costTotal       Float     @default(0) // wholesale cost the supplier is owed
  currency        String    @default("NGN")
  shippingAddress Json      @default("{}")
  recipientName   String
  recipientPhone  String?
  trackingCode    String?
  carrier         String?
  rejectReason    String?
  acceptedAt      DateTime?
  shippedAt       DateTime?
  deliveredAt     DateTime?
  rejectedAt      DateTime?
  paidOutAt       DateTime? // the supplier confirmed they were paid what they're owed (costTotal)
  acceptBy        DateTime? // the supplier must accept by then, or it expires (status expired)
  acceptReminderAt DateTime? // "1 hour left" reminder sent
  expiredAt       DateTime?
  packedAt        DateTime? // the supplier said "I've packed it"
  stockReleasedAt DateTime? // the supplier stock this order's lines held went back (expired), once
  /// Automatic switch: the expired order this one took over (idempotencyKey "switch:<that id>").
  replacesId      String?
  /// The seller pressed Undo before this supplier accepted (status cancelled).
  undoneAt        DateTime?
  /// The supplier delivers this parcel itself (the customer chose its delivery at checkout): the fee it earns and
  /// the 4-digit code the customer gives it on arrival.
  selfDelivery    Boolean   @default(false)
  deliveryFee     Float     @default(0)
  deliveryCode    String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  supplier    Supplier    @relation(fields: [supplierId], references: [id])
  retailOrder RetailOrder @relation(fields: [retailOrderId], references: [id], onDelete: Cascade)

  @@index([supplierId, status])
  @@index([retailOrderId])
  @@index([storeId])
  @@index([status, acceptBy])
  @@index([replacesId])
}

/// What happened when a supplier didn't accept a shop's order in time: switched to another supplier, nobody
/// qualified, the shop turned switching off, or the limit was reached; later "undone" when the seller pressed
/// Undo. One row per expired supplier order (unique), so a cron re-run never switches twice.
model SupplierSwitch {
  id                  String    @id @default(cuid())
  retailOrderId       String
  storeId             String
  fromSupplierOrderId String    @unique
  fromSupplierId      String
  /// switched | undone | none | off | limit
  outcome             String
  toSupplierOrderId   String?   @unique
  toSupplierId        String?
  costBefore          Float     @default(0)
  costAfter           Float?
  note                String?
  undoneAt            DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([retailOrderId])
  @@index([storeId, createdAt])
}

/// A rider booked to collect a supplier's packed order at a set time (dropship SupplierOrder or WholesaleOrder,
/// one per order). Links the delivery job once a partner is found; "finding_rider" waits for the admin team.
model SupplierPickup {
  id                 String    @id @default(cuid())
  orderKind          String    // dropship | wholesale
  orderId            String
  supplierId         String
  sellerId           String
  /// booked | finding_rider | cancelled | picked_up | delivered
  status             String    @default("booked")
  pickupAddress      String
  slotKey            String
  windowStart        DateTime
  windowEnd          DateTime
  deliveryBookingId  String?   @unique
  logisticsPartnerId String?
  needsAdmin         Boolean   @default(false)
  adminNote          String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([orderKind, orderId])
  @@index([supplierId])
  @@index([needsAdmin, status])
}

// ─── Logistics Partner ────────────────────────────────────────────────────────

model LogisticsPartner {
  id                 String             @id @default(cuid())
  userId             String             @unique
  companyName        String
  slug               String             @unique
  displayName        String
  country            String
  city               String
  address            String?
  description        String?
  logoUrl            String?
  bannerUrl          String?
  coverageZones      String[]
  coverageMap        Json               @default("{}")
  vehicleTypes       String[]
  deliveryTypes      String[]
  onboardingState    Json               @default("{}")
  blogPosts          Json               @default("[]")
  pricingModel       String             @default("fixed")
  basePrice          Float              @default(0)
  estimatedSpeed     String?
  reliabilityScore   Int                @default(0)
  rating             Float              @default(0)
  ratingCount        Int                @default(0)
  verificationStatus VerificationStatus @default(pending)
  verificationDocuments Json            @default("[]")
  whatsappNumber     String?
  status             String             @default("active")
  /// Cash pay-ins: money paid in beyond the cash jobs it could settle, used first by the next pay-in.
  payInCredit        Float              @default(0)
  /// Late pay-ins (lib/logistics/payin-deadline.ts): paused from new pay-when-it-arrives (COD) jobs only. Set and
  /// cleared by the system (cron + pay-in matching) or the team, never by the partner's "Taking new jobs" switch.
  codPaused          Boolean            @default(false)
  /// The missed pay-in deadline (6pm Lagos) of the oldest cash still owed, while the partner is late.
  payInOverdueSince  DateTime?
  /// Cash past its deadline and grace, still owed after credit.
  payInOverdueAmount Float              @default(0)
  /// 24 hours late: told again, high priority for the team.
  payInEscalatedAt   DateTime?
  /// 72 hours late: flagged for the team to review (never suspended automatically).
  payInReviewAt      DateTime?
  /// The team unpaused the partner for this late period; the cron won't pause them again until it clears.
  payInPauseWaived   Boolean            @default(false)
  /// Late days counted against the partner (each also lowers reliabilityScore).
  payInStrikes       Int                @default(0)
  /// Logistics marketplace (shared/delivery-market.ts): business details sellers and the team see.
  cacNumber          String?
  contactName        String?
  contactPhone       String?
  contactEmail       String?
  /// doorstep | pickup_point | same_day | interstate
  services           String[]           @default([])
  /// Where they collect from and where they deliver to: states, "Lagos: Ikeja" areas, regions or "Nationwide".
  pickupAreas        String[]           @default([])
  deliveryAreas      String[]           @default([])
  /// The partner collects pay-on-delivery cash for shops that also opt in, per connection.
  offersPayOnDelivery Boolean           @default(false)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  user           User                   @relation(fields: [userId], references: [id])
  rateCards      LogisticsRateCard[]
  pickupPoints   LogisticsPickupPoint[]
  connections    DeliveryConnection[]
  deliveryIssues DeliveryIssue[]
  quoteRequests  DeliveryQuoteRequest[]
  bookings       DeliveryBooking[]
  teamMembers    LogisticsTeamMember[]
  remittances    CodRemittance[]
  apiKeys        PartnerApiKey[]
  webhooks       PartnerWebhook[]
  payoutAccount  LogisticsPayoutAccount?
  reviews        LogisticsReview[]
  payInAccount   PartnerPayInAccount?
  payIns         PartnerPayIn[]
  payInEvents    PartnerPayInEvent[]

  @@index([slug])
  @@index([country, city])
}

model LogisticsReview {
  id                 String   @id @default(cuid())
  logisticsPartnerId String
  reviewerId         String
  bookingId          String?   @unique
  rating             Int       @default(5) // 1-5
  comment            String?
  response           String?   // partner reply
  respondedAt        DateTime?
  createdAt          DateTime  @default(now())

  logisticsPartner LogisticsPartner @relation(fields: [logisticsPartnerId], references: [id])
  reviewer         User             @relation(fields: [reviewerId], references: [id])
  booking          DeliveryBooking? @relation(fields: [bookingId], references: [id])

  @@index([logisticsPartnerId])
  @@index([reviewerId])
}

model LogisticsTeamMember {
  id                 String           @id @default(cuid())
  logisticsPartnerId String
  name               String
  email              String
  phone              String?
  role               String           @default("dispatcher")
  status             String           @default("active")
  /// Riders app: SHA-256 of the private link token the partner shares with the rider (never stored raw).
  riderTokenHash     String?          @unique
  online             Boolean          @default(false)
  lastSeenAt         DateTime?
  /// Riders app: the rider's latest location only (reported while online or on a job). Never shown to shops or customers.
  lastLat            Float?
  lastLng            Float?
  lastAccuracy       Float?
  lastLocationAt     DateTime?
  /// Riders app (phone): the bike's number plate the partner typed when adding the rider, and the language the rider
  /// picked (en | pcm | yo | ha | ig). Both optional.
  plate              String?
  language           String?
  /// Rider pay the partner set (src/lib/logistics/job-rules.ts riderPayFor): "per_drop" pays payRate naira for each
  /// delivered job, "share" pays payRate percent of the partner's fee after the Shopinbos fee. Null: not set, so the
  /// Riders app shows delivery fees instead of earnings.
  payType            String?
  payRate            Float?
  invitedAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  logisticsPartner LogisticsPartner @relation(fields: [logisticsPartnerId], references: [id])
  jobs             DeliveryBooking[]
  trail            RiderLocationPoint[]
  pushDevices      PushDevice[]

  @@unique([logisticsPartnerId, email])
  @@index([logisticsPartnerId])
  @@index([status])
}

// ─── Logistics Payout Account ─────────────────────────────────────────────────

model LogisticsPayoutAccount {
  id                        String   @id @default(cuid())
  logisticsPartnerId        String   @unique
  provider                  String   @default("flutterwave") // flutterwave | paystack
  bankName                  String
  bankCode                  String?
  accountNumberMask         String
  accountName               String
  recipientCode             String?  // Flutterwave transfer recipient code
  recipientId               String?  // Flutterwave or Paystack recipient ID
  verificationStatus        String   @default("pending")
  providerResponse          Json     @default("{}")
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  logisticsPartner LogisticsPartner @relation(fields: [logisticsPartnerId], references: [id])

  @@index([logisticsPartnerId])
  @@index([verificationStatus])
}

// ─── Platform Fee Config ─────────────────────────────────────────────────────

model PlatformFeeConfig {
  id        String @id @default(cuid())
  active    Boolean @default(true)
  rate      Float   @default(1.5) // percentage
  bearer    String  @default("seller") // seller | supplier | logistics_partner
  minFee    Float   @default(0)
  maxFee    Float   @default(0) // 0 = no max
  updatedAt DateTime @updatedAt
}

// ─── Delivery Quote Request ───────────────────────────────────────────────────

model DeliveryQuoteRequest {
  id                 String      @id @default(cuid())
  sellerId           String
  logisticsPartnerId String
  pickupLocation     String
  destination        String
  packageDetails     Json
  preferredDate      DateTime?
  status             QuoteStatus @default(pending)
  quotedPrice        Float?
  partnerResponse    String?
  expiresAt          DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  seller           User             @relation(fields: [sellerId], references: [id])
  logisticsPartner LogisticsPartner @relation(fields: [logisticsPartnerId], references: [id])

  @@index([sellerId])
  @@index([logisticsPartnerId])
}

// ─── Delivery Booking ─────────────────────────────────────────────────────────

model DeliveryBooking {
  id                 String        @id @default(cuid())
  sellerId           String
  logisticsPartnerId String
  orderId            String?
  pickupLocation     String
  destination        String
  packageDetails     Json
  deliveryFee        Float
  currency           String        @default("NGN")
  status             BookingStatus @default(pending)
  platformFee        Float         @default(0)
  feeBearer          String        @default("seller") // seller | supplier | logistics_partner
  netAmount          Float         @default(0)
  trackingCode       String?       @unique
  estimatedDelivery  DateTime?
  deliveredAt        DateTime?
  notes              String?
  /// Rider (a LogisticsTeamMember) the partner assigned the job to.
  riderId            String?
  /// What the rider earned for this job, saved when it's delivered from the rider's pay at that moment, so later
  /// pay changes never touch it. Null for jobs delivered without a rider or before the rider's pay was set.
  riderPay           Float?
  pickedUpAt         DateTime?
  failedReason       String?
  /// 4-digit code the buyer gives the rider as proof of delivery.
  deliveryCode       String?
  /// 4-digit code the shop (or supplier) handing over the parcel gives the rider at pickup. Made when the job is
  /// accepted (or the first time the shop's screen asks for it); the Riders app checks it before "picked up".
  pickupCode         String?
  proofUrl           String?
  /// Pay on delivery: amount to collect, what was collected and how, and the remittance that settled it.
  codAmount          Float?
  codCollected       Float?
  codMethod          String? // cash | transfer
  codCollectedAt     DateTime?
  /// The seller paid the delivery fee by card, split straight to the partner's bank (src/lib/logistics/delivery-fee-payments.server.ts).
  feePaidAt          DateTime?
  feePaymentRef      String?       @unique
  remittanceId       String?
  /// When the rider should collect it (supplier pickups): "Pick up 12–4pm today".
  pickupWindowStart  DateTime?
  pickupWindowEnd    DateTime?
  /// Pickup coordinates for "closest rider" (lib/logistics/geocode.ts): google | nominatim | area.
  pickupLat          Float?
  pickupLng          Float?
  pickupGeoSource    String?
  pickupGeocodedAt   DateTime?
  /// Logistics marketplace jobs (src/lib/delivery-market): doorstep | pickup_point, the parcel's size band, the
  /// pickup point, the connection and rate card it was priced from (the fee is kept, so later rate changes never
  /// touch it), and which part of the order it carries: own | supplier:<supplierId>.
  service            String?
  sizeBand           String?
  pickupPointId      String?
  connectionId       String?
  rateCardId         String?
  shipmentKey        String?
  /// Accept by then, or the job goes to the shop's exceptions to send to another partner.
  acceptBy           DateTime?
  acceptedAt         DateTime?
  declinedAt         DateTime?
  declineReason      String?
  /// The shop marked the parcel packed and ready for the rider.
  readyAt            DateTime?
  outForDeliveryAt   DateTime?
  atPickupPointAt    DateTime?
  returnedAt         DateTime?
  failedAttempts     Int           @default(0)
  /// The job that took over after this one was declined or ran late.
  replacedById       String?
  /// Pay on delivery agreed between the shop and the partner: a record only (Shopinbos never holds the cash).
  codRemittedAt      DateTime?
  codConfirmedAt     DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  seller           User                 @relation(fields: [sellerId], references: [id])
  logisticsPartner LogisticsPartner     @relation(fields: [logisticsPartnerId], references: [id])
  rider            LogisticsTeamMember? @relation(fields: [riderId], references: [id], onDelete: SetNull)
  remittance       CodRemittance?       @relation(fields: [remittanceId], references: [id], onDelete: SetNull)
  review           LogisticsReview?
  trail            RiderLocationPoint[]

  @@index([sellerId])
  @@index([logisticsPartnerId])
  @@index([trackingCode])
  @@index([status])
  @@index([riderId])
  @@index([orderId])
  @@index([status, acceptBy])
}

// ─── Logistics marketplace ───────────────────────────────────────────────────
// Partners publish where they go, rate cards and pickup points; sellers and suppliers connect to partners; checkout
// prices delivery from the connected partners' cards and each paid order becomes a job (shared/delivery-market.ts,
// src/lib/delivery-market). docs/migrations/2026-11-14-logistics-marketplace.sql.

/// A partner's rate card. ownerUserId null: the public card (one active at a time; older ones are kept as retired).
/// Set: a private card for one seller or supplier, used for them only once they accept it.
model LogisticsRateCard {
  id                 String    @id @default(cuid())
  logisticsPartnerId String
  ownerUserId        String?
  /// public: active | retired · private: proposed | accepted | declined | withdrawn | retired
  status             String    @default("active")
  /// [{ id, from, to, service, sizeBand, price, minDays, maxDays }] (shared/delivery-market.ts RateRow)
  rows               Json      @default("[]")
  failedAttemptFee   Float     @default(0)
  returnFee          Float     @default(0)
  notes              String?
  respondedAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  logisticsPartner LogisticsPartner @relation(fields: [logisticsPartnerId], references: [id], onDelete: Cascade)
  owner            User?            @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)

  @@index([logisticsPartnerId, status])
  @@index([ownerUserId, status])
}

model LogisticsPickupPoint {
  id                 String   @id @default(cuid())
  logisticsPartnerId String
  name               String
  address            String
  state              String
  area               String?
  hours              String?
  phone              String?
  lat                Float?
  lng                Float?
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  logisticsPartner LogisticsPartner @relation(fields: [logisticsPartnerId], references: [id], onDelete: Cascade)

  @@index([logisticsPartnerId, active])
  @@index([state])
}

/// Where a seller sells (or a supplier ships from) and how delivery shows at checkout.
model DeliverySettings {
  userId             String   @id
  /// zones: the store's own delivery zones (as before) · partners: options from connected delivery partners.
  checkoutMode       String   @default("zones")
  /// one_state | selected | nationwide
  sellArea           String   @default("nationwide")
  sellStates         String[] @default([])
  /// Where parcels leave from (a supplier's "Where I ship from").
  originState        String?
  originArea         String?
  originAddress      String?
  selfPickup         Boolean  @default(false)
  pickupAddress      String?
  pickupHours        String?
  pickupInstructions String?
  /// When no connected partner covers an address: pickup_only | flat_fee.
  fallback           String   @default("pickup_only")
  fallbackFee        Float    @default(0)
  /// small | medium | bulky, for products without a size band or weight.
  defaultSizeBand    String   @default("small")
  /// Who pays a partner's re-attempt fee after a failed delivery: seller | customer.
  failedFeePayer     String   @default("seller")
  /// A supplier that delivers its own parcels ("I deliver myself"): offered at checkout for its dropship items.
  selfDelivery       Boolean  @default(false)
  selfDeliveryFee    Float    @default(0)
  /// States it drives to; empty means the state it ships from.
  selfDeliveryStates String[] @default([])
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// A seller's or supplier's delivery partner ("My delivery partners"). Connecting is instant on public rates.
model DeliveryConnection {
  id                 String    @id @default(cuid())
  ownerUserId        String
  /// seller | supplier
  ownerRole          String
  logisticsPartnerId String
  /// active | ended
  status             String    @default("active")
  /// owner | partner | admin
  endedBy            String?
  /// What customers can pick for this partner: doorstep | pickup_point
  services           String[]  @default(["doorstep", "pickup_point"])
  /// False: customers see `label` (e.g. "Standard delivery") instead of the partner's name.
  showPartnerName    Boolean   @default(true)
  label              String?
  /// Pay on delivery only when both sides opt in (and the shop accepted the disclaimer).
  ownerPod           Boolean   @default(false)
  partnerPod         Boolean   @default(false)
  podAcceptedAt      DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  endedAt            DateTime?

  owner            User             @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  logisticsPartner LogisticsPartner @relation(fields: [logisticsPartnerId], references: [id], onDelete: Cascade)

  @@unique([ownerUserId, logisticsPartnerId])
  @@index([logisticsPartnerId, status])
}

/// A customer's report about a delivery (late, not delivered, damaged, wrong item), seen by the shop, the partner
/// where relevant, and the team.
model DeliveryIssue {
  id                 String    @id @default(cuid())
  retailOrderId      String
  storeId            String
  bookingId          String?
  logisticsPartnerId String?
  /// late | not_delivered | damaged | wrong_item
  kind               String
  message            String?
  reporterName       String?
  /// open | resolved
  status             String    @default("open")
  resolvedAt         DateTime?
  createdAt          DateTime  @default(now())

  logisticsPartner LogisticsPartner? @relation(fields: [logisticsPartnerId], references: [id], onDelete: SetNull)

  @@index([storeId, status])
  @@index([logisticsPartnerId, createdAt])
  @@index([retailOrderId])
}

// ─── Shipping Zone ────────────────────────────────────────────────────────────

model ShippingZone {
  id        String      @id @default(cuid())
