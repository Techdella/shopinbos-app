{
  "framework": "nextjs",
  "regions": [
    "fra1"
  ],
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "outputDirectory": ".next",
  "crons": [
    {
      "path": "/api/cron/reviews",
      "schedule": "17 9 * * *"
    }
  ],
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- . ':(exclude)website' ':(exclude).github/workflows/website.yml' ':(exclude).github/workflows/website-deploy.yml'"
}
