// ─── Automation Rule ───────────────────────────────────────────────────────────

enum AutomationTrigger {
  welcome_email
  order_placed
  order_shipped
  order_delivered
  payment_received
  abandoned_checkout
  new_customer
  post_purchase
  review_request
  win_back
  birthday
  low_stock
  browse_abandonment // marketing: known visitor saved/viewed products and didn't buy
}

enum AutomationActionType {
  send_email
  send_notification
  update_discount
  add_tag
  add_segment
}

model AutomationRule {
  id          String               @id @default(cuid())
  storeId     String
  name        String
  description String               @default("")
  trigger     AutomationTrigger
  actionType  AutomationActionType @default(send_email)
  actionConfig Json                 @default("{}") // { templateId, subject, body, channel }
  delayMinutes Int                 @default(0)     // delay before triggering
  active      Boolean              @default(true)
  lastTriggeredAt DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  store Store @relation(fields: [storeId], references: [id])

  @@index([storeId])
  @@index([trigger])
}

// ─── Broadcast Campaign ────────────────────────────────────────────────────────

enum CampaignStatus {
  draft
  scheduled
  sending
  sent
  cancelled
}

model BroadcastCampaign {
  id              String         @id @default(cuid())
  storeId         String
  name            String
  subject         String
  preheader       String?
  bodyHtml        String         @default("")
  templateId      String?        // FK to EmailTemplate
  senderName      String?
  senderEmail     String?
  replyTo         String?
  channel         String         @default("email") // marketing: email | sms | whatsapp (recipient address goes in CampaignRecipient.email)
  channelConfig   Json           @default("{}") // marketing-channels: SMS { senderId } | WhatsApp { templateId, variables[], headerImageUrl, productId }
  campaignType    String         @default("newsletter") // newsletter | promotion | product_launch | sale | announcement | abandoned_cart | welcome | custom
  recipientFilter Json           @default("[]") // JSON array of filters
  segmentId       String?        // FK to CustomerSegment
  status          CampaignStatus @default(draft)
  sentCount       Int            @default(0)
  deliveredCount  Int            @default(0)
  openCount       Int            @default(0)
  clickCount      Int            @default(0)
  unsubscribeCount Int           @default(0)
  bounceCount     Int            @default(0)
  revenueGenerated Float         @default(0)
  conversionCount Int            @default(0)
  scheduledAt     DateTime?
  sentAt          DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  store      Store               @relation(fields: [storeId], references: [id])
  recipients CampaignRecipient[]

  @@index([storeId])
  @@index([status])
}

// ─── Retail Order ─────────────────────────────────────────────────────────────

model RetailOrder {
  id              String            @id @default(cuid())
  storeId         String
  orderNumber     String            @unique
  buyerEmail      String
  buyerName       String
  buyerPhone      String?
  deliveryAddress Json              @default("{}")
  items           Json              @default("[]")
  subtotal        Float             @default(0)
  shippingFee     Float             @default(0)
  total           Float             @default(0)
  currency        String            @default("NGN")
  status          RetailOrderStatus @default(pending)
  paystackRef     String?
  paystackStatus  String?           @default("pending")
  notes           String?
  discountCode    String?
  discountAmount  Float?            @default(0)
  trackingCode    String?
  logisticsDetails Json?
  campaignToken   String? // CampaignRecipient.token of the email that brought the buyer; credited once paid
  channel         String? // whatsapp | instagram | facebook | tiktok | email | online_store | in_person (shared/channels.ts)
  paymentMethod   String? // paystack | cash | transfer | pos | pay_on_delivery (null = paystack checkout)
  affiliateId     String?
  affiliateCommission Float? // naira owed to the affiliate once the order is delivered
  affiliatePaidAt DateTime?
  adCampaignId    String?
  shippedAt       DateTime?
  deliveredAt     DateTime?
  // Stock checkout took while the order waits for payment: [{ source: "store" | "supplier", productId, supplierProductId?, quantity, name }].
  // Unpaid card/transfer orders give it back when they expire (src/lib/commerce/order-expiry.server.ts).
  stockHold       Json?
  stockReleasedAt DateTime?
  expiredAt       DateTime? // cancelled because it stayed unpaid too long
  paymentIssue    String?   // e.g. paid after it expired and the stock was gone: refund the buyer
  // When an unpaid card/transfer order expires: set at checkout from the method's window (card 30 min, bank transfer
  // 24 h or the seller's choice). Null on older orders: their window is worked out from createdAt.
  paymentDueAt       DateTime?
  discountReleasedAt DateTime? // the discount/coupon use this order took was given back (expired or cancelled unpaid)
  // Automatic refund of a payment that arrived after the order expired and its stock sold (src/lib/commerce/refunds.ts).
  refundStatus       String? // pending (claimed) | processing | processed | failed | manual
  refundId           String? // Paystack refund id
  refundedAt         DateTime?
  // Orders sent in more than one parcel (some lines from suppliers, maybe some from the seller's own stock):
  // the seller's own part, and when the first parcel left (the customer is told "part of your order is on its
  // way" once). The order's status is worked out from its parts (src/lib/supplier-orders/parts.server.ts).
  ownShippedAt       DateTime?
  ownDeliveredAt     DateTime?
  partlySentAt       DateTime?
  // The payment link (src/lib/payment-links) this order was paid through, if any.
  paymentLinkId      String?
  // How Paystack splits this order's payment, set at checkout (src/lib/wallet/split.ts): each business's share goes
  // straight to its own bank through its Paystack subaccount; Shopinbos receives nothing. Null: no split (older
  // orders, offline payments).
  paymentSplit       Json?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  store          Store           @relation(fields: [storeId], references: [id])
  affiliate      Affiliate?      @relation(fields: [affiliateId], references: [id], onDelete: SetNull)
  adCampaign     AdCampaign?     @relation(fields: [adCampaignId], references: [id], onDelete: SetNull)
  supplierOrders SupplierOrder[]

  @@index([storeId])
  @@index([buyerEmail])
  @@index([status])
  @@index([status, createdAt])
  @@index([paystackRef])
  @@index([affiliateId])
  @@index([adCampaignId])
  @@index([refundId])
  @@index([paymentLinkId])
}

model AbandonedCartEvent {
  id        String   @id @default(cuid())
  storeId   String
  visitorId String?
  email     String?
  name      String?
  items     Json     @default("[]")
  subtotal  Float    @default(0)
  currency  String   @default("NGN")
  status    String   @default("triggered")
  createdAt DateTime @default(now())
  phone          String? // commerce: captured at checkout when no email yet
  recoveryToken  String?   @unique // commerce: /s/[slug]/cart?recover=<token> restores the cart
  checkoutStep   String? // commerce: furthest checkout step reached (contact | delivery | payment | review)
  discountCode   String? // commerce: code the shopper applied, if any
  remindersSent  Int       @default(0) // marketing: reminders sent for this cart
  lastReminderAt DateTime? // marketing: when the last reminder went out
  restoredAt     DateTime? // commerce: recovery link opened
  recoveredAt    DateTime? // commerce: order placed from this cart
  orderId        String? // commerce: RetailOrder.id that recovered it
  updatedAt      DateTime  @default(now()) @updatedAt // commerce: last cart change

  store   Store @relation(fields: [storeId], references: [id])
  visitor StoreVisitor? @relation(fields: [visitorId], references: [id])

  @@index([storeId, createdAt])
  @@index([email])
  @@index([storeId, recoveredAt])
}

// ─── Product Reviews ──────────────────────────────────────────────────────────

enum ReviewStatus {
  approved
  pending
  rejected
}

model ProductReview {
  id            String       @id @default(cuid())
  storeId       String
  productId     String
  orderId       String
  buyerName     String
  buyerEmail    String
  rating        Int          // 1–5
  title         String       @default("")
  body          String       @default("")
  images        String[]     @default([])
  status        ReviewStatus @default(pending)
  sellerReply   String?      @default("")
  repliedAt     DateTime?
  featured      Boolean      @default(false) // shown first on the reviews wall and widget (agent F)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  store   Store       @relation(fields: [storeId], references: [id])
  product StoreProduct @relation(fields: [productId], references: [id])

  @@index([storeId])
  @@index([productId])
  @@index([status])
}

// ─── Stock Movement ───────────────────────────────────────────────────────────

model StockMovement {
  id        String   @id @default(cuid())
  storeId   String
  productId String
  change    Int
  type      String   @default("addition") // addition | removal | adjustment | return | damaged
  note      String   @default("")
  createdAt DateTime @default(now())

  product StoreProduct @relation(fields: [productId], references: [id])

  @@index([storeId])
  @@index([productId])
}


// ─── Domain Partners (registrar affiliate links, admin-managed) ───────────────

model DomainPartner {
  id           String   @id @default(cuid())
  name         String
  logoUrl      String?
  baseUrl      String
  affiliateUrl String?
  description  String   @default("")
  featured     Boolean  @default(false)
  sortOrder    Int      @default(0)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// One row per redeemed payment, so a Paystack reference can't unlock a plan twice.
model PaymentReceipt {
  reference String   @id
  userId    String
  purpose   String // seller_growth | seller_pro | supplier_max
  amount    Float
  provider  String   @default("paystack")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

// One row per email a broadcast campaign sends. The token identifies the recipient in tracking links.
model CampaignRecipient {
  id          String    @id @default(cuid())
  campaignId  String
  storeId     String
  email       String
  name        String?
  token       String    @unique
  status      String    @default("queued") // queued | sent | delivered | read | failed
  error       String?
  externalId  String? // marketing-channels: provider message id (WhatsApp wamid, SMS id) for delivery receipts
  sentAt      DateTime?
  deliveredAt DateTime? // marketing-channels
  readAt      DateTime? // marketing-channels: WhatsApp blue ticks
  openedAt    DateTime?
  clickedAt   DateTime?
  convertedAt DateTime?
  orderId     String?
  revenue     Float     @default(0)
  createdAt   DateTime  @default(now())

  campaign BroadcastCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, email])
  @@index([storeId])
  @@index([campaignId, status])
  @@index([externalId])
}

// ─── Affiliates (creators earn a share of delivered orders from their link) ───

model Affiliate {
  id             String   @id @default(cuid())
  storeId        String
  name           String
  phone          String?
  email          String?
  code           String // ?aff=<code> on any store link
  commissionRate Float    @default(10) // percent of the order's item total after discounts
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  store  Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orders RetailOrder[]

  @@unique([storeId, code])
  @@index([storeId])
}

// ─── Ads (Peggy writes the ad; the seller runs it; we track clicks and orders) ─

model AdCampaign {
  id             String    @id @default(cuid())
  storeId        String
  storeProductId String?
  code           String    @unique // /r/ad/<code> tracking link
  platform       String // instagram | facebook | tiktok | whatsapp_status
  destination    String    @default("whatsapp") // whatsapp | store
  headline       String
  primaryText    String
  imageUrl       String?
  dailyBudget    Float     @default(0)
  days           Int       @default(5)
  spend          Float     @default(0) // logged by the seller
  clicks         Int       @default(0)
  status         String    @default("draft") // draft | running | paused | ended
  startedAt      DateTime?
  pausedAt       DateTime?
  // Campaigns (/home/ads/new; docs/migrations/2026-10-31-video-projects-ad-campaigns.sql). Older ads are one
  // product run by hand ("manual"); campaigns can have several products and run through the Meta Marketing API
  // ("meta") or be set up by the Shopinbos team ("managed", AdServiceRequest).
  name           String?
  mode           String    @default("manual") // manual | meta | managed
  objective      String? // traffic | whatsapp | awareness
  productIds     String[]  @default([])
  audience       Json? // shared/ad-campaigns.ts AdAudience
  creatives      Json? // shared/ad-campaigns.ts AdCreative[]
  currency       String    @default("NGN")
  startAt        DateTime?
  endAt          DateTime?
  external       Json? // Meta ids: { campaignId, adSetId, adIds[] }
  impressions    Int       @default(0)
  reach          Int       @default(0)
  lastSyncAt     DateTime?
  syncError      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  store  Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orders RetailOrder[]

  @@index([storeId])
}

// "Get help with ads": the Shopinbos team sets up a TikTok or Meta campaign for the seller after they share their
// details and pay the setup fee (Paystack). Admin works them at /admin/ad-requests.
model AdServiceRequest {
  id           String    @id @default(cuid())
  storeId      String
  userId       String
  campaignId   String?
  platform     String // meta | tiktok
  contactName  String
  contactPhone String
  contactEmail String?
  businessName String
  handle       String? // TikTok / Instagram handle
  pageUrl      String? // Facebook page, TikTok profile or shop link
  website      String?
  adAccountId  String? // the seller's ad account, when they have one
  dailyBudget  Float     @default(0)
  days         Int       @default(7)
  goals        String?
  audience     String?
  notes        String?
  setupFee     Int // naira
  paymentRef   String?   @unique
  paidAt       DateTime?
  status       String    @default("awaiting_payment") // awaiting_payment | new | in_progress | live | done | cancelled
  adminNotes   String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([storeId, createdAt])
  @@index([status, createdAt])
}

// Labels and print (/home/labels): designs the seller (or Rex) made and saved. kind packaging = the packaging
// designer (data is a PackDesign, shared/packaging.ts); label = a Print studio setup (data.href reopens it).
model PrintDesign {
  id         String   @id @default(cuid())
  storeId    String
  userId     String
  kind       String // packaging | label
  format     String? // pouch | box | … for packaging; tag | price | qr | package | thanks for labels
  title      String
  productId  String?
  data       Json
  previewUrl String?
  source     String   @default("studio") // studio | rex
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([storeId, updatedAt])
}

// Prints a seller ordered of a packaging design (/home/labels/order): the design is frozen into the order so later
// edits don't change what gets printed. Paid with Paystack (reference "printorder-…"); worked at /admin/print-orders.
model PrintOrder {
  id           String    @id @default(cuid())
  storeId      String
  userId       String
  designId     String?
  title        String
  format       String
  design       Json // the PackDesign as ordered
  previewUrl   String?
  quantity     Int
  material     String
  finish       String
  unitPrice    Int // naira
  setupFee     Int
  deliveryFee  Int
  total        Int
  days         Int // estimated working days to delivery
  zone         String
  contactName  String
  contactPhone String
  contactEmail String?
  address      String?
  city         String?
  state        String?
  notes        String?
  paymentRef   String?   @unique
  paidAt       DateTime?
  status       String    @default("awaiting_payment") // awaiting_payment | paid | printing | shipped | delivered | cancelled
  tracking     String?
  adminNotes   String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([storeId, createdAt])
  @@index([status, createdAt])
}

// "Make my packaging for me": a seller's request for custom packaging or branding, worked by the Shopinbos team
// (and later branding partners) at /admin/packaging-requests.
model PackagingRequest {
  id            String    @id @default(cuid())
  storeId       String
  userId        String
  designId      String? // a PrintDesign to start from
  productName   String
  productType   String
  packType      String // a PackFormat, or "other"
  quantity      Int
  size          String?
  budget        Int? // naira
  deadline      DateTime?
  services      String[]  @default([]) // design | print | brand_identity | photography | barcode_registration
  details       String
  referenceUrls String[]  @default([])
  contactName   String
  contactPhone  String
  contactEmail  String?
  status        String    @default("new") // new | quoted | in_progress | done | cancelled
  adminNotes    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([storeId, createdAt])
  @@index([status, createdAt])
}

// ─── AI usage (daily limits for Rex and Peggy; aiCredits stays the plan tier) ─

model AiUsage {
  id        String   @id @default(cuid())
  userId    String
  kind      String // text | image | voice | build
  units     Int      @default(1)
  createdAt DateTime @default(now())

  @@index([userId, kind, createdAt])
}

// Bought AI credits: spent when a daily plan allowance runs out (src/lib/ai/credits.server.ts). With autoTopUp the
// card saved from a credit purchase is charged for autoPackId again when the balance can't cover a request.
model AiCreditAccount {
  userId        String   @id
  // Bought, bonus and refunded credits (the sum of the live AiCreditLot rows; each lot lasts 12 months).
  balance       Int      @default(0)
  // The plan's monthly credits: refilled (not added to) at the start of each month, never carried over.
  planCredits   Int      @default(0)
  planPeriod    String? // "2026-10": the month planCredits were last filled for
  planKey       String? // the plan they were filled for (an upgrade mid-month tops them up)
  autoTopUp     Boolean  @default(false)
  autoPackId    String?
  // Reusable Paystack card from a credit purchase the seller allowed to save (shape: domains/billing-pure).
  authorization Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// Bought, bonus and refunded AI credits, each lasting 12 months. Spending takes the soonest to expire first; the
// account's balance is the sum of the remaining credits of lots that haven't expired.
model AiCreditLot {
  id        String   @id @default(cuid())
  userId    String
  credits   Int // remaining
  source    String // purchase | welcome | refund | legacy | grant
  reference String? // the purchase reference, for purchases
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId, expiresAt])
}

// ─── Plan add-ons, boosts and team (October 2026 pricing, shared/plans.ts) ──────────────────────────────────────
// docs/migrations/2026-11-16-plan-extras.sql

// Add-ons and boosts bought through Paystack, credited once by reference (src/lib/plans/extras.server.ts). Staff
// seats and boosts run from startsAt to endsAt; message packs add to MessageBalance. `included` rows are a plan's
// own featured weeks (no payment).
model PlanExtraPurchase {
  reference  String    @id
  userId     String
  kind       String // staff_seat | sms_pack | whatsapp_pack | supplier_boost | logistics_boost | product_boost
  quantity   Int       @default(1) // seats or packs; weeks for boosts
  targetId   String? // product_boost: SupplierProduct.id; logistics_boost: the state
  amountKobo Int
  status     String    @default("pending") // pending | paid | failed
  included   Boolean   @default(false)
  startsAt   DateTime?
  endsAt     DateTime?
  error      String?
  createdAt  DateTime  @default(now())
  paidAt     DateTime?

  @@index([userId, kind, status])
  @@index([kind, status, endsAt])
}

// Messages Shopinbos sends for a seller through its own SMS/WhatsApp providers (src/lib/plans/messages.server.ts):
// the plan's monthly messages used this month (`period` YYYY-MM, SMS and WhatsApp together), then pack messages.
model MessageBalance {
  userId    String   @id
  sms       Int      @default(0)
  whatsapp  Int      @default(0)
  period    String?
  used      Int      @default(0)
  updatedAt DateTime @updatedAt
}

// People a seller lets into their store (Settings › Team). They sign in with their own account and work in the
// owner's store; money settings, billing and the team stay with the owner (src/lib/staff/staff.server.ts).
model StoreStaff {
  id           String    @id @default(cuid())
  storeId      String
  ownerId      String
  email        String
  name         String
  memberUserId String?
  status       String    @default("invited") // invited | active | removed
  token        String    @unique
  invitedAt    DateTime  @default(now())
  acceptedAt   DateTime?
  updatedAt    DateTime  @updatedAt

  @@unique([storeId, email])
  @@index([memberUserId, status])
  @@index([ownerId])
}

// Sellers following a supplier; suppliers on Pro can send them updates (SupplierBroadcast).
model SupplierFollow {
  supplierId String
  userId     String
  createdAt  DateTime @default(now())

  @@id([supplierId, userId])
  @@index([userId])
}

model SupplierBroadcast {
  id         String   @id @default(cuid())
  supplierId String
  title      String
  body       String
  recipients Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([supplierId, createdAt])
}

// One row per credit pack checkout or automatic top-up; a reference is credited once (status pending → paid).
model AiCreditPurchase {
  reference  String    @id
  userId     String
  packId     String
  credits    Int
  amountKobo Int
  status     String    @default("pending") // pending | paid | failed
  auto       Boolean   @default(false)
  saveCard   Boolean   @default(false)
  error      String?
  createdAt  DateTime  @default(now())
  paidAt     DateTime?

  @@index([userId, createdAt])
}

// A single premium or platinum theme bought outright instead of upgrading the plan (src/lib/themes/purchase.server.ts).
// A reference is paid once (status pending → paid); a paid row lets the seller use that theme on any plan.
model ThemePurchase {
  reference  String    @id
  userId     String
  themeId    String
  tier       String // premium | platinum
  amountKobo Int
  status     String    @default("pending") // pending | paid | failed
  error      String?
  createdAt  DateTime  @default(now())
  paidAt     DateTime?

  @@index([userId, status])
}

// Saved Rex Studio and Peggy conversations, so a seller can pick one up again (src/lib/ai/chats.server.ts).
// Video studio projects (/home/video): every reel the seller starts, as a draft (the studio's settings, saved as
// they work), then saved (the recorded video in storage) and published (on a product page, in an ad, or posted).
model VideoProject {
  id          String   @id @default(cuid())
  storeId     String
  userId      String
  title       String
  purpose     String // ad | product | social
  status      String   @default("draft") // draft | saved | published
  productId   String?
  config      Json
  videoUrl    String?
  posterUrl   String?
  seconds     Float?
  publishedTo Json? // [{ kind: "product" | "ad" | "social", id?, at }]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([storeId, status, updatedAt])
}

model AiChat {
  id        String   @id @default(cuid())
  userId    String
  assistant String // rex | peggy
  title     String
  messages  Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, assistant, updatedAt])
}

// ─── One-minute help videos (Help → "Watch a 1-minute video"; topics in shared/help-videos.ts) ─────

model HelpVideo {
  id              String   @id @default(cuid())
  topic           String // add_product | record_sale | get_paid | … (HELP_TOPICS)
  title           String
  roles           String[] @default([]) // seller | supplier | logistics_partner | rider
  language        String   @default("en") // en | pcm | yo | ha | ig
  videoUrl        String? // our media bucket (platform/help-videos/…) or a YouTube/Vimeo link
  posterUrl       String?
  durationSeconds Int?
  published       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([topic, language])
  @@index([published, topic])
}

// ─── Delivery partners: cash-on-delivery pay-ins, API keys and webhooks ──────

model CodRemittance {
  id                 String   @id @default(cuid())
  logisticsPartnerId String
  amount             Float
  method             String   @default("transfer") // transfer | cash | api
  reference          String?
  note               String?
  /// What this pay-in settled (jobs ticked off), the partner's credit after it, and exact | over | under.
  covered            Float?
  creditAfter        Float?
  outcome            String?
  createdAt          DateTime @default(now())

  logisticsPartner LogisticsPartner  @relation(fields: [logisticsPartnerId], references: [id], onDelete: Cascade)
  bookings         DeliveryBooking[]
  payIn            PartnerPayIn?

  @@index([logisticsPartnerId, createdAt])
}

/// A delivery partner's own pay-in bank account (Paystack Dedicated Virtual Account). Money sent to it is
/// matched to the partner automatically (charge.success, channel dedicated_nuban).
/// Pay-in deadline history per partner: reminders, late flags, escalations, strikes, clears and the team's
/// actions. dedupeKey is unique, so the cron (every 15 minutes) never sends the same message twice.
model PartnerPayInEvent {
  id                 String   @id @default(cuid())
  logisticsPartnerId String
  /// reminder | overdue | escalated | review | strike | cleared | settled | unpaused | recheck
  kind               String
  dedupeKey          String   @unique
  amount             Float?
  /// The deadline this is about (6pm Lagos).
  deadline           DateTime?
  note               String?
  adminUserId        String?
  createdAt          DateTime @default(now())

  logisticsPartner LogisticsPartner @relation(fields: [logisticsPartnerId], references: [id], onDelete: Cascade)

  @@index([logisticsPartnerId, createdAt])
  @@index([kind, createdAt])
}

model PartnerPayInAccount {
  id                 String   @id @default(cuid())
  logisticsPartnerId String   @unique
  provider           String   @default("paystack")
  customerCode       String?
  customerId         String?
  providerAccountId  String?
  accountNumber      String?  @unique
  accountName        String?
  bankName           String?
  bankSlug           String?
  /// pending | assigned | failed | unavailable (DVA not switched on for the business)
  status             String   @default("pending")
  lastError          String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  logisticsPartner LogisticsPartner @relation(fields: [logisticsPartnerId], references: [id], onDelete: Cascade)

  @@index([customerCode])
}

/// Every transfer into a pay-in account, once per Paystack reference (replays are ignored). Matched ones point
/// at the CodRemittance they created; unmatched ones wait for the team to assign them.
model PartnerPayIn {
  id                 String    @id @default(cuid())
  provider           String    @default("paystack")
  reference          String    @unique
  amount             Float
  currency           String    @default("NGN")
  accountNumber      String?
  customerCode       String?
  senderName         String?
  senderBank         String?
  paidAt             DateTime  @default(now())
  /// matched | unmatched
  status             String    @default("unmatched")
  matchedBy          String?   // auto | admin
  matchedByUserId    String?
  matchedAt          DateTime?
  logisticsPartnerId String?
  remittanceId       String?   @unique
  raw                Json      @default("{}")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  logisticsPartner LogisticsPartner? @relation(fields: [logisticsPartnerId], references: [id], onDelete: SetNull)
  remittance       CodRemittance?    @relation(fields: [remittanceId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([logisticsPartnerId, createdAt])
}

/// A short location trail for a rider's current job (live tracking). Deleted 7 days after delivery.
model RiderLocationPoint {
  id        String   @id @default(cuid())
  riderId   String
  bookingId String
  lat       Float
  lng       Float
  accuracy  Float?
  at        DateTime

  rider   LogisticsTeamMember @relation(fields: [riderId], references: [id], onDelete: Cascade)
  booking DeliveryBooking     @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId, at])
  @@index([at])
}

/// Addresses already looked up (Google or OpenStreetMap), so each address is geocoded once.
model GeocodeCache {
  key       String   @id
  query     String
  lat       Float?
  lng       Float?
  source    String
  label     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PartnerApiKey {
  id                 String    @id @default(cuid())
  logisticsPartnerId String
  name               String
  prefix             String // first characters, shown in the dashboard
  keyHash            String    @unique // SHA-256 of the full key; the key itself is shown once
  lastUsedAt         DateTime?
  revokedAt          DateTime?
  createdAt          DateTime  @default(now())

  logisticsPartner LogisticsPartner @relation(fields: [logisticsPartnerId], references: [id], onDelete: Cascade)

  @@index([logisticsPartnerId])
}

model PartnerWebhook {
  id                 String    @id @default(cuid())
  logisticsPartnerId String
  url                String
  secret             String // HMAC-SHA256 signing secret
  events             String[]  @default([])
  active             Boolean   @default(true)
  lastStatus         Int?
  lastDeliveredAt    DateTime?
  createdAt          DateTime  @default(now())

  logisticsPartner LogisticsPartner         @relation(fields: [logisticsPartnerId], references: [id], onDelete: Cascade)
  deliveries       PartnerWebhookDelivery[]

  @@index([logisticsPartnerId])
}

/// Retry queue for partner webhooks (src/lib/logistics/webhooks.ts). One row per event per webhook, saved before the
/// first attempt. A delivery still failing after its in-request retries waits for /api/cron/partner-webhooks, which
/// tries again with a growing gap (WEBHOOK_QUEUE_DELAYS_MS) and gives up after the last one. The body (and so the
/// event id) never changes between attempts; only the signature's timestamp does.
model PartnerWebhookDelivery {
  id            String    @id @default(cuid())
  webhookId     String
  event         String
  body          String
  /// Delivery rounds done: the in-request round (first try plus quick retries) counts as 1, each queue retry as 1 more.
  attempts      Int       @default(0)
  lastStatus    Int?
  /// When the queue should try next. Null once delivered or given up.
  nextAttemptAt DateTime?
  deliveredAt   DateTime?
  /// Given up: still failing after the last queue retry, or the webhook was switched off.
  failedAt      DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  webhook PartnerWebhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([nextAttemptAt])
  @@index([webhookId, createdAt])
}

// ---- inbox (agent E) ----
// All-in-one customer inbox: one conversation model for every channel (email, WhatsApp, SMS, Messenger,
// Instagram, Telegram, phone calls, live chat, contact forms). Seller ↔ supplier/partner chats stay in
// Conversation/Message and are shown alongside these.

model InboxChannel {
  id            String    @id @default(cuid())
  storeId       String
  channel       String // email | whatsapp | sms | messenger | instagram | telegram | voice
  status        String    @default("disconnected") // connected | error | disconnected
  externalId    String? // WhatsApp phone_number_id, Page id, IG account id, Telegram bot id, SMS/voice number or sender ID, inbound address
  displayName   String?
  credentials   String? // AES-256-GCM encrypted JSON (src/lib/inbox/crypto.ts); never sent to the browser
  webhookSecret String? // per-channel random secret (Meta verify token, Telegram secret token)
  settings      Json      @default("{}") // email: { provider: platform | resend_domain | gmail, address, fromName, domain, gmail } (src/lib/email-channel)
  lastError     String?
  connectedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([storeId, channel])
  @@index([channel, externalId])
  @@index([webhookSecret])
}

model InboxConversation {
  id                 String    @id @default(cuid())
  storeId            String
  channel            String // email | whatsapp | sms | messenger | instagram | telegram | voice | livechat | form
  externalThreadId   String // phone number, PSID/IGSID, Telegram chat id, email address, live-chat visitor key, form submission id
  subject            String?
  contactName        String?
  contactEmail       String?
  contactPhone       String?
  contactHandle      String?
  visitorId          String?
  status             String    @default("open") // open | snoozed | closed
  snoozedUntil       DateTime?
  assigneeEmail      String?
  tags               String[]  @default([])
  unreadCount        Int       @default(0)
  lastMessageAt      DateTime  @default(now())
  lastMessagePreview String?
  lastInboundAt      DateTime?
  autoRepliedAt      DateTime?
  visitorSeenAt      DateTime? // live chat: when the shopper's widget last polled
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  messages InboxMessage[]

  @@unique([storeId, channel, externalThreadId])
  @@index([storeId, status, lastMessageAt(sort: Desc)])
  @@index([storeId, contactEmail])
  @@index([storeId, contactPhone])
}

model InboxMessage {
  id             String   @id @default(cuid())
  conversationId String
  storeId        String
  direction      String // inbound | outbound | note
  kind           String   @default("text") // text | call | voicemail | form | auto_reply
  body           String
  bodyHtml       String?
  attachments    Json     @default("[]") // [{ url, name, contentType }]
  status         String   @default("received") // received | queued | sent | delivered | read | failed | logged
  error          String?
  externalId     String?
  authorName     String?
  meta           Json     @default("{}")
  createdAt      DateTime @default(now())

  conversation InboxConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([externalId])
}

model InboxCannedReply {
  id        String   @id @default(cuid())
  storeId   String
  title     String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([storeId])
}

model InboxSettings {
  id               String    @id @default(cuid())
  storeId          String    @unique
  autoReplyEnabled Boolean   @default(false)
  autoReplyMode    String    @default("message") // message | peggy
  awayMessage      String?
  forwardCallsTo   String? // seller's own phone for Africa's Talking Voice to ring (empty = voicemail)
  sellerLastSeenAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}
// Auto-reply rules (business hours, per-channel switches, keyword quick replies, instant "got it") and the
// storefront Peggy chatbot. JSON so the shapes can grow; read with defaults (src/lib/inbox/assistant.ts), and
// the app keeps working with the old away message before this table exists.
model InboxAutomation {
  id        String   @id @default(cuid())
  storeId   String   @unique
  autoReply Json     @default("{}")
  chatbot   Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
// ---- end inbox (agent E) ----

// ---- reviews (agent F) ----

// Reviews that didn't come through the store's own review form: Google Business Profile (API import or a
// pasted review), WhatsApp/Instagram/Facebook screenshots, and marketplace reviews the seller copied in.
// The customer's words are stored as received and never edited; sellers hide a review instead.
model ExternalReview {
  id             String    @id @default(cuid())
  storeId        String
  source         String // google | whatsapp | instagram | facebook | tiktok | x | jumia | konga | marketplace | other
  importMethod   String    @default("manual") // api | manual | screenshot
  externalId     String? // provider id (Google review name) for de-duplication
  sourceUrl      String?
  productId      String? // optional StoreProduct the review is about
  authorName     String
  authorPhotoUrl String?
  rating         Int? // 1-5; null when the source has no stars (a WhatsApp message)
  title          String    @default("")
  body           String    @default("")
  images         String[]  @default([])
  status         String    @default("approved") // approved | pending | rejected (hidden)
  featured       Boolean   @default(false)
  verifiedBuyer  Boolean   @default(false)
  orderId        String? // RetailOrder that proves the purchase, when the seller linked one
  reply          String?
  repliedAt      DateTime?
  replySyncedAt  DateTime? // when the reply was posted to the source (Google)
  replyError     String?
  reviewedAt     DateTime  @default(now()) // when the customer wrote it
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([storeId, source, externalId])
  @@index([storeId, createdAt])
  @@index([storeId, status])
}

// A request sent to a buyer to review their order. The link /s/[slug]/review/<signed token> lets them
// review every item without signing in.
model ReviewRequest {
  id           String    @id @default(cuid())
  storeId      String
  orderId      String
  customerName String
  email        String?
  phone        String?
  channel      String // email | sms | whatsapp | link
  trigger      String    @default("manual") // manual | auto | peggy | automation
  status       String    @default("pending") // pending | sent | failed | opened | completed
  error        String?
  sentAt       DateTime?
  openedAt     DateTime?
  completedAt  DateTime?
  createdAt    DateTime  @default(now())

  @@index([storeId, createdAt])
  @@index([orderId])
}

// OAuth connection to a review source (Google Business Profile). Tokens are encrypted when
// INTEGRATIONS_ENCRYPTION_KEY is set and are never sent to the browser.
model ReviewSourceConnection {
  id            String    @id @default(cuid())
  storeId       String
  provider      String // google_business
  accessToken   String?
  refreshToken  String?
  expiresAt     DateTime?
  accountName   String? // accounts/123
  locationName  String? // locations/456
  locationTitle String?
  status        String    @default("connected") // connected | needs_location | error
  lastSyncedAt  DateTime?
  lastError     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([storeId, provider])
}

model ReviewSettings {
  id               String   @id @default(cuid())
  storeId          String   @unique
  autoRequest      Boolean  @default(false) // ask buyers after delivery
  requestDelayDays Int      @default(3)
  requestChannel   String   @default("email") // email | sms | whatsapp
  autoApprove      Boolean  @default(false) // publish new store reviews without moderation
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}
// ---- end reviews (agent F) ----

// ---- analytics + social selling (agent G) ----
// Daily storefront counters (one row per store/day/metric/source/product). Written by the storefront
// beacons in src/lib/analytics/storefront-events.ts; read by /home/analytics and /channels.
model StoreMetricDaily {
  id        String   @id @default(cuid())
  storeId   String
  day       String // YYYY-MM-DD, Africa/Lagos
  metric    String // visit | product_view | add_to_cart | checkout_start
  channel   String   @default("") // shared/channels.ts key from ?ref / utm_source; "" = not tagged
  campaign  String   @default("") // utm_campaign, lowercased; "" = none
  productId String   @default("")
  count     Int      @default(0)
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([storeId, day, metric, channel, campaign, productId])
  @@index([storeId, day])
}

// Store traffic per Lagos day for /home/analytics/traffic (src/lib/analytics/traffic.ts): page views by path,
// sessions by source / referrer host / device / country / city / utm, shop searches, engaged seconds. Counts only:
// no IP, user agent, visitor id or full URL is ever stored.
model StoreTrafficDaily {
  id        String   @id @default(cuid())
  storeId   String
  day       String // YYYY-MM-DD, Africa/Lagos
  metric    String // session | entry | page_view | visitor | new_visitor | engaged_seconds | engaged_view | search
  dim       String   @default("") // "" (the total) | path | source | referrer | device | country | city | medium | campaign | term
  value     String   @default("")
  count     Int      @default(0)
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([storeId, day, metric, dim, value])
  @@index([storeId, day])
}

// Unique visitors per store per Lagos day as a HyperLogLog sketch (src/lib/analytics/hll.ts): only the register
// bytes, never a visitor token or hash. Days merge register by register for true unique visitors over a range.
model StoreVisitorSketch {
  id        String   @id @default(cuid())
  storeId   String
  day       String // YYYY-MM-DD, Africa/Lagos
  sketch    Bytes
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([storeId, day])
}

// "Connect with Google" for Search Console performance on /home/analytics/traffic (src/lib/search-console).
// Tokens are encrypted at rest (src/lib/reviews/secrets.ts) and never sent to the browser.
model SearchConsoleConnection {
  id           String    @id @default(cuid())
  storeId      String    @unique
  accessToken  String?
  refreshToken String?
  expiresAt    DateTime?
  siteUrl      String? // the chosen property: "https://shop.example.com/" or "sc-domain:example.com"
  status       String    @default("needs_site") // needs_site | connected
  lastError    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt
}

// A store's product catalog on a selling channel (Google Merchant Center, Meta/Instagram/Facebook, TikTok, WhatsApp).
// Feeds work without any of this; a row records API credentials (token encrypted at rest) and sync/fetch history.
model SocialChannelConnection {
  id              String    @id @default(cuid())
  storeId         String
  channel         String // google | meta | tiktok | whatsapp
  externalId      String? // the catalog: Meta catalog ID, TikTok catalog ID (Google: the Merchant Center account ID)
  tokenEnc        String? // encrypted access token (src/lib/social/secrets.ts); never sent to the browser
  feedAddedAt     DateTime? // seller said they pasted the feed URL into the channel
  lastFetchAt     DateTime? // the channel's crawler last downloaded the feed
  lastFetchAgent  String?
  lastSyncAt      DateTime?
  lastSyncStatus  String? // ok | error
  lastSyncMessage String?
  // One-tap connect on /channels (src/lib/sales-channels; docs/migrations/2026-10-22-sales-channels.sql).
  // tokenEnc then holds encrypted JSON { token, refreshToken? }; null status with a token = an older pasted-token link.
  status          String? // syncing | connected | error | reauth | needs_account
  accountId       String? // Meta business ID, Google Merchant Center account ID, TikTok Business Center ID
  feedId          String? // the scheduled feed we registered there (Meta product feed, Google data source, TikTok feed)
  tokenExpiresAt  DateTime? // null = doesn't expire (or unknown)
  productCount    Int? // products the platform reports it has
  connectedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([storeId, channel])
  @@index([storeId])
  @@index([status, lastSyncAt])
}

/// "Tell me when it's ready" on a coming-soon sales channel (Amazon, Jumia, Konga…), one row per store and platform.
model SalesChannelInterest {
  id        String   @id @default(cuid())
  storeId   String
  platform  String // amazon | jumia | konga | jiji | ebay | etsy | shopify | pinterest | snapchat
  userId    String?
  createdAt DateTime @default(now())

  @@unique([storeId, platform])
  @@index([platform])
}
// ---- end analytics + social selling (agent G) ----

// ---- marketing (agent A) ----
// Automation flows live on AutomationRule (steps in actionConfig.steps). Each contact that enters a flow gets an
// AutomationEnrollment that walks the steps; /api/cron/marketing runs the due ones. Every step outcome is logged.

model AutomationEnrollment {
  id           String    @id @default(cuid())
  storeId      String
  automationId String // AutomationRule.id
  dedupeKey    String // e.g. cart:<AbandonedCartEvent.id>, order:<id>, winback:<email>:<lastOrderId>
  email        String?
  phone        String?
  name         String?
  context      Json      @default("{}") // variables for messages: order number, cart items, product names...
  status       String    @default("active") // active | completed | exited | failed
  currentStep  Int       @default(0)
  nextRunAt    DateTime?
  exitReason   String?
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([automationId, dedupeKey])
  @@index([storeId, createdAt])
  @@index([status, nextRunAt])
  @@index([automationId, status])
}

model AutomationLog {
  id           String   @id @default(cuid())
  storeId      String
  automationId String
  enrollmentId String?
  stepIndex    Int      @default(0)
  stepType     String // enrolled | wait | condition | send_email | send_sms | send_whatsapp | add_tag | give_discount | request_review | notify_seller | exit
  status       String // ok | skipped | failed | exited
  recipient    String?
  message      String   @default("")
  createdAt    DateTime @default(now())

  @@index([storeId, createdAt])
  @@index([automationId, createdAt])
}

// Daily view / submit counts per storefront form or pop-up.
model MarketingFormStat {
  id          String   @id @default(cuid())
  storeId     String
  formId      String
  day         DateTime @db.Date
  views       Int      @default(0)
  submissions Int      @default(0)

  @@unique([formId, day])
  @@index([storeId, day])
}
// ---- end marketing (agent A) ----

// ---- cms (agent H) ----
// Wix-style content collections: the seller defines a collection (Blog, Size guide, Recipe book, Course…) with
// its own fields, then writes items in it. Shown on the storefront at /s/[slug]/<collection>/<item>.
model CmsCollection {
  id          String    @id @default(cuid())
  storeId     String
  name        String
  slug        String // storefront path segment, unique per store
  template    String    @default("blank") // blog | size_guide | recipe | course | faq | lookbook | team | events | blank
  description String    @default("")
  itemLabel   String    @default("Item") // "Post", "Recipe", "Lesson"
  fields      Json      @default("[]") // [{ id, key, label, type, required, help, options, multiple }]
  settings    Json      @default("{}") // { layout: grid | list, sort: newest | oldest | manual | title }
  seo         Json      @default("{}") // list page SEO (same shape as page SEO)
  isPublished Boolean   @default(true)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  items       CmsItem[]

  @@unique([storeId, slug])
  @@index([storeId])
}

model CmsItem {
  id            String        @id @default(cuid())
  storeId       String
  collectionId  String
  title         String
  slug          String
  status        String        @default("draft") // draft | published | scheduled (live once publishAt has passed)
  publishAt     DateTime?
  publishedAt   DateTime?
  author        String        @default("")
  featuredImage String?
  excerpt       String        @default("")
  data          Json          @default("{}") // field key → value; rich text is { json, html } with html rebuilt on the server
  seo           Json          @default("{}")
  legacyId      String? // id of the post in the old StorePage "blog" JSON this item was copied from
  createdBy     String        @default("seller") // seller | peggy | rex | import
  sortOrder     Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  collection    CmsCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@unique([collectionId, slug])
  @@unique([collectionId, legacyId])
  @@index([storeId])
  @@index([collectionId, status])
}

// SEO for things whose own table has no room for it (products keep seoTitle/seoDescription on the row; the
// social card, canonical, noindex and focus phrase live here). resourceType: product | collection.
model SeoMeta {
  id           String   @id @default(cuid())
  storeId      String
  resourceType String
  resourceId   String
  data         Json     @default("{}")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([storeId, resourceType, resourceId])
  @@index([storeId])
}
// ---- end cms (agent H) ----

// ---- gamification (rewards) ----
// Spin-the-wheel, scratch-card and post-purchase plays, and loyalty points. Settings live in
// Store.brandSettings.gamification; prize codes are ordinary Discount rows (SPIN-/SCRATCH-/NEXT- codes).
// SQL: docs/migrations/2026-10-12-gamification.sql. Code falls back gracefully until it is applied.

// One play of a game. game: wheel | scratch | post_purchase. contactKey is the normalised email or phone.
model GamePlay {
  id          String   @id @default(cuid())
  storeId     String
  game        String
  contactKey  String
  email       String?
  phone       String?
  outcomeId   String
  outcomeKind String // percent | amount | free_delivery | free_gift | try_again
  outcomeLabel String
  discountId  String?
  code        String?
  orderId     String? // post-purchase: the order the spin was for
  consent     Json     @default("{}")
  createdAt   DateTime @default(now())

  @@index([storeId, game, createdAt(sort: Desc)])
  @@index([storeId, contactKey])
  @@index([storeId, orderId])
}

// A shopper's points with one store, keyed by email (phone kept for matching at checkout).
model LoyaltyAccount {
  id             String   @id @default(cuid())
  storeId        String
  email          String
  phone          String?
  balance        Int      @default(0)
  lifetimeEarned Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([storeId, email])
  @@index([storeId, phone])
}

// Every change to a balance. kind: earn | reverse (earned on an order later cancelled) | redeem | refund
// (points spent on an order later cancelled) | adjust. points is signed.
model LoyaltyLedger {
  id        String   @id @default(cuid())
  storeId   String
  accountId String
  kind      String
  points    Int
  orderId   String?
  note      String?
  createdAt DateTime @default(now())

  @@unique([accountId, orderId, kind])
  @@index([storeId, createdAt(sort: Desc)])
  @@index([storeId, orderId])
}
// ---- end gamification ----

// ---- support ----
// Live support: the signed-out "Stuck?" form, in-app chat with the team, and the admin support desk
// (/admin/support). docs/migrations/2026-10-12-support.sql. Plain ids (no relations) keep User untouched.

model SupportTicket {
  id                 String    @id @default(cuid())
  number             Int       @unique @default(autoincrement()) // shown as SB-1042; the sequence starts at 1001
  userId             String? // null for signed-out requests and new emails from unknown senders
  name               String
  email              String?
  phone              String?
  portal             String    @default("public") // public | seller | supplier | logistics_partner | admin
  topic              String    @default("other") // login | payments | store | orders | other
  subject            String
  status             String    @default("open") // open | pending | solved | closed
  priority           String    @default("normal") // low | normal | high | urgent
  source             String    @default("app") // app | web | email
  assigneeId         String?
  path               String? // the page they were on
  firstResponseDueAt DateTime?
  firstRespondedAt   DateTime?
  lastMessageAt      DateTime  @default(now())
  lastUserMessageAt  DateTime?
  lastAgentMessageAt DateTime?
  userReadAt         DateTime?
  agentReadAt        DateTime?
  solvedAt           DateTime?
  rating             Int? // 1-5 once solved
  ratingComment      String?
  ratedAt            DateTime?
  meta               Json      @default("{}") // { transcript?: Peggy chat before escalation, userAgent?, ip? }
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  messages SupportMessage[]

  @@index([status, lastMessageAt(sort: Desc)])
  @@index([userId, lastMessageAt(sort: Desc)])
  @@index([assigneeId, status])
  @@index([email])
  @@index([createdAt])
}

model SupportMessage {
  id          String   @id @default(cuid())
  ticketId    String
  authorType  String // user | agent | ai | system
  authorId    String?
  authorName  String?
  body        String
  internal    Boolean  @default(false) // agent-only note, never shown or emailed to the customer
  attachments Json     @default("[]") // [{ path, name, type, size }] under support/<ticketId>/ in storage
  channel     String   @default("app") // app | web | email
  externalId  String?  @unique // inbound email Message-ID, so a webhook retry can't add it twice
  // WhatsApp messages the team sent: what Meta reported (sent | delivered | read | failed) and why it failed.
  deliveryStatus String?
  deliveryError  String?
  createdAt   DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
}

// Canned replies for the desk. {{first_name}}, {{name}}, {{ticket}} and {{agent}} are filled in when used.
model SupportMacro {
  id          String   @id @default(cuid())
  title       String
  body        String
  topic       String?
  status      String? // status to set when used, e.g. solved
  usageCount  Int      @default(0)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
// ---- end support ----

// ---- auth security ----
// Sign-in, code, password, device and sign-out events (Settings > Security list, new-device emails, audit).
// No foreign key: failed attempts may not match an account. ipHash is SHA-256 of the IP, never the raw address.
// Written with raw SQL so the app keeps working before docs/migrations/2026-10-12-auth-security.sql is applied.
model AuthEvent {
  id         String   @id
  supabaseId String?
  type       String
  method     String?
  ipHash     String?
  userAgent  String?
  deviceId   String?
  detail     Json?
  createdAt  DateTime @default(now())

  @@index([supabaseId, createdAt(sort: Desc)])
  @@index([supabaseId, deviceId])
  @@index([type, createdAt(sort: Desc)])
}

// Rate-limit windows and failure lockouts for sign-in, codes and password resets.
// key is "<action>:<ip|id>:<sha256>", so no email, phone or IP is stored in clear.
model AuthThrottle {
  key         String    @id
  count       Int       @default(0)
  windowStart DateTime  @default(now())
  failures    Int       @default(0)
  lockedUntil DateTime?
  updatedAt   DateTime  @default(now())

  @@index([updatedAt])
}
// ---- end auth security ----

// ---- sign-in codes on WhatsApp (docs/migrations/2026-10-21-auth-code-channel.sql) ----
/// Per phone (hashed): the channel the send route wants for the next sign-in code, and the one the Supabase Send SMS
/// hook actually used (WhatsApp or the SMS fallback). Short-lived; src/lib/auth/otp-delivery.server.ts.
model AuthCodeChannel {
  key       String   @id
  wanted    String
  used      String?
  expiresAt DateTime

  @@index([expiresAt])
}
// ---- end sign-in codes on WhatsApp ----

// ---- shared rate limits (docs/migrations/2026-10-17-followups.sql) ----
/// One row per limiter key and fixed window: src/lib/rate-limit.ts counts requests here with an atomic upsert so
/// limits hold across serverless instances. Keys hash the IP/identifier. Expired rows are swept opportunistically.
model RateLimitBucket {
  key         String
  windowStart DateTime
  count       Int      @default(0)
  expiresAt   DateTime

  @@id([key, windowStart])
  @@index([expiresAt])
}
// ---- end shared rate limits ----

// ---- WhatsApp catalog (agent: whatsapp-catalog) ----
// A store's WhatsApp product catalog: the token-protected Meta feed URL, and the optional direct Graph API sync
// (catalog chosen or created, linked to the WhatsApp Business Account, cart and catalog switched on).
// docs/migrations/2026-10-15-whatsapp-catalog.sql; src/lib/whatsapp-catalog.

model WhatsAppCatalog {
  id                   String    @id @default(cuid())
  storeId              String    @unique
  feedToken            String // random, in the feed URL; rotating it breaks old copies of the URL
  feedTokenRotatedAt   DateTime?
  feedFetchedAt        DateTime? // Meta's crawler last downloaded the feed
  catalogId            String?
  catalogName          String?
  businessId           String?
  wabaId               String?
  wabaLinkedAt         DateTime?
  commerceSettingsAt   DateTime?
  cartEnabled          Boolean   @default(false)
  catalogVisible       Boolean   @default(false)
  permissionState      String    @default("unknown") // ok | missing | unknown
  missingPermissions   String[]  @default([])
  permissionsCheckedAt DateTime?
  dirty                Boolean   @default(false) // products changed since the last API sync
  dirtyAt              DateTime?
  syncStartedAt        DateTime? // a sync holds this while it runs (stale after 10 minutes)
  lastSyncAt           DateTime?
  lastSyncStatus       String? // ok | partial | error
  lastSyncError        String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([dirty])
}

/// The WhatsApp store: a customer's cart inside their WhatsApp chat with the store (src/lib/whatsapp-store).
/// One per conversation; emptied when Peggy sends the checkout link (the payment link keeps what was bought).
model WhatsAppCart {
  id             String    @id @default(cuid())
  storeId        String
  conversationId String    @unique
  /// The customer's WhatsApp number (E.164).
  phone          String
  /// [{ productId, variantId, quantity }]
  items          Json      @default("[]")
  /// The latest checkout link made from this cart.
  paymentLinkId  String?
  checkedOutAt   DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([storeId, updatedAt])
}

model WhatsAppCatalogItem {
  id        String    @id @default(cuid())
  storeId   String
  productId String // also the catalog retailer_id
  catalogId String
  status    String    @default("pending") // pending | synced | failed | skipped | deleted
  method    String? // CREATE | UPDATE | DELETE, last sent
  hash      String? // fingerprint of the data last sent
  remote    Boolean   @default(false) // Meta has (or had) this item
  handle    String? // items_batch handle still being checked
  error     String?
  syncedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([storeId, productId])
  @@index([storeId, status])
  @@index([handle])
}
// ---- end WhatsApp catalog ----

// ─── Marketing channels: WhatsApp templates, SMS/WhatsApp opt-outs, order messages ─────────────────────────
// docs/migrations/2026-10-15-marketing-channels.sql

/// A WhatsApp message template on the store's WhatsApp Business Account. Drafts live only here until
/// submitted to Meta (POST /{WABA_ID}/message_templates); status is synced from Meta.
model WhatsAppTemplate {
  id             String    @id @default(cuid())
  storeId        String
  name           String // Meta template name: lowercase letters, digits, underscores
  language       String    @default("en")
  category       String    @default("MARKETING") // MARKETING | UTILITY
  components     Json      @default("{}") // { header: { format: NONE|TEXT|IMAGE, text }, body, footer, buttons: [{ type: URL|QUICK_REPLY, text, url }] }
  variables      Json      @default("[]") // default mapping for {{1}}..{{n}}: ["first_name", "store_name", ...]
  status         String    @default("DRAFT") // DRAFT | PENDING | APPROVED | REJECTED | PAUSED | DISABLED | IN_APPEAL | LOCAL_ERROR
  rejectedReason String?
  metaId         String? // Meta's template id
  preset         String? // ready-made key: order_confirmation | order_shipped | order_delivered | abandoned_cart | back_in_stock | promo
  submittedAt    DateTime?
  syncedAt       DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([storeId, name, language])
  @@index([storeId, status])
}

/// A phone number that asked a store to stop texting it (SMS STOP, WhatsApp "Stop promotions"), or that the
/// seller removed. scope "marketing" stops campaigns and marketing flows; "all" also stops order messages.
model MarketingOptOut {
  id        String   @id @default(cuid())
  storeId   String
  phone     String // E.164, e.g. +2348012345678
  channel   String // sms | whatsapp
  scope     String   @default("all") // marketing | all
  source    String // sms_keyword | whatsapp_keyword | whatsapp_button | seller
  keyword   String?
  createdAt DateTime @default(now())

  @@unique([storeId, phone, channel])
  @@index([storeId, channel])
}

/// Per-store SMS/WhatsApp settings: sender ID, SMS price per segment, and which order messages go out.
model StoreMessagingSettings {
  id                String   @id @default(cuid())
  storeId           String   @unique
  smsSenderId       String?
  smsCostPerSegment Float? // in the store currency, for campaign cost estimates
  transactional     Json     @default("{}") // { order_confirmed: { whatsapp, sms, templateId, smsText }, payment_received, order_shipped, order_delivered, abandoned_cart }
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

/// One order or cart message sent to a store's customer by WhatsApp or SMS (deduped per event and channel).
model CustomerMessage {
  id          String    @id @default(cuid())
  storeId     String
  event       String // order_confirmed | payment_received | order_shipped | order_delivered | abandoned_cart
  refId       String // RetailOrder.id or AbandonedCartEvent.id
  channel     String // sms | whatsapp
  to          String
  status      String    @default("queued") // queued | sent | delivered | read | failed | skipped
  error       String?
  externalId  String?
  templateId  String?
  sentAt      DateTime?
  deliveredAt DateTime?
  createdAt   DateTime  @default(now())

  @@unique([storeId, event, refId, channel])
  @@index([storeId, createdAt])
  @@index([externalId])
}

// ─── Shopinbos's own emails: weekly summaries and product news ──────────────────
// docs/migrations/2026-10-16-weekly-summary-product-news.sql

// One row per user and week: claimed before the email goes out, so a re-run (or two overlapping runs) never sends
// the same week twice. Users with nothing to report and no quiet-week email due get a "skipped" row too, so each
// run carries on where the last one stopped.
model WeeklySummaryLog {
  id        String    @id @default(cuid())
  userId    String
  weekStart String // YYYY-MM-DD, the Monday (Africa/Lagos) the week starts
  role      String
  kind      String    @default("full") // full | quiet | none
  status    String    @default("claimed") // claimed | sent | failed (refused, retried up to 3 tries) | skipped | unknown (no answer from the provider, never retried)
  attempts  Int       @default(1)
  error     String?
  sentAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt

  @@unique([userId, weekStart])
  @@index([weekStart, status])
  @@index([userId, kind, status])
}

// A product news email an admin writes (/admin/product-news) and sends to sellers, suppliers and delivery partners.
model ProductNewsBroadcast {
  id             String    @id @default(cuid())
  subject        String
  preheader      String?
  heading        String
  body           String // simple markdown, escaped when rendered (src/lib/email/product-news.ts)
  imageUrl       String?
  ctaLabel       String?
  ctaUrl         String?
  audience       String[] // seller | supplier | logistics_partner
  status         String    @default("draft") // draft | scheduled | sending | sent | failed
  scheduledAt    DateTime?
  startedAt      DateTime?
  sentAt         DateTime?
  recipientCount Int       @default(0)
  sentCount      Int       @default(0)
  failedCount    Int       @default(0)
  skippedCount   Int       @default(0)
  lastError      String?
  createdById    String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now()) @updatedAt

  recipients ProductNewsRecipient[]

  @@index([status, scheduledAt])
}

// Who a broadcast goes to, one row each (unique per broadcast and user), so a retry never sends twice.
model ProductNewsRecipient {
  id          String    @id @default(cuid())
  broadcastId String
  userId      String
  email       String
  role        String
  status      String    @default("queued") // queued | sending | sent | failed | skipped
  error       String?
  sentAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  broadcast ProductNewsBroadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)

  @@unique([broadcastId, userId])
  @@index([broadcastId, status])
}

// ---- domain billing ----
// A domain a seller buys (or renews) through Shopinbos on the platform's Vercel registrar account. The seller pays
// through Paystack first; only a verified payment moves the row paid → buying (one caller) → bought, else the
// payment is refunded (src/lib/domains/billing.server.ts). The latest bought row per domain carries the expiry the
// renewal cron reminds about (/api/cron/domain-renewals). Migration: docs/migrations/2026-10-24-domain-billing.sql.
model DomainPurchase {
  id                    String    @id @default(cuid())
  storeId               String
  userId                String
  domain                String
  kind                  String // new | renewal
  years                 Int       @default(1)
  costUsd               Float // the registrar price we quoted from (Vercel, USD)
  amountNgn             Int // what the seller pays
  coveredByPlan         Boolean   @default(false) // free with an annual plan: no Paystack payment, nothing to refund
  reference             String    @unique // Paystack reference (domain-<uuid>)
  status                String    @default("pending_payment") // pending_payment | payment_failed | paid | buying | bought | failed | refunded | refund_failed | expired
  payerEmail            String? // the email Paystack charged (billingEmail, or the saved card's email)
  vercelOrderId         String?
  contactInformation    Json? // the registrant contact the registrar needs (renewals reuse it)
  paystackAuthorization Json? // the reusable card authorization from the paid charge, for renewal charges
  remindersSent         Json      @default("[]") // r30 | r7 | r1 | charge
  paidAt                DateTime?
  expiresAt             DateTime?
  error                 String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([storeId])
  @@index([status])
  @@index([expiresAt])
}
// ---- end domain billing ----

// ---- business name registration ----
// A business name registered with CAC through Shopinbos (src/lib/business-registration, CAC's VAS API). Paid first
// through Paystack; only a verified payment is filed with CAC. Files (passport, signature, ID) live in the private
// bucket (filePaths) and are removed once CAC approves. docs/migrations/2026-11-12-business-registration.sql.
model BusinessRegistration {
  id             String    @id @default(cuid())
  userId         String
  role           String // seller | supplier | logistics_partner
  proposedName   String
  lineOfBusiness String
  form           Json // shared/business-registration.ts RegistrationForm (no files)
  filePaths      Json      @default("{}") // { passport, signature, meansOfId, supportingDoc? } → private storage paths
  nameCheck      Json? // CAC's compliance answer for the name
  amountNgn      Int
  reference      String    @unique // Paystack reference (bizreg-<uuid>)
  status         String    @default("draft") // shared/business-registration.ts RegistrationStatus
  payerEmail     String?
  transactionRef String?   @unique // CAC's reference once filed (VAS…)
  rcNumber       String? // the BN number CAC gives on approval
  queries        Json      @default("[]") // CAC's latest queries: [{ field, comment, date }]
  paidAt         DateTime?
  submittedAt    DateTime?
  approvedAt     DateTime?
  checkedAt      DateTime? // last time CAC's status was read
  answeredAt     DateTime? // when the owner last answered CAC's queries (a status read older than this is stale)
  error          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([userId])
  @@index([status])
}
// ---- end business name registration ----

// ---- media library ----
// Every picture (or video) a person has in their library: things they uploaded, and the photos, logo, banners and
// editor images found in their store (docs/migrations/2026-10-26-media-library.sql backfills, and
// shopinbos_media_sync(userId) tops it up when the library opens). Removing one only hides it (hiddenAt): the file
// may still be on a live page. src/lib/media/library.server.ts, /api/app/media.
model MediaAsset {
  id        String    @id @default(cuid())
  userId    String
  storeId   String?
  url       String
  path      String? // storage path in the public bucket, when we stored it
  name      String? // original file name or the product's name, for search
  title     String? // the person's own name for it (Media page); shown instead of `name` when set
  alt       String? // alt text: what the picture shows, for screen readers and search engines
  kind      String    @default("image") // image | video
  width     Int?
  height    Int?
  bytes     Int?
  source    String    @default("upload") // upload | product | ai | logo | banner | editor | collection | cms
  hiddenAt  DateTime?
  createdAt DateTime  @default(now())

  @@unique([userId, url])
  @@index([userId, createdAt])
  @@index([storeId])
}
// ---- end media library ----

// ─── Seasonal campaigns (Marketing > Seasonal campaigns) ─────────────────────
// A scheduled bundle that changes the live store for a while (Black Friday, Detty December…) and reverts by itself.
// The store's own design is never edited: the look and section changes are stored as differences and merged when
// the storefront renders (src/lib/store-campaigns/merge.ts). The status is worked out from the dates
// (src/lib/store-campaigns/status.ts); the *JobRanAt columns only make the start/end side effects run once
// (/api/cron/seasonal-campaigns). docs/migrations/2026-10-30-campaigns.sql creates the tables.

model StoreCampaign {
  id                 String    @id @default(cuid())
  storeId            String
  name               String
  preset             String?   // black_friday | christmas | … (src/lib/store-campaigns/presets.ts) or null
  startsAt           DateTime? // UTC; null = draft
  endsAt             DateTime? // UTC
  timezone           String    @default("Africa/Lagos") // IANA, for showing and picking dates
  priority           Int       @default(0)
  pausedAt           DateTime?
  archivedAt         DateTime?
  endingSoonHours    Int       @default(24)
  discountId         String?
  discountAutoToggle Boolean   @default(false) // switch the linked discount on at the start and off at the end
  themeOverride      Json      @default("{}") // { tokens: Partial<ThemeTokenSet>, logoUrl? }
  sectionOverrides   Json      @default("[]") // [{ id, page, action: add|hide|replace|reorder, sectionId?, section?, position? }]
  startJobRanAt      DateTime?
  endJobRanAt        DateTime?
  endingSoonSentAt   DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  store    Store                @relation(fields: [storeId], references: [id], onDelete: Cascade)
  discount Discount?            @relation(fields: [discountId], references: [id], onDelete: SetNull)
  blocks   StoreCampaignBlock[]
  events   StoreCampaignEvent[]

  @@index([storeId, startsAt, endsAt])
  @@index([endsAt])
}

/// Store-wide pieces a campaign adds: announcement bar, pop-up (a StoreForm, so there is one pop-up engine),
/// product badges and the countdown.
model StoreCampaignBlock {
  id         String   @id @default(cuid())
  campaignId String
  type       String   // announcement | popup | badge | countdown
  enabled    Boolean  @default(true)
  settings   Json     @default("{}")
  targeting  Json     @default("{}")
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  campaign StoreCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, type])
}

/// Storefront events for campaign reports: page_view, block_view, block_click, popup_shown, popup_closed, popup_converted.
model StoreCampaignEvent {
  id         String   @id @default(cuid())
  storeId    String
  campaignId String
  blockId    String?
  event      String
  sessionId  String?
  createdAt  DateTime @default(now())

  campaign StoreCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, event, createdAt])
}

// ─── Payment links and link in bio ────────────────────────────────────────────

/// A link a seller (or Peggy) shares so a customer can pay for exact products from a chat or a bio:
/// https://<store>/pay/<code>. Paying goes through the normal checkout (src/lib/payment-links/service.server.ts).
model PaymentLink {
  id             String    @id @default(cuid())
  storeId        String
  /// Public, unguessable (12 characters from a 29-letter alphabet, src/lib/payment-links/pure.ts).
  code           String    @unique
  title          String?
  /// [{ productId, variantId?, quantity, name, price, image? }]: what the link sells, with the price when it was made.
  items          Json      @default("[]")
  /// An agreed price for the items (before delivery), set by the seller; null = the product prices.
  customAmount   Float?
  note           String?
  buyerName      String?
  buyerPhone     String?
  buyerEmail     String?
  /// Saved delivery (optional, src/lib/payment-links/pure.ts LinkDeliverySchema): the customer's address, and either
  /// a delivery fee the seller agreed (0 = free) or one of the store's delivery options. With both, the pay page is
  /// one tap and checkout uses exactly this address and delivery.
  deliveryStreet   String?
  deliveryCity     String?
  deliveryState    String?
  deliveryLandmark String?
  deliveryFee      Float?
  deliveryOptionId String?
  /// One-time links close once paid; reusable ones (link in bio) keep selling.
  oneTime        Boolean   @default(true)
  /// How many the buyer may choose on a single-product link.
  maxQuantity    Int       @default(10)
  expiresAt      DateTime?
  status         String    @default("active") // active | paid | expired | cancelled
  /// The order that paid a one-time link (the latest paid order for reusable ones).
  orderId        String?
  paidCount      Int       @default(0)
  paidAt         DateTime?
  cancelledAt    DateTime?
  /// seller | peggy_seller | peggy_customer | bio
  createdBy      String    @default("seller")
  /// For links Peggy made in a customer chat: the inbox conversation and the customer's phone or handle.
  conversationId String?
  customerRef    String?
  /// The chat channel the link was sent on (whatsapp, livechat…), used for the order's channel.
  channel        String?
  views          Int       @default(0)
  lastViewedAt   DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, createdAt])
  @@index([storeId, status])
  @@index([conversationId, createdAt])
}

/// The store's link in bio page: https://<store>/links. One per store.
model BioPage {
  id        String   @id @default(cuid())
  storeId   String   @unique
  published Boolean  @default(true)
  title     String?
  bio       String?
  avatarUrl String?
  /// { preset, background, text, button, buttonText } (src/lib/bio/pure.ts)
  theme     Json     @default("{}")
  /// Ordered blocks: product, collection, link, socials, whatsapp, signup (src/lib/bio/pure.ts).
  blocks    Json     @default("[]")
  views     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store  Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  clicks BioPageClick[]
}

/// Taps per link in bio block (a lightweight counter).
model BioPageClick {
  id        String   @id @default(cuid())
  bioPageId String
  blockId   String
  count     Int      @default(0)
  updatedAt DateTime @updatedAt

  bioPage BioPage @relation(fields: [bioPageId], references: [id], onDelete: Cascade)

  @@unique([bioPageId, blockId])
}

// ─── Shopinbos Wallet ─────────────────────────────────────────────────────────
// A business's money settings on Shopinbos (src/lib/wallet): KYC, the bank Paystack settles to, and its Paystack
// subaccount. Shopinbos never holds anyone's money: at checkout Paystack splits each payment and settles every
// share straight to the business's own bank. WalletEntry is the statement of those shares.

model Wallet {
  id              String    @id @default(cuid())
  userId          String    @unique
  role            String // seller | supplier | logistics_partner
  status          String    @default("active") // active | frozen (the team paused it: no new payments split to it)
  // KYC: BVN or NIN checked with Korapay Identity against the owner's name and date of birth. Only the last 4
  // digits and a keyed hash are kept, never the number itself.
  kycStatus       String    @default("none") // none | verified
  kycIdType       String? // bvn | nin
  kycIdLast4      String?
  kycIdHash       String?
  kycFirstName    String?
  kycLastName     String?
  kycMiddleName   String?
  kycDateOfBirth  String? // YYYY-MM-DD
  kycReference    String? // Korapay's verification reference
  kycVerifiedAt   DateTime?
  kycAttempts     Int       @default(0) // failed checks on kycAttemptDay
  kycAttemptDay   String? // YYYY-MM-DD, Lagos time
  // The bank Paystack settles to (name checked with Paystack's account lookup).
  bankCode        String?
  bankName        String?
  accountNumber   String?
  accountName     String?
  // auto: the account name matches the KYC name · review: it doesn't (e.g. a company account), waiting for the
  // team · approved: the team checked it.
  nameCheck       String?
  // The Paystack subaccount payments are split to. Active only once KYC is verified and the bank name is checked.
  subaccountCode  String?   @unique
  subaccountStatus String   @default("none") // none | active | review | failed
  subaccountError String?
  // The same bank as a Korapay Split Payments recipient (KPY-SPA-…), added by the team in the Korapay dashboard
  // (Korapay has no API for it). Set: Korapay checkout can split to this business too.
  korapaySplitAccount String? @unique
  frozenReason    String?
  // Prepaid balance (src/lib/wallet/balance.server.ts): money the business topped up (card, or a transfer to their
  // own top-up account), spent on Shopinbos services (AI credits…) or withdrawn to their bank. Sales never land
  // here: they still settle straight to the bank. In kobo; only ever changed together with a WalletTransaction.
  balanceKobo        Int       @default(0)
  // Their own top-up account number (Paystack Dedicated Virtual Account), when DVA is switched on.
  topUpCustomerCode  String?   @unique
  topUpAccountNumber String?
  topUpAccountName   String?
  topUpBankName      String?
  topUpStatus        String    @default("none") // none | pending | ready | failed | unavailable
  topUpError         String?
  // Paystack transfer recipient for withdrawals (made from the checked bank above).
  transferRecipient  String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries      WalletEntry[]
  transactions WalletTransaction[]

  @@index([status])
  @@index([subaccountStatus])
  @@index([kycIdHash])
}

/// One movement of a wallet's prepaid balance. Idempotent on `reference` (Paystack references for top-ups and
/// withdrawals, our own for spends), so retries and webhook replays never count twice.
model WalletTransaction {
  id          String   @id @default(cuid())
  walletId    String
  kind        String // topup | spend | withdrawal | refund
  /// + money in, - money out (kobo).
  amountKobo  Int
  status      String   @default("done") // done | pending (withdrawals on their way) | failed (reversed)
  reference   String   @unique
  description String
  error       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId, createdAt(sort: Desc)])
}

model WalletEntry {
  id              String   @id @default(cuid())
  walletId        String
  // One per share of a payment: sale:<orderId> (the seller's), supplier:<orderId>:<supplierId>. Unique, so a
  // replayed webhook never records a share twice.
  reference       String   @unique
  kind            String // sale | supplier_order | delivery_fee (delivery:<bookingId>)
  amountKobo      Int // the share Paystack settles to this business (before Paystack's fee)
  status          String   @default("paid") // paid | refunded
  description     String
  orderId         String?
  supplierId      String?
  paystackReference String?
  createdAt       DateTime @default(now())

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId, createdAt])
  @@index([orderId])
}

// ─── Dropship agreement ───────────────────────────────────────────────────────
// Before a seller lists a supplier's products to dropship, the seller calls the supplier, checks the stock
// themselves (a visit or a video call) and accepts the Dropship agreement; the supplier accepts it too
// (shared/supplier-trust.ts, src/lib/marketplace/agreements.server.ts). One per seller and supplier.

model SupplierAgreement {
  id               String    @id @default(cuid())
  sellerId         String
  supplierId       String
  /// requested (the seller checked and agreed; waiting for the supplier) · active (both agreed) · declined
  status           String    @default("requested")
  /// AGREEMENT_VERSION both sides accepted.
  version          String
  /// How the seller saw the stock: visit | video
  stockCheck       String
  /// The seller confirmed they called the supplier.
  calledAt         DateTime
  sellerNote       String?
  sellerAgreedAt   DateTime
  supplierAgreedAt DateTime?
  /// Why the supplier declined.
  supplierNote     String?
  declinedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  seller   User     @relation("SellerAgreements", fields: [sellerId], references: [id], onDelete: Cascade)
  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([sellerId, supplierId])
  @@index([supplierId, status])
}

// ─── Contracts ────────────────────────────────────────────────────────────────
// Signed documents between two businesses (shared/contracts.ts, src/lib/contracts/contracts.server.ts): the
// Dropship agreement (shop and supplier, one per SupplierAgreement request) and the Delivery service agreement
// (shop or supplier and a delivery partner, one per DeliveryConnection). Party A is the side that starts it (the
// shop or business), party B the supplier or delivery partner. The document is frozen at the first signature and
// hashed. Each side sees its copy under Contracts; the admin team can only open one while a dispute is open, and
// every opening is a ContractEvent both sides are told about. Parties are kept as text too, so the record
// survives an account being closed.

model Contract {
  id                   String    @id @default(cuid())
  /// dropship | delivery
  kind                 String
  version              String
  title                String
  /// The ContractDocument both sides read and signed (frozen).
  body                 Json
  /// SHA-256 of the canonical JSON of body.
  bodyHash             String
  /// awaiting | signed | declined | ended
  status               String    @default("awaiting")
  supplierAgreementId  String?
  deliveryConnectionId String?

  partyAUserId         String?
  /// seller | supplier
  partyARole           String
  partyAName           String
  partyASignedName     String
  partyASignedAt       DateTime
  /// The signer's own account (a team member signing for the business), and where they signed from.
  partyASignerId       String?
  partyAIp             String?
  partyAUserAgent      String?

  partyBUserId         String?
  /// supplier | logistics_partner
  partyBRole           String
  partyBName           String
  partyBSignedName     String?
  partyBSignedAt       DateTime?
  partyBSignerId       String?
  partyBIp             String?
  partyBUserAgent      String?

  declinedAt           DateTime?
  declineNote          String?
  endedAt              DateTime?
  /// none | open | closed
  disputeStatus        String    @default("none")
  disputeOpenedAt      DateTime?
  /// a | b: which side raised it.
  disputeOpenedBy      String?
  disputeReason        String?
  disputeClosedAt      DateTime?
  disputeClosedNote    String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  partyA User?           @relation("ContractPartyA", fields: [partyAUserId], references: [id], onDelete: SetNull)
  partyB User?           @relation("ContractPartyB", fields: [partyBUserId], references: [id], onDelete: SetNull)
  events ContractEvent[]

  @@index([partyAUserId, createdAt])
  @@index([partyBUserId, createdAt])
  @@index([supplierAgreementId])
  @@index([deliveryConnectionId])
  @@index([disputeStatus, updatedAt])
}

/// What happened to a contract: signed, declined, ended, dispute opened or closed, and each time the admin team
/// opened it (with the reason). Both sides see this history on their copy.
model ContractEvent {
  id          String   @id @default(cuid())
  contractId  String
  /// signed | declined | ended | dispute_opened | dispute_closed | admin_opened
  action      String
  /// a | b | admin | system
  actorSide   String
  actorUserId String?
  actorName   String?
  note        String?
  ip          String?
  createdAt   DateTime @default(now())

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId, createdAt])
  @@index([actorUserId, action, createdAt])
}

// ─── Money owed between businesses ────────────────────────────────────────────
// Money one business owes another (or Shopinbos) when something goes wrong in a flow Shopinbos facilitates: a
// dropship order paid at checkout but never sent, goods that came back wrong or damaged, a parcel lost in transit,
// a chargeback the gateway took from Shopinbos. Shopinbos never holds it (src/lib/money-owed): the business that
// owes pays in the app (Paystack, split straight to the other business's bank), the business owed confirms it was
// paid outside the app, or once it is overdue part of the debtor's share of later sales is split to them instead.

model BusinessDebt {
  id               String    @id @default(cuid())
  /// What it is for, once: notsent:<supplierOrderId> (automatic) · claim:<id> (raised by the business owed) ·
  /// admin:<id> (the team recorded it) · overpaid:<payment reference> (paid twice: the other way round).
  sourceKey        String    @unique
  debtorUserId     String
  /// Null: Shopinbos is owed (a chargeback taken from Shopinbos's balance).
  creditorUserId   String?
  /// not_sent | wrong_item | damaged | not_as_described | short_delivery | lost_in_transit | damaged_in_transit |
  /// chargeback | overpaid | other
  reason           String
  amountKobo       Int
  paidKobo         Int       @default(0)
  /// claimed (waiting for the debtor to accept, or the team) · disputed (the debtor said no: the team decides) ·
  /// open (owed) · paid · rejected (the claim was dropped) · waived (the team cancelled what was left)
  status           String    @default("open")
  details          String?
  response         String?
  decisionNote     String?
  decidedByUserId  String?
  decidedAt        DateTime?
  retailOrderId    String?
  supplierOrderId  String?
  wholesaleOrderId String?
  bookingId        String?
  /// Pay by then; after it, later sales pay it off and the team sees it as overdue.
  dueAt            DateTime?
  remindedAt       DateTime?
  createdByUserId  String?
  paidAt           DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  debtor   User                  @relation("DebtDebtor", fields: [debtorUserId], references: [id], onDelete: Cascade)
  creditor User?                 @relation("DebtCreditor", fields: [creditorUserId], references: [id], onDelete: SetNull)
  payments BusinessDebtPayment[]

  @@index([debtorUserId, status])
  @@index([creditorUserId, status])
  @@index([status, dueAt])
}

/// Each payment towards a BusinessDebt. Deductions are planned when a checkout starts (they hold that part of the
/// debt for a while) and applied once the order is paid; planned ones whose order never paid count for nothing.
model BusinessDebtPayment {
  id            String   @id @default(cuid())
  debtId        String
  /// paystack (paid in the app) | deduction (split from a later sale) | confirmed (the business owed says it got it)
  method        String
  amountKobo    Int
  /// owepay-… (Paystack reference) · deduct:<orderId>:<debtId> · confirm:<debtId>:<time>
  reference     String   @unique
  retailOrderId String?
  /// planned | applied | void
  status        String   @default("applied")
  createdAt     DateTime @default(now())

  debt BusinessDebt @relation(fields: [debtId], references: [id], onDelete: Cascade)

  @@index([debtId, status])
  @@index([retailOrderId])
}

// Who connected a store through our Meta app (Facebook Login: WhatsApp Embedded Signup, catalog, ads; pasted tokens
// issued to our app). Meta's Deauthorize and Data Deletion callbacks name the person only by this app-scoped ID.
// src/lib/meta/user-links.server.ts records it; src/lib/meta/user-data.server.ts acts on it.
model MetaUserLink {
  id         String   @id @default(cuid())
  metaUserId String // app-scoped user ID (debug_token / signed_request user_id)
  storeId    String
  source     String // inbox_whatsapp | inbox_messenger | inbox_instagram | sales_meta | meta_ads
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([metaUserId, storeId, source])
  @@index([storeId])
}

// Meta Data Deletion callback requests. The person checks progress at /meta-data-deletion?code=… (the URL we hand
// back to Meta). Holds a hash of the user ID, never the ID itself.
model MetaDataDeletionRequest {
  id               String    @id @default(cuid())
  confirmationCode String    @unique
  metaUserHash     String
  status           String    @default("received") // received | completed | failed
  storesAffected   Int       @default(0)
  summary          Json      @default("{}")
  error            String?
  requestedAt      DateTime  @default(now())
  completedAt      DateTime?

  @@index([metaUserHash])
}

// Platform-wide settings an admin changes without a deploy. Prices live under "price.<key>" (Admin › Pricing,
// shared/platform-pricing.ts); unset keys use the registry's defaults.
model PlatformSetting {
  key         String   @id
  value       Json
  updatedById String?
  updatedAt   DateTime @updatedAt
}

// Every change to a PlatformSetting: who, when, from what to what, and why.
model PlatformSettingChange {
  id          String   @id @default(cuid())
  key         String
  before      Json?
  after       Json
  note        String?
  changedById String?
  changedBy   User?    @relation("PlatformSettingChanges", fields: [changedById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([key, createdAt])
  @@index([createdAt])
}

// A Black Friday or seasonal price drop (Admin › Pricing › Promotions): some prices from the price book set
// differently between startsAt and endsAt, then back to normal by themselves (shared/price-promotions.ts).
// When it starts, the product-news email it scheduled goes out and the in-app notice + push are sent in batches
// (noticeCursor: the last user notified). Migration: docs/migrations/2026-11-10-price-promotions.sql.
model PricePromotion {
  id             String    @id @default(cuid())
  name           String
  headline       String
  message        String?
  prices         Json // { "<price key>": value }, checked against shared/platform-pricing.ts
  startsAt       DateTime
  endsAt         DateTime
  status         String    @default("scheduled") // scheduled | cancelled (upcoming / live / ended come from the dates)
  audience       String[] // seller | supplier | logistics_partner
  announceEmail  Boolean   @default(true)
  announceNotice Boolean   @default(true)
  broadcastId    String?
  noticeStatus   String    @default("pending") // pending | sending | sent | off
  noticeCursor   String?
  noticeCount    Int       @default(0)
  createdById    String?
  createdBy      User?     @relation("PricePromotions", fields: [createdById], references: [id], onDelete: SetNull)
  cancelledAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status, startsAt])
  @@index([endsAt])
}

// Every Paystack plan code Shopinbos sells or has sold (Admin › Pricing › Plans, shared/plan-catalog.ts). A new
// price creates a new Paystack plan and a new row marked current; older rows stay so people subscribed at an older
// price keep their tier's perks and credits. Migration: docs/migrations/2026-11-11-subscription-plans.sql.
model SubscriptionPlanVersion {
  code        String    @id // Paystack plan_code
  tier        String // seller_growth | seller_pro | supplier_max
  billing     String // monthly | annual
  amountNgn   Int? // null: an old code we honour but never sold here
  current     Boolean   @default(false)
  createdById String?
  createdBy   User?     @relation("PlanVersionsCreated", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  retiredAt   DateTime?

  @@index([tier, billing, current])
}

// ─── Rewards (sellers, suppliers, delivery partners) ──────────────────────────
// Levels, weekly challenges and badges in the phone app (src/lib/rewards: rules.ts holds the per-role catalogs).
// Every reward comes from one RewardEvent, unique on (userId, kind, ref), so a replayed webhook or a double tap
// never pays twice. Points only swap for free AI credits (100 → 20); they are never turned into cash.
// Migration: docs/migrations/2026-11-18-rewards.sql.

model RewardAccount {
  userId        String   @id
  /// Lifetime XP: sets the level. Never goes down.
  xp            Int      @default(0)
  /// Points to spend (swap for AI credits). Never cash.
  points        Int      @default(0)
  /// Days in a row with at least one reward, counted on Lagos calendar days.
  streak        Int      @default(0)
  /// "YYYY-MM-DD" (Africa/Lagos) of the last day that counted toward the streak.
  lastActiveDay String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model RewardEvent {
  id        String   @id @default(cuid())
  userId    String
  /// order_paid | order_accepted | order_accepted_fast | shop_supplied | product_added | quote_sent | status_posted |
  /// delivery_done | delivery_on_time | job_accepted_fast | chat_replied_fast | partner_connected
  kind      String
  /// What it was for (order, product, job, post… id), so the same thing is counted once.
  ref       String
  xp        Int      @default(0)
  points    Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([userId, kind, ref])
  @@index([userId, kind, createdAt])
}

model ChallengeClaim {
  id        String   @id @default(cuid())
  userId    String
  key       String
  /// Monday 00:00 Africa/Lagos of the week the challenge was done in.
  weekStart DateTime
  points    Int
  createdAt DateTime @default(now())

  @@unique([userId, key, weekStart])
}

model UserBadge {
  id       String   @id @default(cuid())
  userId   String
  key      String
  earnedAt DateTime @default(now())

  @@unique([userId, key])
}

// ─── Status (24-hour stories) ─────────────────────────────────────────────────
// Short posts sellers, suppliers and delivery partners share with each other in the phone app's Status row
// (/api/mobile/status, rules in shared/status.ts). A post lives 24 hours: reads never return it after expiresAt,
// and /api/cron/status-purge deletes it (with its views, likes and photo) later.
// Migration: docs/migrations/2026-11-18-status-posts.sql.

model StatusPost {
  id        String   @id @default(cuid())
  authorId  String
  /// The author's role when they posted: seller | supplier | logistics_partner (who sees it: shared/status.ts).
  role      Role
  headline  String
  caption   String?
  /// A photo uploaded through /api/mobile/status/upload (public bucket, status/<authorId>/).
  imageUrl  String?
  /// peach | mint | blue | warn | ink
  tone      String   @default("peach")
  /// The product the post is about, by the author's role: a supplier's own SupplierProduct (what "Add to my shop"
  /// lists through the dropship agreement), or a seller's own StoreProduct. Not a foreign key, since it points at
  /// one of two tables; it is checked against the author when posting and read back by role.
  productId String?
  /// add_product | chat | connect | see_rates | offer_delivery | view_shop (allowed per role: shared/status.ts)
  ctaKind   String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  author User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  views  StatusView[]
  likes  StatusLike[]

  @@index([authorId, expiresAt])
  @@index([expiresAt])
}

/// Who has seen a post (once per viewer).
model StatusView {
  id        String   @id @default(cuid())
  postId    String
  viewerId  String
  createdAt DateTime @default(now())

  post   StatusPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  viewer User       @relation(fields: [viewerId], references: [id], onDelete: Cascade)

  @@unique([postId, viewerId])
  @@index([viewerId])
}

/// A like on a post (once per user).
model StatusLike {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post StatusPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([userId])
}


// ─── Create with Rex and posts ────────────────────────────────────────────────
// The phone app's "Make a post" (Create with Rex) and posts calendar, for sellers, suppliers and delivery partners
// (src/app/api/mobile/create, src/app/api/mobile/posts, shared/create-with-rex.ts). Nothing is ever posted for
// anyone: "Share now" opens the phone's share sheet, and a scheduled post gets one "Time to post" reminder
// (src/app/api/cron/post-reminders). No relation fields on User on purpose (like AiUsage), so this section stands
// alone. Migration: docs/migrations/2026-11-18-create-posts.sql.

/// One "Make a post" request: 3 templated designs (stored in the public media bucket), each with a caption.
model CreateJob {
  id        String   @id @default(cuid())
  userId    String
  /// making | done | failed
  status    String   @default("making")
  /// status | reel | post | flyer
  format    String
  ideaId    String?
  prompt    String?
  productId String?
  /// [{ id, imageUrl, caption }]
  designs   Json     @default("[]")
  error     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
}

/// A post in the calendar. status: draft | scheduled | posted. remindedAt: the "Time to post" reminder went (once).
model ScheduledPost {
  id          String    @id @default(cuid())
  userId      String
  designId    String?
  imageUrl    String?
  caption     String
  /// whatsapp | instagram | facebook | tiktok
  platforms   String[]
  status      String    @default("draft")
  scheduledAt DateTime?
  postedAt    DateTime?
  remindedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId, scheduledAt])
  @@index([status, scheduledAt])
  // The live database already has an unrelated, empty "ScheduledPost" table from an older design; this one lives
  // in "PlannedPost" so the two never collide.
  @@map("PlannedPost")
}

// ─── Social posts (Marketing > Social posts) ────────────────────────────────
// A post the seller plans on the calendar: one picture or video (a Rex design, a reel, a library or product photo),
// prepared at the size the channels want (renderedUrl), one caption, the channels it goes to and when. Facebook
// and Instagram post by themselves through the Page connected on the Social posts page; WhatsApp, TikTok and X
// can't be posted to for the seller, so at the time the post is "ready" and they post it in one tap.
// /api/cron/social-posts posts the due ones (src/lib/social-posts). docs/migrations/2026-11-16-social-posts.sql.
model SocialPost {
  id          String    @id @default(cuid())
  storeId     String
  userId      String
  caption     String    @default("")
  /// The picked picture or video as chosen; renderedUrl is the copy at the post's size (JPEG for pictures).
  mediaUrl    String?
  mediaKind   String? // image | video
  renderedUrl String?
  /// Where the media came from, for the "Rex designs" filters: rex | reel | library | product | upload
  mediaSource String?
  /// square | portrait | story | landscape (src/lib/social-posts/pure.ts POST_FORMATS)
  format      String    @default("square")
  /// cover (crop to fill) | fit (whole picture on a blurred backdrop)
  fit         String    @default("cover")
  /// facebook | instagram | whatsapp | tiktok | x
  channels    String[]  @default([])
  productId   String?
  link        String?
  /// draft | scheduled | publishing | posted | partial | failed
  status      String    @default("draft")
  scheduledAt DateTime?
  postedAt    DateTime?
  /// { [channel]: { status: posted | ready | shared | failed | waiting, id?, url?, error?, container?, at? } }
  results     Json      @default("{}")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([storeId, scheduledAt])
  @@index([status, scheduledAt])
}
