# Copy to .env.local and fill in. Never commit .env.local.

# ─── Database (Supabase Postgres) ─────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres
DIRECT_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres
# PRISMA_POOL_LIMIT=5

# ─── Supabase ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_STORAGE_BUCKET=shopinbos-media
# Private bucket for verification documents and message/support attachments (docs/migrations/2026-10-13-security-rls-storage.sql)
PRIVATE_STORAGE_BUCKET=

# ─── App URLs ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPPORT_WHATSAPP=          # optional, e.g. 2348012345678 — shown as "Message us on WhatsApp" on sign-up
# Storefronts: until NEXT_PUBLIC_STORE_SUBDOMAINS=true, shops live at app.shopinbos.com/s/{slug}. Set it to true only
# once *.shopinbos.com has a wildcard DNS record pointed at Vercel and *.shopinbos.com is added to the project;
# then shops are served at {slug}.{root domain}.
NEXT_PUBLIC_ROOT_DOMAIN=shopinbos.com
NEXT_PUBLIC_STORE_SUBDOMAINS=
# Comma-separated emails that may sign up as admin
SHOPINBOS_ADMIN_INVITE_EMAILS=

# ─── AI ───────────────────────────────────────────────────────────────────────
# Rex and Peggy use both providers: set one key and everything works; set both and the other one is the
# automatic fallback. Images and voice need OpenAI.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional: which provider goes first for text, chat and tools (anthropic | openai). Default anthropic.
AI_PRIMARY_PROVIDER=
# Optional model overrides (defaults in src/lib/ai/client.ts)
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_FAST_MODEL=claude-haiku-5-5
OPENAI_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_TTS_MODEL=gpt-4o-mini-tts
# Optional: ElevenLabs voiceovers in the video studio (falls back to OpenAI). Pick Nigerian-accent voices in the
# ElevenLabs voice library and paste their ids.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_FEMALE=
ELEVENLABS_VOICE_MALE=
# ELEVENLABS_MODEL=eleven_multilingual_v2
# Voice typing (POST /api/ai/transcribe) and Rex voice notes. Without OPENAI_API_KEY the mic says to type instead.
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# Tests only: point the OpenAI SDK at a local stub (never set in production).
# OPENAI_BASE_URL=http://127.0.0.1:54399/v1

# ─── Payments ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
# Also verifies Paystack webhook signatures
PAYSTACK_SECRET_KEY=
# Delivery partners' own pay-in accounts (Paystack Dedicated Virtual Accounts; must be enabled on the Paystack
# business). Bank slug: "test-bank" with test keys (the default for sk_test_), "wema-bank" or "titan-paystack" live.
PAYSTACK_DVA_BANK=
# Set to false to switch pay-in accounts off (partners then see the "Tell us you paid in" form)
PAYSTACK_DVA_ENABLED=
NEXT_PUBLIC_FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=

# ─── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=
# Must be on a domain verified in Resend; campaigns keep this address and use the store name
RESEND_FROM_EMAIL="Shopinbos <noreply@shopinbos.com>"
RESEND_AUDIENCE_ID=
# Email footer for Shopinbos's own emails (optional: built-in defaults are Tech Della Solutions LTD's details).
SHOPINBOS_LEGAL_NAME=
SHOPINBOS_POSTAL_ADDRESS=
# Optional: a mailbox someone processes, added as the mailto: half of List-Unsubscribe (e.g. unsubscribe@shopinbos.com).
UNSUBSCRIBE_MAILTO=

# ─── SMS (Termii, Africa's Talking, Sendchamp) ───────────────────────────────
# Platform SMS for notifications, marketing, review requests and sign-in codes. SMS_PROVIDER is tried first
# (or a comma list, e.g. "termii,africastalking"); every other provider with keys below is a fallback when it errors.
# Stores connect their own accounts in Inbox › Channels (encrypted with INBOX_ENCRYPTION_KEY) and don't need these.
SMS_PROVIDER=termii
# Termii: API key, secret key (signs webhooks) and base URL from the dashboard. Sender ID must be approved.
# Channel: dnd (transactional, reaches DND numbers) or generic (promotional, no DND, held 8pm-8am for MTN).
TERMII_API_KEY=
TERMII_SECRET_KEY=
TERMII_SENDER_ID=
TERMII_CHANNEL=dnd
TERMII_BASE_URL=https://v3.api.termii.com
# Africa's Talking: app username ("sandbox" for the sandbox) and API key; sender ID or shortcode (optional).
AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=
AFRICASTALKING_SENDER_ID=
# Sendchamp: public access key; sender name approved in the dashboard; route dnd | non_dnd | international.
# Also the platform WhatsApp sender for review requests and marketing.
SENDCHAMP_API_KEY=
SENDCHAMP_SENDER_NAME=
SENDCHAMP_ROUTE=dnd
# Delivery reports for platform sends: {APP_URL}/api/webhooks/sms/<termii|africastalking|sendchamp>?token=<this>
# (Termii reports are also accepted when signed with TERMII_SECRET_KEY). Any long random string.
SMS_WEBHOOK_SECRET=
# Optional: only accept SMS/voice webhooks from these IPs (comma list, IPv4 CIDR allowed). Empty = token check only.
SMS_WEBHOOK_ALLOWED_IPS=
# Supabase Auth "Send SMS" hook secret ("v1,whsec_…", Auth → Hooks): phone sign-in codes are sent through the
# provider above via {APP_URL}/api/webhooks/supabase-sms. scripts/configure-supabase-auth.mjs switches it on.
SUPABASE_SEND_SMS_HOOK_SECRET=
# Sign-in codes on WhatsApp (SMS stays the fallback, and "Send it by SMS" forces it). Needs the Send SMS hook above
# and docs/migrations/2026-10-21-auth-code-channel.sql. Never Twilio. Set AUTH_OTP_WHATSAPP=1 plus one of:
#   Termii:    TERMII_API_KEY (above) and a WhatsApp sender/device name in AUTH_OTP_WHATSAPP_SENDER (else TERMII_SENDER_ID)
#   Sendchamp: SENDCHAMP_API_KEY (above), the business WhatsApp number in AUTH_OTP_WHATSAPP_SENDER (e.g. 2348012345678)
#              and an approved WhatsApp authentication template: its code in AUTH_OTP_WHATSAPP_TEMPLATE, and the
#              variable holding the code in AUTH_OTP_WHATSAPP_TEMPLATE_PARAM (default "1", i.e. {{1}}).
#   Meta:      Shopinbos's own WhatsApp Business number on the Cloud API (not a seller's): WHATSAPP_OTP_PHONE_NUMBER_ID,
#              WHATSAPP_OTP_TOKEN (System User token: whatsapp_business_messaging + whatsapp_business_management) and
#              an approved authentication template's name in AUTH_OTP_WHATSAPP_TEMPLATE. Create the template with
#              WHATSAPP_OTP_WABA_ID=… WHATSAPP_OTP_TOKEN=… node scripts/create-whatsapp-otp-template.mjs
# AUTH_OTP_WHATSAPP_PROVIDER=termii|sendchamp|meta picks one when several are set (default: SMS_PROVIDER order).
# GET /api/auth/otp → { data: { whatsapp: true|false } } tells the sign-in screens which button to show.
AUTH_OTP_WHATSAPP=
AUTH_OTP_WHATSAPP_PROVIDER=
AUTH_OTP_WHATSAPP_SENDER=
AUTH_OTP_WHATSAPP_TEMPLATE=
AUTH_OTP_WHATSAPP_TEMPLATE_PARAM=
AUTH_OTP_WHATSAPP_TEMPLATE_LANG=
WHATSAPP_OTP_PHONE_NUMBER_ID=
WHATSAPP_OTP_TOKEN=
WHATSAPP_OTP_WABA_ID=                 # only for scripts/create-whatsapp-otp-template.mjs

# ─── Scheduled jobs ───────────────────────────────────────────────────────────
# Bearer secret for /api/cron/* (Vercel Cron sends it automatically when set in the project)
CRON_SECRET=
# Optional: signs unsubscribe links in automation emails (falls back to CRON_SECRET / service key)
MARKETING_LINK_SECRET=
# Optional: minutes an unpaid card/transfer storefront order holds stock before /api/cron/expire-orders
# cancels it and gives the stock back (default 30, minimum 5). Pay-on-delivery orders never expire.
UNPAID_ORDER_TTL_MINUTES=

# ─── Domains (Vercel) ─────────────────────────────────────────────────────────
VERCEL_TOKEN=
VERCEL_PROJECT_ID_OR_NAME=
VERCEL_TEAM_ID=

# ─── Monitoring ───────────────────────────────────────────────────────────────
SENTRY_DSN=

# ─── Sell everywhere (/channels) ──────────────────────────────────────────────
# Product feeds (/api/public/feeds/<store>/{google,meta,tiktok,whatsapp}.{xml,csv}) need no keys.
# Each platform card has one "Connect" button that signs in with that platform (OAuth), creates or picks the seller's
# catalog there, registers our product feed on a daily schedule and shows "n products showing". Tokens are stored
# encrypted with INBOX_ENCRYPTION_KEY (below; required). A platform whose keys are missing shows "Coming soon".
# Redirect URIs to register (both hosts, exactly):
#   https://shopinbos-app.vercel.app/api/app/sales-channels/<meta|google|tiktok>/callback
#   https://app.shopinbos.com/api/app/sales-channels/<meta|google|tiktok>/callback
# (NEXT_PUBLIC_APP_URL decides which one this server sends; it must match the host sellers use.)
# Counts and token refresh: /api/cron/sales-channels every 2 hours (pg_cron, docs/migrations/2026-10-22-sales-channels.sql).
#
# Facebook & Instagram: uses META_APP_ID + META_APP_SECRET (below) and a second Facebook Login for Business
# configuration. developers.facebook.com → your app → Facebook Login for Business → Configurations → Create:
# token type "System-user access token" (never expires; "User access token" lasts 60 days, then sellers reconnect),
# assets: Catalogs (and Business), permissions catalog_management + business_management. Paste its id here.
# Add both redirect URIs above under Facebook Login for Business → Settings → Valid OAuth Redirect URIs. Needs
# Advanced Access to catalog_management and business_management (App Review + Business Verification).
META_CATALOG_CONFIG_ID=
#
# Meta ads (/home/ads: sellers launch Facebook & Instagram campaigns on their own ad account through the Marketing
# API). Uses META_APP_ID + META_APP_SECRET + INBOX_ENCRYPTION_KEY. Optional: a Facebook Login for Business
# configuration with ads_management, ads_read, business_management, pages_show_list, pages_read_engagement,
# pages_manage_ads and instagram_basic (without it, classic Facebook Login asks for those scopes). Add
# <NEXT_PUBLIC_APP_URL>/api/app/ads/meta/callback to Valid OAuth Redirect URIs. ads_management needs Advanced
# Access (App Review + Business Verification) before sellers outside your app's roles can connect.
META_ADS_CONFIG_ID=
# Where "Shopinbos runs it for me" ad requests are emailed once the setup fee is paid (default: SUPPORT_INBOX).
ADS_TEAM_EMAIL=
# Graph API version for catalog calls (default v21.0):
META_GRAPH_VERSION=
#
# Google (Merchant Center): Google Cloud console → APIs & Services → enable "Merchant API" → OAuth consent screen
# (External; scope https://www.googleapis.com/auth/content, a sensitive scope: Google verifies the app before
# non-test users can connect) → Credentials → OAuth client ID (Web application) with both redirect URIs above.
GOOGLE_MERCHANT_CLIENT_ID=
GOOGLE_MERCHANT_CLIENT_SECRET=
# Tests only: point Merchant API calls at a local stub.
GOOGLE_MERCHANT_API_BASE_URL=
#
# TikTok (catalog for TikTok ads and product links; TikTok Shop isn't open in Nigeria): business-api.tiktok.com →
# My Apps → Create app (Marketing API) with the Catalog Management and Business Center scopes, Advertiser redirect URL =
# the TikTok redirect URI above. TikTok reviews the app before other businesses can authorise it.
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
# Tests only: point TikTok Business API calls at a local stub.
TIKTOK_API_BASE_URL=

# ─── Reviews ──────────────────────────────────────────────────────────────────
# Signs review-request links (/s/[slug]/review/<token>). Falls back to SUPABASE_SERVICE_ROLE_KEY.
REVIEW_LINK_SECRET=
# Google Business Profile reviews (import + replies). OAuth client from a Google Cloud project approved for
# the Business Profile APIs; redirect URI: {NEXT_PUBLIC_APP_URL}/api/app/reviews/google/callback
GOOGLE_BUSINESS_CLIENT_ID=
GOOGLE_BUSINESS_CLIENT_SECRET=
# Encrypts stored OAuth tokens (any long random string). Shared with other integrations if they use it.
INTEGRATIONS_ENCRYPTION_KEY=

# ─── All-in-one inbox (/home/messages, /home/inbox/channels) ─────────────────────
# Encrypts every seller's channel keys (WhatsApp/Meta tokens, SMS/voice provider keys, Telegram bot tokens) at rest.
# 32 random bytes as hex or base64 (openssl rand -hex 32). Without it, only live chat, forms and email work.
INBOX_ENCRYPTION_KEY=
# Inbound email: a domain set up for receiving in Resend (MX → Resend). Mail to <store-slug>@<domain> reaches that
# store's inbox, and replies are sent from that address. Webhook: {APP_URL}/api/webhooks/email, event email.received
# (+ email.delivered / email.bounced for delivery ticks), signing secret below.
INBOX_EMAIL_DOMAIN=
RESEND_WEBHOOK_SECRET=
# (Resend signs with Svix headers; deliveries whose svix-timestamp is more than 5 minutes off are refused.)
# Optional: any other inbound relay posting JSON { from, to, subject, text, html, message_id }. Send
# X-Inbox-Timestamp: <unix seconds> and X-Inbox-Signature: hex HMAC-SHA256 of "<timestamp>.<raw body>" with this
# secret. Requests more than 5 minutes old are refused and repeated message ids are ignored (no body-only HMAC).
INBOX_EMAIL_WEBHOOK_SECRET=
# Sellers' own email (Inbox → Email, /home/inbox/email):
#  • Own domain: uses RESEND_API_KEY (the key needs "Full access" to create domains). Domains bought through Shopinbos
#    get their DNS records added through the Vercel API (VERCEL_TOKEN). Replies come back through INBOX_EMAIL_DOMAIN
#    above: emails go out with Reply-To <slug>+r-<conversation>-<sig>@INBOX_EMAIL_DOMAIN, so they thread.
#  • Gmail: a Google Cloud OAuth client (Web application). Enable the Gmail API, add the scopes gmail.send and
#    gmail.readonly to the consent screen (restricted scopes: Google must verify the app, with a security assessment,
#    before anyone outside your test users can connect). Redirect URI: {NEXT_PUBLIC_APP_URL}/api/app/inbox/email/gmail/callback
#    Tokens are stored encrypted with INBOX_ENCRYPTION_KEY. Replies are pulled by /api/cron/gmail-sync every 5 minutes
#    (pg_cron, docs/migrations/2026-10-31-email-channel.sql, CRON_SECRET).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: the support desk's inbound webhook ({APP_URL}/api/support/inbound) uses the same two schemes.
# SUPPORT_WEBHOOK_SECRET (Resend/Svix, falls back to RESEND_WEBHOOK_SECRET) and SUPPORT_EMAIL_WEBHOOK_SECRET
# (relay, falls back to INBOX_EMAIL_WEBHOOK_SECRET).
SUPPORT_WEBHOOK_SECRET=
SUPPORT_EMAIL_WEBHOOK_SECRET=
# Optional platform Meta app (WhatsApp Cloud API, Messenger, Instagram). Webhooks: {APP_URL}/api/webhooks/whatsapp
# and {APP_URL}/api/webhooks/meta. Sellers using their own Meta app paste their app secret when connecting instead.
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
# Optional: WhatsApp Embedded Signup ("Connect with Facebook" on /home/inbox/chatbot?tab=whatsapp) for Shopinbos as a
# Meta Tech Provider. META_APP_ID is the platform app's id; META_CONFIG_ID is the Facebook Login for Business
# configuration (WhatsApp Embedded Signup). Needs META_APP_SECRET too. Without them sellers connect manually.
# The WhatsApp card on /channels ("Connect") also runs this sign-up, then creates the WhatsApp catalog: add
# catalog_management and business_management to this configuration's permissions too. Without these three the
# WhatsApp card says "Coming soon" unless the store already connected WhatsApp another way.
# The page's CSP must also allow https://connect.facebook.net (script-src) and https://*.facebook.com (frame-src,
# connect-src) for the Facebook SDK.
META_APP_ID=
META_CONFIG_ID=
# Marketing on SMS/WhatsApp (docs/migrations/2026-10-15-marketing-channels.sql). Messages per second for SMS and
# WhatsApp campaigns (default 10, max 80). META_APP_ID above is also needed to upload the sample picture when a
# WhatsApp template with an image header is submitted to Meta.
MARKETING_TEXT_RATE_PER_SECOND=
# Optional: platform price of one SMS part, for campaign cost estimates when the seller hasn't set their own.
SMS_COST_PER_SEGMENT=
# Tests only: send WhatsApp template calls to a local stub instead of https://graph.facebook.com/v21.0.
META_GRAPH_BASE_URL=
# Tests only (ignored when VERCEL_ENV=production): send Paystack and Vercel domain calls to local stubs.
PAYSTACK_API_BASE_URL=
VERCEL_API_BASE_URL=

# ─── Domains (security) ───────────────────────────────────────────────────────
# Buying a domain charges the seller first (Paystack), then buys it on the platform's Vercel account; if the
# registrar refuses, the payment is refunded. Renewals are paid by the seller the same way (Vercel auto-renew stays
# off). Needs VERCEL_* above, PAYSTACK_SECRET_KEY and the daily /api/cron/domain-renewals job
# (docs/migrations/2026-10-24-domain-billing.sql). Off unless "true".
DOMAIN_PURCHASE_ENABLED=
# Most a single domain may cost us (USD, registrar price) when buying is on. Default 20.
DOMAIN_PURCHASE_MAX_USD=
# Seller price in naira = Vercel USD price × DOMAIN_USD_NGN_RATE + DOMAIN_MARKUP_NGN, rounded up to the next ₦500.
# Defaults: 1650 and 3000. Update the rate when the naira moves.
DOMAIN_USD_NGN_RATE=
DOMAIN_MARKUP_NGN=

# ── Instant CAC business check (supplier + delivery-partner verification) ──
# Dojah KYB (docs.dojah.io). Without these the "Verify instantly with CAC" box stays hidden and people upload
# their certificate as before. Each lookup is charged to the Dojah wallet; accounts get 5 checks a day.
DOJAH_APP_ID=
DOJAH_SECRET_KEY=
# "sandbox" uses Dojah's test registry (try RC 1261103); leave empty for live lookups.
DOJAH_ENV=

# ─── Maps (pickup coordinates for "closest rider") ────────────────────────────
# Google Geocoding when set; otherwise OpenStreetMap Nominatim (1 request a second, cached in GeocodeCache)
GOOGLE_MAPS_API_KEY=

# Push notifications (src/lib/notifications/push.server.ts)
# Web Push (browsers): VAPID keys. Generate once with `npx web-push generate-vapid-keys`. Leave empty to switch
# browser push off (the "Turn on notifications" option then doesn't show). SUBJECT is a mailto: or https: contact.
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:hello@shopinbos.com
# Expo push (the phone app): optional access token if "Enhanced push security" is on in the Expo project.
EXPO_ACCESS_TOKEN=
