{
  "expo": {
    "name": "Shopinbos",
    "slug": "shopinbos",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "shopinbos",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.shopinbos.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Take photos of your products, and proof of delivery photos.",
        "NSPhotoLibraryUsageDescription": "Choose product photos so Rex can list them in your shop.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.shopinbos.app",
      "adaptiveIcon": {
        "backgroundColor": "#0C4A44",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-web-browser",
      "expo-font",
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose product photos so Rex can list them in your shop.",
          "cameraPermission": "Take photos of your products, and proof of delivery photos."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/mark-white.png",
          "imageWidth": 76,
          "resizeMode": "contain",
          "backgroundColor": "#0C4A44"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Shopinbos uses the microphone only when you tap the mic, so you can speak instead of typing.",
          "recordAudioAndroid": true
        }
      ],
      "expo-video",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Shopinbos uses your location only while you're online, so we can give you jobs near you.",
          "isAndroidBackgroundLocationEnabled": false,
          "isIosBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#FF6A2B",
          "defaultChannel": "orders"
        }
      ],
      "expo-asset"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4ae115fe-eb0f-4c1c-82f4-9e38b3c88c07"
      }
    },
    "owner": "shopinbos-app"
  }
}
