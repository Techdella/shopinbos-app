# Copy to .env.local and fill in. Never commit .env.local.

# ─── Database (Supabase Postgres) ─────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres
DIRECT_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres
# PRISMA_POOL_LIMIT=5

# ─── Supabase ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_STORAGE_BUCKET=shopinbos-media

# ─── App URLs ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Storefronts are served at {slug}.{root domain}
NEXT_PUBLIC_ROOT_DOMAIN=shopinbos.com
# Comma-separated emails that may sign up as admin
SHOPINBOS_ADMIN_INVITE_EMAILS=

# ─── AI ───────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ─── Payments ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
# Also verifies Paystack webhook signatures
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=

# ─── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=
# Must be on a domain verified in Resend; campaigns keep this address and use the store name
RESEND_FROM_EMAIL="Shopinbos <noreply@shopinbos.com>"
RESEND_AUDIENCE_ID=

# ─── SMS ──────────────────────────────────────────────────────────────────────
SENDCHAMP_API_KEY=
SENDCHAMP_SENDER_NAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=

# ─── Scheduled jobs ───────────────────────────────────────────────────────────
# Bearer secret for /api/cron/* (Vercel Cron sends it automatically when set in the project)
CRON_SECRET=

# ─── Domains (Vercel) ─────────────────────────────────────────────────────────
VERCEL_TOKEN=
VERCEL_PROJECT_ID_OR_NAME=
VERCEL_TEAM_ID=

# ─── Monitoring ───────────────────────────────────────────────────────────────
SENTRY_DSN=
