  status      CouponStatus  @default(active)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([storeId])
  @@index([code])
  @@index([status])
}

// ─── Subscriber ────────────────────────────────────────────────────────────────

