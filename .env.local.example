# Copy to .env.local and fill in. Never commit .env.local.

# ─── Database (Supabase Postgres) ─────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres
DIRECT_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres
# PRISMA_POOL_LIMIT=5

# ─── Supabase ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_STORAGE_BUCKET=shopinbos-media
# Private bucket for verification documents and message/support attachments (docs/migrations/2026-10-13-security-rls-storage.sql)
PRIVATE_STORAGE_BUCKET=

# ─── App URLs ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPPORT_WHATSAPP=          # optional, e.g. 2348012345678 — shown as "Message us on WhatsApp" on sign-up
# Storefronts are served at {slug}.{root domain}
NEXT_PUBLIC_ROOT_DOMAIN=shopinbos.com
# Comma-separated emails that may sign up as admin
SHOPINBOS_ADMIN_INVITE_EMAILS=

# ─── AI ───────────────────────────────────────────────────────────────────────
# Rex and Peggy use both providers: set one key and everything works; set both and the other one is the
# automatic fallback. Images and voice need OpenAI.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional: which provider goes first for text, chat and tools (anthropic | openai). Default anthropic.
AI_PRIMARY_PROVIDER=
# Optional model overrides (defaults in src/lib/ai/client.ts)
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_FAST_MODEL=claude-haiku-5-5
OPENAI_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# ─── Payments ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
# Also verifies Paystack webhook signatures
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=

# ─── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=
# Must be on a domain verified in Resend; campaigns keep this address and use the store name
RESEND_FROM_EMAIL="Shopinbos <noreply@shopinbos.com>"
RESEND_AUDIENCE_ID=

# ─── SMS (Termii, Africa's Talking, Sendchamp) ───────────────────────────────
# Platform SMS for notifications, marketing, review requests and sign-in codes. SMS_PROVIDER is tried first
# (or a comma list, e.g. "termii,africastalking"); every other provider with keys below is a fallback when it errors.
# Stores connect their own accounts in Inbox › Channels (encrypted with INBOX_ENCRYPTION_KEY) and don't need these.
SMS_PROVIDER=termii
# Termii: API key, secret key (signs webhooks) and base URL from the dashboard. Sender ID must be approved.
# Channel: dnd (transactional, reaches DND numbers) or generic (promotional, no DND, held 8pm-8am for MTN).
TERMII_API_KEY=
TERMII_SECRET_KEY=
TERMII_SENDER_ID=
TERMII_CHANNEL=dnd
TERMII_BASE_URL=https://v3.api.termii.com
# Africa's Talking: app username ("sandbox" for the sandbox) and API key; sender ID or shortcode (optional).
AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=
AFRICASTALKING_SENDER_ID=
# Sendchamp: public access key; sender name approved in the dashboard; route dnd | non_dnd | international.
# Also the platform WhatsApp sender for review requests and marketing.
SENDCHAMP_API_KEY=
SENDCHAMP_SENDER_NAME=
SENDCHAMP_ROUTE=dnd
# Delivery reports for platform sends: {APP_URL}/api/webhooks/sms/<termii|africastalking|sendchamp>?token=<this>
# (Termii reports are also accepted when signed with TERMII_SECRET_KEY). Any long random string.
SMS_WEBHOOK_SECRET=
# Optional: only accept SMS/voice webhooks from these IPs (comma list, IPv4 CIDR allowed). Empty = token check only.
SMS_WEBHOOK_ALLOWED_IPS=
# Supabase Auth "Send SMS" hook secret ("v1,whsec_…", Auth → Hooks): phone sign-in codes are sent through the
# provider above via {APP_URL}/api/webhooks/supabase-sms. scripts/configure-supabase-auth.mjs switches it on.
SUPABASE_SEND_SMS_HOOK_SECRET=

# ─── Scheduled jobs ───────────────────────────────────────────────────────────
# Bearer secret for /api/cron/* (Vercel Cron sends it automatically when set in the project)
CRON_SECRET=
# Optional: signs unsubscribe links in automation emails (falls back to CRON_SECRET / service key)
MARKETING_LINK_SECRET=

# ─── Domains (Vercel) ─────────────────────────────────────────────────────────
VERCEL_TOKEN=
VERCEL_PROJECT_ID_OR_NAME=
VERCEL_TEAM_ID=

# ─── Monitoring ───────────────────────────────────────────────────────────────
SENTRY_DSN=

# ─── Social selling (/channels) ───────────────────────────────────────────────
# Product feeds (/api/public/feeds/<store>/{google,meta,tiktok,whatsapp}.{xml,csv}) need no keys.
# Optional Meta catalog API sync stores each seller's token encrypted with INBOX_ENCRYPTION_KEY (shared with the inbox);
# without it sellers can still use the feed URLs. Graph API version for catalog sync (default v21.0):
META_GRAPH_VERSION=

# ─── Reviews ──────────────────────────────────────────────────────────────────
# Signs review-request links (/s/[slug]/review/<token>). Falls back to SUPABASE_SERVICE_ROLE_KEY.
REVIEW_LINK_SECRET=
# Google Business Profile reviews (import + replies). OAuth client from a Google Cloud project approved for
# the Business Profile APIs; redirect URI: {NEXT_PUBLIC_APP_URL}/api/app/reviews/google/callback
GOOGLE_BUSINESS_CLIENT_ID=
GOOGLE_BUSINESS_CLIENT_SECRET=
# Encrypts stored OAuth tokens (any long random string). Shared with other integrations if they use it.
INTEGRATIONS_ENCRYPTION_KEY=

# ─── All-in-one inbox (/home/messages, /home/inbox/channels) ─────────────────────
# Encrypts every seller's channel keys (WhatsApp/Meta tokens, SMS/voice provider keys, Telegram bot tokens) at rest.
# 32 random bytes as hex or base64 (openssl rand -hex 32). Without it, only live chat, forms and email work.
INBOX_ENCRYPTION_KEY=
# Inbound email: a domain set up for receiving in Resend (MX → Resend). Mail to <store-slug>@<domain> reaches that
# store's inbox, and replies are sent from that address. Webhook: {APP_URL}/api/webhooks/email, event email.received
# (+ email.delivered / email.bounced for delivery ticks), signing secret below.
INBOX_EMAIL_DOMAIN=
RESEND_WEBHOOK_SECRET=
# Optional: any other inbound relay posting JSON { from, to, subject, text, html } signed with hex HMAC-SHA256
# in X-Inbox-Signature.
INBOX_EMAIL_WEBHOOK_SECRET=
# Optional platform Meta app (WhatsApp Cloud API, Messenger, Instagram). Webhooks: {APP_URL}/api/webhooks/whatsapp
# and {APP_URL}/api/webhooks/meta. Sellers using their own Meta app paste their app secret when connecting instead.
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
# Optional: WhatsApp Embedded Signup ("Connect with Facebook" on /home/inbox/chatbot?tab=whatsapp) for Shopinbos as a
# Meta Tech Provider. META_APP_ID is the platform app's id; META_CONFIG_ID is the Facebook Login for Business
# configuration (WhatsApp Embedded Signup). Needs META_APP_SECRET too. Without them sellers connect manually.
# The page's CSP must also allow https://connect.facebook.net (script-src) and https://*.facebook.com (frame-src,
# connect-src) for the Facebook SDK.
META_APP_ID=
META_CONFIG_ID=

# ─── Domains (security) ───────────────────────────────────────────────────────
# Buying a domain uses the platform's Vercel account and does not charge the seller: off unless "true".
DOMAIN_PURCHASE_ENABLED=
# Most a single domain may cost (USD) when buying is on. Default 20.
DOMAIN_PURCHASE_MAX_USD=
