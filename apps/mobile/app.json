{
  "expo": {
    "name": "Shopinbos",
    "slug": "shopinbos",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "shopinbos",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.shopinbos.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Take photos of your products and proof of delivery, and check your face when you verify your identity.",
        "NSPhotoLibraryUsageDescription": "Choose product photos so Rex can list them in your shop.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "usesAppleSignIn": true
    },
    "android": {
      "package": "com.shopinbos.app",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#0C4A44",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "blockedPermissions": [
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-web-browser",
      "expo-font",
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose product photos so Rex can list them in your shop.",
          "cameraPermission": "Take photos of your products and proof of delivery, and check your face when you verify your identity."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/mark-white.png",
          "imageWidth": 76,
          "resizeMode": "contain",
          "backgroundColor": "#0C4A44"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Shopinbos uses the microphone only when you tap the mic to speak instead of typing, or when you call Peggy.",
          "recordAudioAndroid": true,
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": false,
          "supportsPictureInPicture": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "While you're online or on a delivery, Shopinbos shares your location with your delivery company so they can give you nearby jobs and track deliveries.",
          "isAndroidBackgroundLocationEnabled": false,
          "isIosBackgroundLocationEnabled": false,
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "motionUsagePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#FF6A2B",
          "defaultChannel": "orders"
        }
      ],
      "expo-asset",
      "expo-apple-authentication",
      "@livekit/react-native-expo-plugin",
      [
        "@config-plugins/react-native-webrtc",
        {
          "microphonePermission": "Shopinbos uses the microphone only when you tap the mic to speak instead of typing, or when you call Peggy.",
          "cameraPermission": "Take photos of your products and proof of delivery, and check your face when you verify your identity."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4ae115fe-eb0f-4c1c-82f4-9e38b3c88c07"
      }
    },
    "owner": "shopinbos-app"
  }
}
